{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "installationPreset",
    "components",
    "mcpServers",
    "serviceAccount",
    "surrealdb",
    "objectStore",
    "gateway",
    "artifactService",
    "recording",
    "perception",
    "reason",
    "simulationView",
    "consoleBff",
    "clusterInspection",
    "telemetry",
    "ingress",
    "networkPolicy",
    "podDisruptionBudget"
  ],
  "properties": {
    "veoveo-extension": {
      "type": "object"
    },
    "installationPreset": {
      "enum": [
        "full",
        "extension-foundation",
        "custom"
      ]
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "gateway",
          "platform-store",
          "object-store",
          "artifact-service",
          "recording-data-plane",
          "gpu-renderer",
          "simulation-runtime-support",
          "console",
          "telemetry",
          "ingress"
        ]
      }
    },
    "mcpServers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "artifact",
          "media",
          "timeseries",
          "optimization",
          "frames",
          "map",
          "time",
          "view",
          "datasheet",
          "duckdb",
          "chart",
          "rerun",
          "recording",
          "perception",
          "reason",
          "simulation-view"
        ]
      }
    },
    "global": {
      "type": "object",
      "required": [
        "installationId",
        "production",
        "veoveoRegistry",
        "veoveoTag",
        "existingSecret",
        "publicBaseUrl",
        "offline"
      ],
      "properties": {
        "installationId": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "production": {
          "type": "boolean"
        },
        "veoveoRegistry": {
          "type": "string"
        },
        "veoveoTag": {
          "type": "string"
        },
        "imageDigests": {
          "type": "object",
          "propertyNames": {
            "pattern": "^veoveo/[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        },
        "imagePullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "publicBaseUrl": {
          "type": "string",
          "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?)"
        },
        "offline": {
          "type": "boolean"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "serviceMesh": {
          "type": "object",
          "required": [
            "enabled",
            "provider",
            "podAnnotations"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "provider": {
              "const": "istio"
            },
            "podAnnotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "serviceAccount": {
      "type": "object"
    },
    "surrealdb": {
      "type": "object",
      "required": [
        "image",
        "namespace",
        "database",
        "adminExistingSecret",
        "runtimeExistingSecret",
        "persistence"
      ],
      "properties": {
        "image": {
          "allOf": [
            {
              "$ref": "#/definitions/image"
            },
            {
              "type": "object",
              "properties": {
                "tag": {
                  "const": "v3.2.1"
                }
              }
            }
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "adminExistingSecret": {
          "type": "string",
          "minLength": 1
        },
        "runtimeExistingSecret": {
          "type": "string",
          "minLength": 1
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "objectStore": {
      "type": "object",
      "required": [
        "mode",
        "bucketInitImage",
        "rustfs",
        "externalS3"
      ],
      "properties": {
        "mode": {
          "enum": [
            "rustfs",
            "externalS3"
          ]
        },
        "bucketInitImage": {
          "$ref": "#/definitions/image"
        },
        "rustfs": {
          "type": "object",
          "required": [
            "image",
            "bucket",
            "publicEndpoint",
            "persistence",
            "resources"
          ],
          "properties": {
            "image": {
              "$ref": "#/definitions/image"
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "publicEndpoint": {
              "type": "string",
              "pattern": "^(https://|http://([a-z0-9-]+\\.)?localhost(:[0-9]+)?)"
            },
            "persistence": {
              "$ref": "#/definitions/persistence"
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "externalS3": {
          "type": "object",
          "required": [
            "endpoint",
            "publicEndpoint",
            "bucket",
            "region",
            "allowHttp"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "publicEndpoint": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "allowHttp": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "externalS3"
              }
            }
          },
          "then": {
            "properties": {
              "externalS3": {
                "properties": {
                  "endpoint": {
                    "minLength": 1,
                    "pattern": "^https://"
                  },
                  "publicEndpoint": {
                    "minLength": 1,
                    "pattern": "^https://"
                  },
                  "bucket": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "gateway": {
      "allOf": [
        {
          "$ref": "#/definitions/mcpWorkload"
        },
        {
          "type": "object",
          "required": [
            "existingControlPlaneConfigMap",
            "controlPlaneKey",
            "controlPlaneRevision",
            "refreshDeliveryWindowSeconds"
          ],
          "properties": {
            "existingControlPlaneConfigMap": {
              "type": "string",
              "minLength": 1
            },
            "controlPlaneKey": {
              "type": "string",
              "minLength": 1
            },
            "controlPlaneRevision": {
              "type": "string",
              "pattern": "^$|^[a-f0-9]{64}$"
            },
            "refreshDeliveryWindowSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        }
      ]
    },
    "artifactService": {
      "type": "object",
      "required": [
        "image",
        "replicas",
        "allowedAudiences",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "allowedAudiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "recording": {
      "type": "object",
      "required": [
        "tenantKey",
        "workContext",
        "classification",
        "labels",
        "route",
        "idleTimeoutSeconds",
        "segmentMaxBytes",
        "segmentMaxAgeSeconds",
        "liveHistorySeconds",
        "persistence",
        "hubImage",
        "mcpImage",
        "resources"
      ],
      "properties": {
        "tenantKey": {
          "type": "string",
          "minLength": 1
        },
        "workContext": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "route": {
          "type": "string",
          "pattern": "^[a-z0-9_]+="
        },
        "idleTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "segmentMaxBytes": {
          "type": "integer",
          "minimum": 8388608,
          "maximum": 251658240
        },
        "segmentMaxAgeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "liveHistorySeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "hubImage": {
          "$ref": "#/definitions/image"
        },
        "mcpImage": {
          "$ref": "#/definitions/image"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "perception": {
      "type": "object",
      "required": [
        "runtimeClassName",
        "image",
        "modelCache",
        "builderResources",
        "resources"
      ],
      "properties": {
        "runtimeClassName": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "modelCache": {
          "$ref": "#/definitions/persistence"
        },
        "builderResources": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "required": [
        "runtimeClassName",
        "image",
        "modelCache",
        "engine",
        "observation",
        "resources"
      ],
      "properties": {
        "runtimeClassName": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
      "modelCache": {
        "$ref": "#/definitions/persistence"
      },
      "engine": {
        "type": "object",
        "required": [
          "gpuMemoryUtilization",
          "maxModelLen"
        ],
        "properties": {
          "gpuMemoryUtilization": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1.0
          },
          "maxModelLen": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 1048576
          }
        },
        "additionalProperties": false
      },
      "observation": {
        "type": "object",
        "required": [
          "width",
          "height",
          "maximumFrames"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 2,
            "maximum": 3840,
            "multipleOf": 2
          },
          "height": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2160,
            "multipleOf": 2
          },
          "maximumFrames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          }
        },
        "additionalProperties": false
      },
      "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "simulationView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeClassName",
        "mcpImage",
        "rendererImage",
        "poseImage",
        "publicSignalingUrl",
        "publicMediaIp",
        "ports",
        "signaling",
        "media",
        "poseIngress",
        "artifacts",
        "sharedMemory",
        "cache",
        "capacity",
        "placement",
        "mcpResources",
        "poseResources",
        "rendererResources"
      ],
      "properties": {
        "runtimeClassName": {
          "type": "string",
          "minLength": 1
        },
        "mcpImage": {
          "$ref": "#/definitions/image"
        },
        "rendererImage": {
          "$ref": "#/definitions/image"
        },
        "poseImage": {
          "$ref": "#/definitions/image"
        },
        "publicSignalingUrl": {
          "type": "string",
          "pattern": "^((wss|https)://[^/?#]+|ws://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?)/[^?#]*$"
        },
        "publicMediaIp": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-fA-F:.]+$"
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mcp",
            "rendererControl",
            "poseControl",
            "poseTls",
            "signalingBase",
            "mediaBase"
          ],
          "properties": {
            "mcp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "rendererControl": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "poseControl": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "poseTls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "signalingBase": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "mediaBase": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "signaling": {
          "allOf": [
            {
              "$ref": "#/definitions/tcpExposure"
            },
            {
              "type": "object",
              "required": [
                "exposure",
                "nodePort",
                "loadBalancerIP",
                "externalTrafficPolicy"
              ],
              "properties": {
                "exposure": {
                  "enum": [
                    "Ingress",
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ]
                }
              }
            }
          ]
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exposure",
            "nodePortBase",
            "loadBalancerIP",
            "externalTrafficPolicy"
          ],
          "properties": {
            "exposure": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "nodePortBase": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            },
            "loadBalancerIP": {
              "type": "string"
            },
            "externalTrafficPolicy": {
              "enum": [
                "Cluster",
                "Local"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "exposure": {
                    "const": "NodePort"
                  }
                }
              },
              "then": {
                "properties": {
                  "nodePortBase": {
                    "minimum": 30000
                  }
                }
              }
            }
          ]
        },
        "poseIngress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exposure",
            "nodePort",
            "loadBalancerIP",
            "externalTrafficPolicy",
            "existingTlsSecret",
            "certificateKey",
            "privateKeyKey",
            "clientCaKey",
            "allowedCidrs"
          ],
          "properties": {
            "exposure": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            },
            "loadBalancerIP": {
              "type": "string"
            },
            "externalTrafficPolicy": {
              "enum": [
                "Cluster",
                "Local"
              ]
            },
            "existingTlsSecret": {
              "type": "string",
              "minLength": 1
            },
            "certificateKey": {
              "$ref": "#/definitions/dataKey"
            },
            "privateKeyKey": {
              "$ref": "#/definitions/dataKey"
            },
            "clientCaKey": {
              "$ref": "#/definitions/dataKey"
            },
            "allowedCidrs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "exposure": {
                    "const": "NodePort"
                  }
                }
              },
              "then": {
                "properties": {
                  "nodePort": {
                    "minimum": 30000
                  }
                }
              }
            }
          ]
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingClaim",
            "size",
            "storageClass",
            "accessModes"
          ],
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sharedMemory": {
          "$ref": "#/definitions/sizeLimit"
        },
        "cache": {
          "$ref": "#/definitions/sizeLimit"
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "maximumLogicalCameras",
            "maximumRenderedCameras",
            "maximumStreamedCameras",
            "maximumRenderPixelsPerSecond",
            "maximumNvencSessions",
            "gpuMemoryBudgetBytes",
            "maximumEntityInstances",
            "maximumCamerasPerOwner",
            "maximumCamerasPerWorkContext",
            "maximumAssetBytes",
            "maximumFrameAgeMs",
            "leaseSeconds",
            "maximumPoseSessions",
            "maximumPoseConnections"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "maximumLogicalCameras": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "maximumRenderedCameras": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maximumStreamedCameras": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maximumRenderPixelsPerSecond": {
              "type": "integer",
              "minimum": 1
            },
            "maximumNvencSessions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "gpuMemoryBudgetBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumEntityInstances": {
              "type": "integer",
              "minimum": 1
            },
            "maximumCamerasPerOwner": {
              "type": "integer",
              "minimum": 1
            },
            "maximumCamerasPerWorkContext": {
              "type": "integer",
              "minimum": 1
            },
            "maximumAssetBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximumFrameAgeMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "leaseSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "maximumPoseSessions": {
              "type": "integer",
              "minimum": 1
            },
            "maximumPoseConnections": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeSelector",
            "tolerations",
            "affinity"
          ],
          "properties": {
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "affinity": {
              "type": "object"
            }
          }
        },
        "mcpResources": {
          "type": "object"
        },
        "poseResources": {
          "type": "object"
        },
        "rendererResources": {
          "type": "object"
        }
      }
    },
    "consoleBff": {
      "$ref": "#/definitions/workload"
    },
    "clusterInspection": {
      "type": "object",
      "required": [
        "enabled",
        "kubernetesApiCidrs"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kubernetesApiCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object"
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "className",
        "annotations",
        "publicShareAnnotations",
        "host",
        "objectStoreHost",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "publicShareAnnotations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "objectStoreHost": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "secretName"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object"
    },
    "serverBootstrap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "server",
          "tenantKey",
          "payload"
        ],
        "properties": {
          "server": {
            "type": "string",
            "minLength": 1
          },
          "tenantKey": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "dataKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sizeLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizeLimit"
      ],
      "properties": {
        "sizeLimit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tcpExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "nodePort",
        "loadBalancerIP",
        "externalTrafficPolicy"
      ],
      "properties": {
        "exposure": {
          "type": "string"
        },
        "nodePort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        },
        "loadBalancerIP": {
          "type": "string"
        },
        "externalTrafficPolicy": {
          "enum": [
            "Cluster",
            "Local"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exposure": {
                "const": "NodePort"
              }
            }
          },
          "then": {
            "properties": {
              "nodePort": {
                "minimum": 30000
              }
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "size",
        "accessModes"
      ],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mcpWorkload": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "image",
        "replicas"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
