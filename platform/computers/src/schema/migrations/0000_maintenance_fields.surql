DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.tenant ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.policy_version ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.rule_id ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.trace_id ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.evidence ON computer_maintenance TYPE none | null | { kind: 'stopped' | 'created', resource_id: string, process_id: string } | { kind: 'captured' | 'retired' | 'transferred' } | { kind: 'restored', policy_version: int, policy_hash: string } ASSERT IF type::is_object($value) THEN object::keys($value) ALLINSIDE ['kind', 'resource_id', 'process_id', 'policy_version', 'policy_hash'] AND $value.kind != NONE AND $value.kind != NULL AND (IF $value.kind IN ['stopped', 'created'] THEN $value.resource_id != NONE AND $value.resource_id != NULL AND $value.process_id != NONE AND $value.process_id != NULL AND $value.policy_version = NONE AND $value.policy_hash = NONE ELSE IF $value.kind = 'restored' THEN $value.policy_version != NONE AND $value.policy_version != NULL AND $value.policy_version > 0 AND $value.policy_version <= 4294967295 AND $value.policy_hash != NONE AND $value.policy_hash != NULL AND $value.resource_id = NONE AND $value.process_id = NONE ELSE $value.resource_id = NONE AND $value.process_id = NONE AND $value.policy_version = NONE AND $value.policy_hash = NONE END) ELSE $value = NONE OR $value = NULL END PERMISSIONS FULL;
