-- Controlled maintenance receipts; JSON date and UUID spellings preserve whole-value fences.

DEFINE FIELD OVERWRITE source ON computer_maintenance TYPE object READONLY ASSERT object::keys($value) ALLINSIDE ['kind', 'resource_id', 'process_id', 'operation_id'] AND $value.kind != NONE AND $value.kind != NULL AND IF $value.kind IN ['ready', 'stopped'] THEN $value.resource_id != NONE AND $value.resource_id != NULL AND $value.process_id != NONE AND $value.process_id != NULL AND $value.operation_id = NONE ELSE $value.operation_id != NONE AND $value.operation_id != NULL AND $value.resource_id = NONE AND $value.process_id = NONE END PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source.kind ON computer_maintenance TYPE 'ready' | 'stopped' | 'initial_failure' READONLY PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source.resource_id ON computer_maintenance TYPE option<string> READONLY ASSERT $value = NONE OR (string::len($value) > 0 AND string::len($value) <= 256 AND $value = /^[!-~]+$/) PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source.process_id ON computer_maintenance TYPE option<string> READONLY ASSERT $value = NONE OR (string::len($value) > 0 AND string::len($value) <= 256 AND $value = /^[!-~]+$/) PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source.operation_id ON computer_maintenance TYPE option<string> READONLY PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source_resource_id ON computer_maintenance TYPE option<string> READONLY PERMISSIONS FULL;
DEFINE FIELD OVERWRITE source_process_id ON computer_maintenance TYPE option<string> READONLY PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress ON computer_maintenance TYPE object DEFAULT { steps: [], recovery: NULL } ASSERT object::keys($value) ALLINSIDE ['steps', 'recovery'] AND $value.steps != NONE AND $value.steps != NULL PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps ON computer_maintenance TYPE array<object> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.* ON computer_maintenance TYPE object ASSERT object::keys($value) ALLINSIDE ['step', 'dispatch_id', 'authority', 'dispatched_at', 'observation_started_at', 'observation_deadline', 'observation_reads', 'last_observation_id', 'next_observation_at', 'evidence', 'settled_at'] AND $value.step != NONE AND $value.step != NULL AND $value.dispatch_id != NONE AND $value.dispatch_id != NULL AND $value.authority != NONE AND $value.authority != NULL AND $value.dispatched_at != NONE AND $value.dispatched_at != NULL AND $value.observation_started_at != NONE AND $value.observation_started_at != NULL AND $value.observation_deadline != NONE AND $value.observation_deadline != NULL AND $value.observation_reads != NONE AND $value.observation_reads != NULL PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.step ON computer_maintenance TYPE 'stop' | 'capture' | 'retire' | 'transfer' | 'create' | 'restore' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.dispatch_id ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.dispatched_at ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.observation_started_at ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.observation_deadline ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.observation_reads ON computer_maintenance TYPE int ASSERT $value >= 0 AND $value <= 255 PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.last_observation_id ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.next_observation_at ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.settled_at ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority ON computer_maintenance TYPE object ASSERT object::keys($value) ALLINSIDE ['automation', 'checked_at', 'control_revision', 'control_sha256', 'decision', 'valid_until'] AND $value.control_revision != NONE AND $value.control_revision != NULL AND $value.control_sha256 != NONE AND $value.control_sha256 != NULL AND $value.checked_at != NONE AND $value.checked_at != NULL AND $value.valid_until != NONE AND $value.valid_until != NULL AND $value.decision != NONE AND $value.decision != NULL PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.control_revision ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.control_sha256 ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.checked_at ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.valid_until ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision ON computer_maintenance TYPE object ASSERT object::keys($value) ALLINSIDE ['action', 'effect', 'evaluated_at', 'policy_version', 'principal', 'profile', 'reason', 'rule_id', 'target', 'tenant', 'trace_id'] AND $value.effect != NONE AND $value.effect != NULL AND $value.reason != NONE AND $value.reason != NULL AND $value.evaluated_at != NONE AND $value.evaluated_at != NULL AND $value.profile != NONE AND $value.profile != NULL AND $value.action != NONE AND $value.action != NULL AND $value.target != NONE AND $value.target != NULL AND $value.trace_id != NONE AND $value.trace_id != NULL PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.effect ON computer_maintenance TYPE 'allow' | 'deny' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.reason ON computer_maintenance TYPE 'policy_allow' | 'policy_deny' | 'unknown_profile' | 'unknown_server' | 'unknown_tool' | 'unknown_resource' | 'unknown_prompt' | 'unknown_task' | 'unknown_artifact' | 'unknown_principal' | 'unknown_scope' | 'unknown_data_label' | 'unknown_tenant' | 'unknown_token_issuer' | 'missing_principal' | 'missing_tenant' | 'missing_group' | 'missing_role' | 'missing_scope' | 'missing_data_label' | 'missing_principal_assurance' | 'token_audience_mismatch' | 'token_expired' | 'token_not_yet_valid' | 'replay_detected' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.evaluated_at ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.profile ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.action ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.target ON computer_maintenance TYPE object ASSERT object::keys($value) ALLINSIDE ['kind', 'server', 'tool'] AND $value.kind != NONE AND $value.kind != NULL AND $value.server != NONE AND $value.server != NULL AND $value.tool != NONE AND $value.tool != NULL PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.target.kind ON computer_maintenance TYPE 'tool' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.target.server ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.target.tool ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.principal ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.tenant ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.policy_version ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.rule_id ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.decision.trace_id ON computer_maintenance TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation ON computer_maintenance TYPE option<object> ASSERT IF type::is_object($value) THEN object::keys($value) ALLINSIDE ['grant_id', 'grant_revision', 'owner'] AND $value.grant_id != NONE AND $value.grant_id != NULL AND $value.grant_revision != NONE AND $value.grant_revision != NULL AND $value.owner != NONE AND $value.owner != NULL ELSE $value = NONE OR $value = NULL END PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.grant_id ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.grant_revision ON computer_maintenance TYPE none | null | int | decimal ASSERT $value = NONE OR $value = NULL OR (($value >= 0 AND $value <= 18446744073709551615dec AND math::floor($value) = $value)) PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner ON computer_maintenance TYPE option<object> ASSERT IF type::is_object($value) THEN object::keys($value) ALLINSIDE ['action', 'effect', 'evaluated_at', 'policy_version', 'principal', 'profile', 'reason', 'rule_id', 'target', 'tenant', 'trace_id'] AND $value.effect != NONE AND $value.effect != NULL AND $value.reason != NONE AND $value.reason != NULL AND $value.evaluated_at != NONE AND $value.evaluated_at != NULL AND $value.profile != NONE AND $value.profile != NULL AND $value.action != NONE AND $value.action != NULL AND $value.target != NONE AND $value.target != NULL AND $value.trace_id != NONE AND $value.trace_id != NULL ELSE $value = NONE OR $value = NULL END PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.effect ON computer_maintenance TYPE none | null | 'allow' | 'deny' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.reason ON computer_maintenance TYPE none | null | 'policy_allow' | 'policy_deny' | 'unknown_profile' | 'unknown_server' | 'unknown_tool' | 'unknown_resource' | 'unknown_prompt' | 'unknown_task' | 'unknown_artifact' | 'unknown_principal' | 'unknown_scope' | 'unknown_data_label' | 'unknown_tenant' | 'unknown_token_issuer' | 'missing_principal' | 'missing_tenant' | 'missing_group' | 'missing_role' | 'missing_scope' | 'missing_data_label' | 'missing_principal_assurance' | 'token_audience_mismatch' | 'token_expired' | 'token_not_yet_valid' | 'replay_detected' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.evaluated_at ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.profile ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.action ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.target ON computer_maintenance TYPE option<object> ASSERT IF type::is_object($value) THEN object::keys($value) ALLINSIDE ['kind', 'server', 'tool'] AND $value.kind != NONE AND $value.kind != NULL AND $value.server != NONE AND $value.server != NULL AND $value.tool != NONE AND $value.tool != NULL ELSE $value = NONE OR $value = NULL END PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.target.kind ON computer_maintenance TYPE none | null | 'tool' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.target.server ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE progress.steps.*.authority.automation.owner.target.tool ON computer_maintenance TYPE none | null | string PERMISSIONS FULL;
