-- Controlled Computers snapshots use their existing JSON wire scalars.
-- RFC 3339 timestamps inside authority evidence stay strings; native journal clocks are separate.
-- Optional descendants admit native NONE and explicit JSON NULL. Parent assertions require live values.


-- computer
DEFINE FIELD OVERWRITE owner_context.principal_key ON computer TYPE string PERMISSIONS FULL;
