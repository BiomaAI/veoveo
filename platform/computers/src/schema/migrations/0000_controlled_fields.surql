DEFINE FIELD OVERWRITE owner_context.authority.output_policy.data_labels.* ON computer TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE owner_context.authority.provenance ON computer TYPE object ASSERT object::keys($value) ALLINSIDE ['delegation_id', 'initiator', 'mode'] AND $value.mode != NONE AND $value.mode != NULL AND (($value.mode = 'direct' AND $value.initiator != NONE AND $value.initiator != NULL AND $value.delegation_id = NONE) OR ($value.mode = 'delegated' AND $value.initiator != NONE AND $value.initiator != NULL AND $value.delegation_id != NONE AND $value.delegation_id != NULL) OR ($value.mode = 'automated' AND $value.initiator = NONE AND $value.delegation_id = NONE)) PERMISSIONS FULL;
