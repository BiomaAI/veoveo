DEFINE FIELD OVERWRITE envelope.fingerprint ON computer_maintenance_policy TYPE string PERMISSIONS FULL;

-- Certify indexed object parents after all wildcard child definitions.
DEFINE FIELD OVERWRITE owner_context ON computer TYPE object ASSERT object::keys($value) ALLINSIDE ['authority', 'data_labels', 'issuer', 'principal_key', 'principal_kind', 'profile', 'subject', 'tenant_key'] AND $value.principal_key != NONE AND $value.principal_key != NULL AND $value.principal_kind != NONE AND $value.principal_kind != NULL AND $value.issuer != NONE AND $value.issuer != NULL AND $value.subject != NONE AND $value.subject != NULL AND $value.profile != NONE AND $value.profile != NULL AND $value.data_labels != NONE AND $value.data_labels != NULL AND $value.authority != NONE AND $value.authority != NULL PERMISSIONS FULL;
DEFINE FIELD OVERWRITE owner_context.authority ON computer TYPE object ASSERT object::keys($value) ALLINSIDE ['membership', 'output_policy', 'policy_revision', 'provenance', 'tenant', 'work_context'] AND $value.work_context != NONE AND $value.work_context != NULL AND $value.tenant != NONE AND $value.tenant != NULL AND $value.policy_revision != NONE AND $value.policy_revision != NULL AND $value.membership != NONE AND $value.membership != NULL AND $value.output_policy != NONE AND $value.output_policy != NULL AND $value.provenance != NONE AND $value.provenance != NULL PERMISSIONS FULL;
