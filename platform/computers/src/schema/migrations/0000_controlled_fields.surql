DEFINE FIELD OVERWRITE decision.automation.grant_revision ON computer_maintenance_resume TYPE none | null | int | decimal ASSERT $value = NONE OR $value = NULL OR (($value >= 0 AND $value <= 18446744073709551615dec AND math::floor($value) = $value)) PERMISSIONS FULL;
