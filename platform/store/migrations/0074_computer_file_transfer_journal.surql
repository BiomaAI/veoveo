DEFINE FIELD OVERWRITE stage ON computer_file_transfer TYPE "queued" | "dispatched" | "containing" | "recovery_required" | "completed" | "failed" | "cancelled";
DEFINE FIELD dispatch_id ON computer_file_transfer TYPE option<uuid>;
DEFINE FIELD dispatched_at ON computer_file_transfer TYPE option<datetime>;
DEFINE FIELD execution_deadline ON computer_file_transfer TYPE option<datetime>;
DEFINE FIELD effective_limits ON computer_file_transfer TYPE option<object> FLEXIBLE;
DEFINE FIELD dispatch_authority ON computer_file_transfer TYPE option<object> FLEXIBLE;
DEFINE FIELD containment_id ON computer_file_transfer TYPE option<uuid>;
DEFINE FIELD interruption ON computer_file_transfer TYPE option<"cancelled" | "deadline" | "authority_lost" | "execution_unknown">;
DEFINE FIELD containment_dispatch_id ON computer_file_transfer TYPE option<uuid>;
DEFINE FIELD containment_started_at ON computer_file_transfer TYPE option<datetime>;
DEFINE FIELD containment_deadline ON computer_file_transfer TYPE option<datetime>;
DEFINE FIELD containment_reads ON computer_file_transfer TYPE int DEFAULT 0 ASSERT $value >= 0 AND $value <= 8;
DEFINE FIELD next_containment_read ON computer_file_transfer TYPE option<datetime>;
DEFINE FIELD last_containment_read_id ON computer_file_transfer TYPE option<uuid>;
DEFINE FIELD settled_at ON computer_file_transfer TYPE option<datetime>;
DEFINE FIELD refusal ON computer_file_transfer TYPE option<"cancelled_before_dispatch" | "authority_denied" | "run_changed" | "preparation_expired">;
DEFINE FIELD terminated_at ON computer_file_transfer TYPE option<datetime>;
DEFINE FIELD termination_evidence ON computer_file_transfer TYPE option<object> FLEXIBLE;
DEFINE FIELD task_projected_at ON computer_file_transfer TYPE option<datetime>;
UPDATE computer_file_transfer SET containment_reads = 0 WHERE containment_reads = NONE;
DEFINE FIELD result ON computer_file_transfer TYPE option<object> FLEXIBLE;
DEFINE FIELD rejection ON computer_file_transfer TYPE option<string>;
