BEGIN TRANSACTION; LET $current = (SELECT * FROM ONLY $request); IF $current.revision != $revision { THROW 'artifact_access_request_revision_conflict'; }; UPDATE ONLY $request SET requested_level = $requested_level, justification = $justification, state = 'pending', decided_by = NONE, decided_by_key = NONE, decision_note = NONE, decided_at = NONE, created_at = $now, updated_at = $now, revision += 1 RETURN NONE; COMMIT TRANSACTION;
