BEGIN TRANSACTION; LET $current = (SELECT * FROM ONLY $request); IF $current.revision != $revision OR $current.state != 'pending' { THROW 'artifact_access_request_state_conflict'; }; UPDATE ONLY $request SET state = $state, decided_by = $decided_by, decided_by_key = $decided_by_key, decision_note = $note, decided_at = $now, updated_at = $now, revision += 1 RETURN NONE; COMMIT TRANSACTION;
