BEGIN TRANSACTION; LET $_provider_guard = (UPDATE ONLY $_provider_task SET lease_expires_at = lease_expires_at WHERE server = $_provider_server AND owner_context = $_provider_owner_context AND recovery_class = 'provider_wait' AND lease_owner = $_provider_worker AND lease_expires_at = $_provider_expiry AND lease_expires_at > time::now() AND status IN ['queued', 'running', 'waiting', 'cancel_requested'] AND ($_provider_dispatch = false OR status != 'cancel_requested') RETURN AFTER); IF $_provider_guard = NONE { THROW 'provider_lease_lost'; }; /* domain body */
COMMIT TRANSACTION;
