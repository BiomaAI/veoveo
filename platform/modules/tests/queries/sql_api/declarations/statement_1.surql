DEFINE FUNCTION fn::kernel::own::read_v1($id: record<own>, $key: string) -> option<object> { LET $rows = SELECT * FROM own WHERE id=$id LIMIT 1; LET $row = array::first($rows); RETURN IF type::is_object($row) THEN { LET $payload=$row.payload; RETURN IF type::is_object($payload) THEN { RETURN IF $payload.key=$key THEN {key:$payload.key} ELSE NONE END; } ELSE NONE END; } ELSE NONE END; } PERMISSIONS FULL;