DEFINE FUNCTION fn::kernel::own::read_v1($id: record<own>, $key: string) -> option<object> { LET $rows = SELECT * FROM $id; LET $row = array::first($rows); RETURN IF type::is_object($row) THEN { CREATE ONLY $id SET payload = {key:$key} RETURN NONE; RETURN {key:$key}; } ELSE NONE END; } PERMISSIONS FULL;