DEFINE TABLE fixture_marker SCHEMAFULL; DEFINE FIELD value ON fixture_marker TYPE string; CREATE fixture_marker:base SET value='base'; DEFINE FUNCTION fn::store::write($id: record<fixture_marker>, $value: string) -> bool { UPDATE ONLY $id SET value=$value RETURN NONE; RETURN true; }; DEFINE FUNCTION fn::store::outer($id: record<fixture_marker>, $value: string) -> bool { RETURN fn::store::write($id,$value); };