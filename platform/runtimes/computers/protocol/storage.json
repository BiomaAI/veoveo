{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://veoveo.io/contracts/computer-storage/v1",
  "title": "ComputerStorageProtocol",
  "description": "Private installation mTLS protocol, not an operator API. One JSON document per four-byte network-order length frame, maximum 1024 bytes. Duplicate object keys are forbidden before schema validation. Successful replies must echo the exact request identity and admitted capacity. Provider and instance identity are mandatory. The initial instanceId equals computerId; replacement instances use a distinct UUID. Restore reopens only the currently admitted instance; it cannot authorize a handoff. No caller-selected paths, credentials or capacity.",
  "x-maximum-frame-bytes": 1024,
  "oneOf": [
    {"$ref": "#/definitions/ReadyRequest"},
    {"$ref": "#/definitions/BoundRequest"},
    {"$ref": "#/definitions/ReadyReply"},
    {"$ref": "#/definitions/BoundReply"},
    {"$ref": "#/definitions/FailureReply"},
    {"$ref": "#/definitions/HandoffRequest"},
    {"$ref": "#/definitions/HandoffReply"}
  ],
  "definitions": {
    "SourceResourceId": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,128}$"},
    "HandoffRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "operation", "providerId", "computerId", "operationId", "sourceInstanceId", "sourceTemplateFingerprint", "sourceResourceId", "targetInstanceId", "targetTemplateFingerprint"],
      "properties": {
        "schema": {"$ref": "#/definitions/ProtocolSchema"},
        "operation": {"type": "string", "enum": ["handoff"]},
        "providerId": {"$ref": "#/definitions/IdentityId"},
        "computerId": {"$ref": "#/definitions/IdentityId"},
        "operationId": {"$ref": "#/definitions/IdentityId"},
        "sourceInstanceId": {"$ref": "#/definitions/IdentityId"},
        "sourceTemplateFingerprint": {"$ref": "#/definitions/Fingerprint"},
        "sourceResourceId": {"$ref": "#/definitions/SourceResourceId"},
        "targetInstanceId": {"$ref": "#/definitions/IdentityId"},
        "targetTemplateFingerprint": {"$ref": "#/definitions/Fingerprint"}
      }
    },
    "HandoffReply": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "operation", "providerId", "computerId", "operationId", "sourceInstanceId", "sourceTemplateFingerprint", "sourceResourceId", "targetInstanceId", "targetTemplateFingerprint", "status", "capacityBytes"],
      "properties": {
        "schema": {"$ref": "#/definitions/ProtocolSchema"},
        "operation": {"type": "string", "enum": ["handoff"]},
        "providerId": {"$ref": "#/definitions/IdentityId"},
        "computerId": {"$ref": "#/definitions/IdentityId"},
        "operationId": {"$ref": "#/definitions/IdentityId"},
        "sourceInstanceId": {"$ref": "#/definitions/IdentityId"},
        "sourceTemplateFingerprint": {"$ref": "#/definitions/Fingerprint"},
        "sourceResourceId": {"$ref": "#/definitions/SourceResourceId"},
        "targetInstanceId": {"$ref": "#/definitions/IdentityId"},
        "targetTemplateFingerprint": {"$ref": "#/definitions/Fingerprint"},
        "status": {"type": "string", "enum": ["ready"]},
        "capacityBytes": {"$ref": "#/definitions/CapacityBytes"}
      }
    },
    "ProtocolSchema": {"type": "string", "enum": ["veoveo.io/computer-storage/v1"]},
    "Fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "IdentityId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "BoundOperation": {"type": "string", "enum": ["prepare", "restore"]},
    "CapacityBytes": {"type": "integer", "minimum": 536870912, "maximum": 274877906944, "multipleOf": 4096},
    "ReadyRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "operation", "templateFingerprint", "providerId"],
      "properties": {
        "schema": {"$ref": "#/definitions/ProtocolSchema"},
        "operation": {"type": "string", "enum": ["ready"]},
        "providerId": {"$ref": "#/definitions/IdentityId"},
        "templateFingerprint": {"$ref": "#/definitions/Fingerprint"}
      }
    },
    "BoundRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "operation", "templateFingerprint", "computerId", "providerId", "instanceId"],
      "properties": {
        "schema": {"$ref": "#/definitions/ProtocolSchema"},
        "operation": {"$ref": "#/definitions/BoundOperation"},
        "providerId": {"$ref": "#/definitions/IdentityId"},
        "templateFingerprint": {"$ref": "#/definitions/Fingerprint"},
        "instanceId": {"$ref": "#/definitions/IdentityId"},
        "computerId": {"$ref": "#/definitions/IdentityId"}
      }
    },
    "ReadyReply": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "operation", "templateFingerprint", "status", "capacityBytes", "providerId"],
      "properties": {
        "schema": {"$ref": "#/definitions/ProtocolSchema"},
        "operation": {"type": "string", "enum": ["ready"]},
        "providerId": {"$ref": "#/definitions/IdentityId"},
        "templateFingerprint": {"$ref": "#/definitions/Fingerprint"},
        "status": {"type": "string", "enum": ["ready"]},
        "capacityBytes": {"$ref": "#/definitions/CapacityBytes"}
      }
    },
    "BoundReply": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "operation", "templateFingerprint", "computerId", "status", "capacityBytes", "providerId", "instanceId"],
      "properties": {
        "schema": {"$ref": "#/definitions/ProtocolSchema"},
        "operation": {"$ref": "#/definitions/BoundOperation"},
        "providerId": {"$ref": "#/definitions/IdentityId"},
        "templateFingerprint": {"$ref": "#/definitions/Fingerprint"},
        "instanceId": {"$ref": "#/definitions/IdentityId"},
        "computerId": {"$ref": "#/definitions/IdentityId"},
        "status": {"type": "string", "enum": ["ready"]},
        "capacityBytes": {"$ref": "#/definitions/CapacityBytes"}
      }
    },
    "FailureReply": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status"],
      "properties": {
        "schema": {"$ref": "#/definitions/ProtocolSchema"},
        "status": {"type": "string", "enum": ["error"]}
      }
    }
  }
}
