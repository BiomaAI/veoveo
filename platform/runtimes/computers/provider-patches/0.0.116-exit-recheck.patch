+        let mut unrelated = runtime.sandbox_watch_bus.subscribe("sb-unrelated");
+        let (shutdown_tx, watch_handle) = start_watch_loop(&runtime, &driver).await;
+        // Duplicates must consume only one slot; unique IDs fill the bounded window.
+        for index in 0..EXIT_RECHECK_CONCURRENCY {
+            for _ in 0..3 {
+                driver.send_event(sandbox_watch_event(exited_driver_sandbox(
+                    &format!("sb-{index}"),
+                    &format!("sandbox-{index}"),
+                )));
+            }
