+fn driver_snapshot_reports_container_exit(snapshot: &DriverSandbox) -> bool {
+    snapshot.status.as_ref().is_some_and(|status| {
+        status.conditions.iter().any(|condition| {
+            condition.r#type == "Ready"
+                && condition.status.eq_ignore_ascii_case("false")
+                && condition.reason == "ContainerExited"
+        })
+    })
+}
+
+fn exit_snapshot_needs_recheck(
+    incoming: &DriverSandbox,
+    existing: Option<&ObjectRecord>,
+) -> Result<bool, String> {
+    if !driver_snapshot_reports_container_exit(incoming) {
+        return Ok(false);
+    }
+    let Some(existing) = existing else {
+        return Ok(false);
+    };
+    Ok(matches!(
+        SandboxPhase::try_from(decode_sandbox_record(existing)?.phase()),
+        Ok(SandboxPhase::Starting | SandboxPhase::Ready)
+    ))
+}
