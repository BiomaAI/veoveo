+            while driver.get_calls.load(Ordering::SeqCst) < EXIT_RECHECK_CONCURRENCY {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("exit rechecks did not fill their concurrency window");
+        driver.send_event(sandbox_watch_event(exited_driver_sandbox(
+            &format!("sb-{EXIT_RECHECK_CONCURRENCY}"),
+            &format!("sandbox-{EXIT_RECHECK_CONCURRENCY}"),
+        )));
+        driver.send_event(deleted_watch_event("sb-unrelated"));
