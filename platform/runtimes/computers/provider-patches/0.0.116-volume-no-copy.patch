+#[test]
+fn retained_volume_no_copy_reaches_engine_with_and_without_subpath() {
+    for subpath in [None, Some("home")] {
+        let mut mount = serde_json::json!({
+            "type": "volume", "source": "retained-home",
+            "target": "/sandbox/persistent", "read_only": false, "no_copy": true
+        });
+        if let Some(subpath) = subpath {
+            mount["subpath"] = serde_json::json!(subpath);
+        }
+        let mut sandbox = test_sandbox();
+        sandbox
+            .spec
+            .as_mut()
+            .unwrap()
+            .template
+            .as_mut()
+            .unwrap()
+            .driver_config = Some(json_struct(serde_json::json!({"mounts": [mount]})));
+        DockerComputeDriver::validate_sandbox(&sandbox, &runtime_config()).unwrap();
+        let body = build_container_create_body(&sandbox, &runtime_config()).unwrap();
+        let mounts = body.host_config.unwrap().mounts.unwrap();
+        let options = mounts[0].volume_options.as_ref().unwrap();
+        assert_eq!(options.no_copy, Some(true));
+        assert_eq!(options.subpath.as_deref(), subpath);
+        let wire = serde_json::to_value(&mounts[0]).unwrap();
+        assert_eq!(wire["VolumeOptions"]["NoCopy"], true);
+    }
+}
