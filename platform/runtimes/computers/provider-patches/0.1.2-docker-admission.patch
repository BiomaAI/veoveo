+    let key = directory.join("fixture-key.pem");
+    write_docker_boundary_file(&ca, tls.trust_anchor_pem.as_bytes())
+        .await
+        .unwrap();
+    write_docker_boundary_file(&cert, tls.certificate_chain_pem.as_bytes())
+        .await
+        .unwrap();
+    write_docker_boundary_file(&key, tls.private_key_pem.as_bytes())
+        .await
+        .unwrap();
+    config.guest_tls = Some(DockerGuestTlsPaths { ca, cert, key });
+    sandbox.spec.as_mut().unwrap().launch_authentication =
+        serde_json::to_vec(&authentication).unwrap();
+    guest.state = Some(ContainerState {
+        running: Some(running),
+        status: Some(if running {
+            ContainerStateStatusEnum::RUNNING
+        } else {
+            ContainerStateStatusEnum::EXITED
+        }),
+        ..Default::default()
+    });
+    let (_, mut companion, _) = fixture();
+    companion.id = Some("c".repeat(64));
+    companion.state.as_mut().unwrap().health = Some(bollard::models::Health {
+        status: Some(HealthStatusEnum::HEALTHY),
+        ..Default::default()
+    });
+    let (docker, engine) =
+        running_engine_with(guest.clone(), companion.clone(), presence, wait_reply).await;
+    let mut driver = crate::tests::test_driver_with_config(config.clone());
+    driver.docker = Arc::new(docker);
+    let directory = prepare_docker_boundary_state_dir(&sandbox, &config).unwrap();
+    prepare_docker_boundary_files(
+        &driver.docker,
+        &sandbox,
+        &config,
+        guest.id.as_ref().unwrap(),
+        &DockerImageMetadata {
+            id: guest.image.clone().unwrap(),
+            user: "1234:1235".into(),
+            working_dir: "/sandbox/persistent".into(),
+            volumes: Vec::new(),
+        },
+        &crate::tests::test_workload_identity(),
+        false,
+    )
+    .await
+    .unwrap();
+    write_docker_boundary_file(&directory.join(START_GENERATION_FILE), b"generation-1")
+        .await
+        .unwrap();
+    write(
+        &sandbox,
+        guest.id.as_ref().unwrap(),
+        "generation-1",
+        &companion,
+        &config,
