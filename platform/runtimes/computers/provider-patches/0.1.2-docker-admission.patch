+#[derive(Clone, Copy)]
+enum WaitReply {
+    Pending,
+    TransportError,
+    Eof,
+    StructuredError(i64),
+    Exit(i64),
+}
+#[derive(Clone, Copy)]
+enum CompanionPresence {
+    Existing,
+    Foreign,
+    InspectError,
+}
+#[derive(Clone, Copy)]
+enum CreateFault {
+    GuestCreateLost,
+    GuestStartLost,
+    VolumeLost,
+    ReplaceInode,
+}
+struct CreateFaultControl {
+    fault: CreateFault,
+    directory: std::path::PathBuf,
+    before: std::collections::BTreeMap<std::ffi::OsString, Vec<u8>>,
+    volume_reads: usize,
+    displaced_before: std::collections::BTreeMap<std::ffi::OsString, Vec<u8>>,
+}
+#[derive(Default)]
+struct LifecyclePause {
+    armed: AtomicBool,
+    entered: tokio::sync::Notify,
+    release: tokio::sync::Notify,
+}
+struct RunningEngine {
+    task: Option<JoinHandle<()>>,
+    requests: Arc<Mutex<Vec<String>>>,
+    preparing: Arc<AtomicBool>,
+    owned_cleanup: Arc<AtomicBool>,
+    fresh_creation: Arc<AtomicBool>,
+    guest_present: Arc<AtomicBool>,
+    companion_present: Arc<AtomicBool>,
+    release_wait: Arc<tokio::sync::Notify>,
+    create_fault: Arc<Mutex<Option<CreateFaultControl>>>,
+    lifecycle_pause: Arc<LifecyclePause>,
+    readiness_error: Arc<AtomicBool>,
+    successful_creation: Arc<AtomicBool>,
+}
+impl Drop for RunningEngine {
+    fn drop(&mut self) {
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
+}
+impl RunningEngine {
+    async fn close(mut self) {
+        if let Some(task) = self.task.take() {
+            task.abort();
+            let _ = task.await;
+        }
+    }
+}
+async fn running_engine(
+    guest: ContainerInspectResponse,
+    companion: ContainerInspectResponse,
+) -> (Docker, RunningEngine) {
+    running_engine_with(
+        guest,
+        companion,
+        CompanionPresence::Existing,
+        WaitReply::Pending,
+    )
+    .await
+}
