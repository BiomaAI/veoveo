+        assert!(config.allow_driver_config);
+        assert!(!config.enable_bind_mounts);
+        assert_eq!(
+            config.supervisor_bin.as_deref(),
+            Some(std::path::Path::new("/usr/local/bin/openshell-sandbox"))
