+        (
+            include_str!("../../../veoveo-config/native.toml"),
+            "private-native",
+            "https://172.30.0.1:18805",
+        ),
+    ] {
+        let root: toml::Value = toml::from_str(source).expect("generated TOML");
+        let raw = root["openshell"]["drivers"]["docker"].clone();
+        let config: DockerComputeConfig =
+            raw.clone().try_into().expect("actual strict driver schema");
+        config
+            .validate_configuration(
+                root["openshell"]["gateway"]["bind_address"]
+                    .as_str()
+                    .unwrap()
+                    .parse()
+                    .unwrap(),
+            )
+            .expect("driver startup configuration admission");
+        assert_eq!(config.sandbox_label, label);
+        assert_eq!(config.grpc_endpoint, endpoint);
+        assert_eq!(config.image_pull_policy, ImagePullPolicy::Never);
+        assert!(config.allow_driver_config);
+        assert!(!config.enable_bind_mounts);
+        assert_eq!(
+            config.supervisor_bin.as_deref(),
+            Some(std::path::Path::new("/usr/local/bin/openshell-sandbox"))
+        );
+        assert_eq!(
+            config.supervisor_image.as_deref(),
+            Some(concat!(
+                "registry.internal:5000/provider@sha256:",
+                "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
+            ))
+        );
+        let mut obsolete_case = raw.clone();
+        obsolete_case
+            .as_table_mut()
+            .unwrap()
+            .insert("image_pull_policy".into(), "Never".into());
+        assert!(
+            obsolete_case.try_into::<DockerComputeConfig>().is_err(),
+            "noncanonical policy spelling must reject"
+        );
+        for retired in ["host_gateway_ip", "sandbox_namespace", "network_name"] {
+            let mut unsupported = raw.clone();
+            unsupported
+                .as_table_mut()
+                .unwrap()
+                .insert(retired.into(), "retired".into());
+            assert!(
+                unsupported.try_into::<DockerComputeConfig>().is_err(),
+                "retired {retired}"
+            );
+        }
+    }
+}
