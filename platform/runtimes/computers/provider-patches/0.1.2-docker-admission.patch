+fn launch_for_epoch(generation: &str, epoch: CredentialEpoch) -> SandboxLaunchAuthentication {
+    let (mut launch, issuer, mut identity) = authentication_fixture();
+    identity.auth_epoch = epoch;
+    launch.supervisor.auth_epoch = epoch;
+    identity.runtime_generation = SandboxGenerationId::parse(generation).unwrap();
+    let pair = issuer
+        .mint_pair_with_gateway_token_id(
+            &identity,
+            "00000000-0000-4000-8000-000000000001".parse().unwrap(),
+        )
+        .unwrap();
+    launch.supervisor.runtime_generation = identity.runtime_generation;
+    launch.supervisor.gateway_token = pair.gateway.token;
+    launch.supervisor.sandbox_token = pair.sandbox.token;
