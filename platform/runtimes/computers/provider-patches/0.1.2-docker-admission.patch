+#[tokio::test]
+async fn companion_state_exact_engine_adoption_never_removes_creates_or_overwrites() {
+    let (sandbox, inspected, config) = fixture();
+    let binding = CompanionBinding::capture(
+        &sandbox,
+        "guest-id",
+        "generation-1",
+        &inspected,
+        &config,
+        &authentication_for_generation("generation-1"),
+    )
+    .unwrap();
+    for running in [true, false] {
+        let directory = tempfile::tempdir().unwrap();
+        write_binding(directory.path(), &binding).unwrap();
+        let mut response = inspected.clone();
+        response.state.as_mut().unwrap().running = Some(running);
+        let body = serde_json::to_vec(&response).unwrap();
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let id = binding.container_id.clone();
+        let server = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut header = Vec::new();
+            loop {
+                let mut byte = [0];
+                stream.read_exact(&mut byte).await.unwrap();
+                header.push(byte[0]);
+                assert!(header.len() <= 4096);
+                if header.ends_with(b"\r\n\r\n") {
+                    break;
+                }
+            }
+            let header = String::from_utf8(header).unwrap();
+            assert!(header.starts_with("GET "));
+            assert!(
+                header
+                    .lines()
+                    .next()
+                    .unwrap()
+                    .contains(&format!("/containers/{id}/json "))
+            );
+            stream.write_all(format!("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", body.len()).as_bytes()).await.unwrap();
+            stream.write_all(&body).await.unwrap();
+            drop(stream);
+            assert!(
+                tokio::time::timeout(Duration::from_millis(100), listener.accept())
+                    .await
+                    .is_err(),
+                "Adoption may inspect only the recorded ID, never delete/create/start or stage authentication"
+            );
+        });
+        let docker = Docker::connect_with_http(
+            &format!("http://{address}"),
+            1,
+            bollard::API_DEFAULT_VERSION,
+        )
+        .unwrap();
+        let result = tokio::time::timeout(
+            Duration::from_secs(3),
+            adopt_path(
+                &docker,
+                &sandbox,
+                "guest-id",
+                "generation-1",
+                &config,
+                &path(
+                    directory.path(),
+                    &test_generation("generation-1"),
+                    CredentialEpoch::new(1).unwrap(),
+                ),
+                &authentication_for_generation("generation-1"),
+            ),
+        )
+        .await
+        .unwrap();
+        if running {
+            assert_eq!(result.unwrap(), binding.container_id);
+        } else {
+            assert!(result.is_err());
+        }
+        tokio::time::timeout(Duration::from_secs(3), server)
+            .await
+            .unwrap()
+            .unwrap();
+    }
+}
