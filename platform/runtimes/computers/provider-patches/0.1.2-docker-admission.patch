+struct PreparedControl {
+    driver: DockerComputeDriver,
+    sandbox: DriverSandbox,
+    engine: RunningEngine,
+    directory: PathBuf,
+    authentication: SandboxLaunchAuthentication,
+    guest_id: String,
+}
+impl PreparedControl {
+    async fn close(self) {
+        let process = self
+            .driver
+            .control_processes
+            .lock()
+            .await
+            .remove(&self.sandbox.id);
+        if let Some(process) = process {
+            process.task.abort();
+            let _ = process.task.await;
+        }
+        self.engine.close().await;
+        match std::fs::remove_dir_all(self.directory) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => panic!("owned fixture cleanup failed: {error}"),
+        }
+    }
+}
+async fn prepared_control(
+    wait_reply: WaitReply,
