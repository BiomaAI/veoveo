+#[tokio::test]
+async fn provider_runtime_images_inspect_preloaded_digest_without_refresh() {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let reference = format!("registry.internal/provider@sha256:{}", "a".repeat(64));
+    for (status, body, expected_id) in [
+        ("200 OK", r#"{"Id":"sha256:loaded"}"#, Some("sha256:loaded")),
+        ("404 Not Found", r#"{"message":"No such image"}"#, None),
+        ("200 OK", r#"{"Id":""}"#, None),
+    ] {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut header = Vec::new();
+            loop {
+                let mut byte = [0];
+                stream.read_exact(&mut byte).await.unwrap();
+                header.push(byte[0]);
+                assert!(header.len() <= 4096, "bounded Engine request header");
+                if header.ends_with(b"\r\n\r\n") {
+                    break;
+                }
+            }
+            let header = String::from_utf8(header).unwrap();
+            assert!(
+                header.starts_with("GET "),
+                "image admission may only inspect: {header}"
+            );
+            assert!(header.lines().next().unwrap().contains("/images/"));
+            assert!(header.lines().next().unwrap().contains("/json "));
+            assert!(header.lines().next().unwrap().contains(&"a".repeat(64)));
+            stream.write_all(format!("HTTP/1.1 {status}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len()).as_bytes()).await.unwrap();
+            drop(stream);
+            assert!(
+                tokio::time::timeout(std::time::Duration::from_millis(100), listener.accept())
+                    .await
+                    .is_err(),
+                "runtime image admission must not pull, create or refresh"
+            );
+        });
+        let docker = Docker::connect_with_http(
+            &format!("http://{address}"),
+            1,
+            bollard::API_DEFAULT_VERSION,
+        )
+        .unwrap();
+        let result = tokio::time::timeout(
+            std::time::Duration::from_secs(3),
+            ensure_runtime_image(&docker, &reference, "supervisor"),
+        )
+        .await
+        .unwrap();
+        tokio::time::timeout(std::time::Duration::from_secs(3), server)
+            .await
+            .unwrap()
+            .unwrap();
+        if let Some(id) = expected_id {
+            assert_eq!(result.unwrap(), id);
+        } else {
+            let error = result.unwrap_err();
+            assert!(error.to_string().contains(if status.starts_with("404") {
+                "preload exact Docker supervisor image"
+            } else {
+                "no immutable image ID"
+            }));
+        }
+    }
+    for image in [
+        "ghcr.io/nvidia/openshell/supervisor:dev",
+        "ghcr.io/nvidia/openshell/supervisor:latest",
+        "ghcr.io/nvidia/openshell/supervisor",
+        "ghcr.io/nvidia/openshell/supervisor:0.1.2",
+        "ghcr.io/nvidia/openshell/supervisor@sha256:abc123",
+    ] {
+        assert!(
+            validate_pinned_runtime_image(image).is_err(),
+            "unsupported mutable or malformed image: {image}"
+        );
+    }
 }
 
