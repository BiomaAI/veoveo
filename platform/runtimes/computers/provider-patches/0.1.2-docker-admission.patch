+pub(super) async fn dispatch_create_and_observe_failure(control: &PreparedControl, reason: &str) {
+    control
+        .driver
+        .create_sandbox(Request::new(CreateSandboxRequest {
+            sandbox: Some(control.sandbox.clone()),
+        }))
+        .await
+        .unwrap();
+    let worker = control
+        .driver
+        .pending
+        .lock()
+        .await
+        .get_mut(&control.sandbox.id)
+        .unwrap()
+        .task
+        .take()
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(5), worker)
+        .await
+        .unwrap()
+        .unwrap();
+    let pending = control.driver.pending.lock().await;
+    let status = pending
+        .get(&control.sandbox.id)
+        .unwrap()
+        .sandbox
+        .status
+        .as_ref()
+        .unwrap();
+    assert!(
+        status
+            .conditions
+            .iter()
+            .any(|condition| condition.r#type == "Ready"
+                && condition.status
+                    == if reason.ends_with("Unknown") {
+                        "Unknown"
+                    } else {
+                        "False"
+                    }
+                && condition.reason == reason),
+        "expected {reason}; safe conditions: {:?}",
+        status
+            .conditions
+            .iter()
+            .map(|c| (&c.r#type, &c.status, &c.reason))
+            .collect::<Vec<_>>()
+    );
+}
