+fn companion_state_lifecycle_readmits_after_lookup_racing_unresolved_public_start() {
+    let state = tempfile::tempdir().unwrap();
+    temp_env::with_var("XDG_STATE_HOME", Some(state.path()), || {
+        tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap()
+            .block_on(async {
+                for delete in [false, true] {
+                    let control =
+                        prepared_control(WaitReply::Pending, CompanionPresence::Existing, true)
+                            .await;
+                    install_monitor(&control).await;
+                    control.engine.owned_cleanup.store(true, Ordering::Release);
+                    public_stop_or_delete(
+                        &control.driver,
+                        &control.sandbox.id,
+                        &control.sandbox.name,
+                        false,
+                    )
+                    .await
+                    .unwrap();
+                    control.engine.fresh_creation.store(true, Ordering::Release);
+                    control
+                        .engine
+                        .readiness_error
+                        .store(true, Ordering::Release);
+                    control
+                        .engine
+                        .lifecycle_pause
+                        .armed
+                        .store(true, Ordering::Release);
+                    let driver = control.driver.clone();
+                    let id = control.sandbox.id.clone();
+                    let name = control.sandbox.name.clone();
+                    let mut tasks = tokio::task::JoinSet::new();
+                    tasks.spawn(
+                        async move { public_stop_or_delete(&driver, &id, &name, delete).await },
+                    );
+                    tokio::time::timeout(
+                        Duration::from_secs(3),
+                        control.engine.lifecycle_pause.entered.notified(),
+                    )
+                    .await
+                    .unwrap();
+                    let started = tokio::time::timeout(
+                        Duration::from_secs(5),
+                        public_start(&control, &control.sandbox.id, "generation-2"),
+                    )
+                    .await
+                    .unwrap();
+                    assert!(
+                        started.is_err(),
+                        "controlled readiness observation must remain unresolved"
+                    );
+                    let intent: serde_json::Value = serde_json::from_slice(
+                        &std::fs::read(control.directory.join(PROVISIONING_INTENT_FILE)).unwrap(),
+                    )
+                    .unwrap();
+                    assert_eq!(intent["stage"], "companion_launch");
+                    assert_eq!(intent["generation"], "generation-2");
+                    assert!(
+                        control
+                            .driver
+                            .control_processes
+                            .lock()
+                            .await
+                            .contains_key(&control.sandbox.id)
+                    );
+                    let before = private_snapshot(&control.directory);
+                    control.engine.requests.lock().await.clear();
+                    control.engine.lifecycle_pause.release.notify_one();
+                    assert!(
+                        tokio::time::timeout(Duration::from_secs(3), tasks.join_next())
+                            .await
+                            .unwrap()
+                            .unwrap()
+                            .unwrap()
+                            .is_err()
+                    );
+                    assert_eq!(private_snapshot(&control.directory), before);
+                    let processes = control.driver.control_processes.lock().await;
+                    assert!(
+                        !processes
+                            .get(&control.sandbox.id)
+                            .unwrap()
+                            .task
+                            .is_finished()
+                    );
+                    drop(processes);
+                    assert!(control.engine.companion_present.load(Ordering::Acquire));
+                    assert!(
+                        control
+                            .engine
+                            .requests
+                            .lock()
+                            .await
+                            .iter()
+                            .all(|r| observation_only(r)),
+                        "late lifecycle admission must preserve unresolved resources"
+                    );
+                    assert!(
+                        public_start(&control, &control.sandbox.id, "generation-2")
+                            .await
+                            .is_err()
+                    );
+                    assert_eq!(private_snapshot(&control.directory), before);
+                    control.close().await;
+                }
+            });
+    });
+}
