--- /dev/null
+++ b/crates/openshell-driver-docker/src/companion_state.rs
@@ -0,0 +1,581 @@
+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Credential-free, generation-owned physical companion binding.
+use super::*;
+use bollard::models::ContainerInspectResponse;
+use serde::{Deserialize, Serialize};
+use std::io::Write;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use tokio::io::AsyncReadExt;
+
+const MAX_BYTES: usize = 16 * 1024;
+
+/// Constructed only after the maintained verifier admits retained and current
+/// credentials. Stable facts do not replace current validity or gateway acceptance.
+#[derive(Clone, Debug)]
+pub(super) struct AdmittedAuthentication {
+    public_digest: String,
+    generation: openshell_core::sandbox_generation::SandboxGenerationId,
+    auth_epoch: openshell_core::jwt::CredentialEpoch,
+    valid_until: i64,
+}
+impl AdmittedAuthentication {
+    pub(super) fn confirm_valid(&self) -> Result<(), Status> {
+        use openshell_core::jwt::{JwtClock, SystemJwtClock};
+        if self.valid_until <= SystemJwtClock.now_unix_seconds() {
+            return Err(auth_refusal());
+        }
+        Ok(())
+    }
+}
+fn auth_refusal() -> Status {
+    Status::failed_precondition(
+        "Docker retained companion authentication is unavailable, expired, superseded or belongs to another context; running recovery cannot replace credentials",
+    )
+}
+
+/// A current observed absence admitted under the driver's sandbox ownership lock.
+pub(super) struct AdmittedFreshCompanion {
+    name: String,
+    sandbox_id: String,
+    namespace: String,
+    image: String,
+}
+impl AdmittedFreshCompanion {
+    pub(super) fn name_for<'a>(
+        &'a self,
+        sandbox: &DriverSandbox,
+        config: &DockerDriverRuntimeConfig,
+    ) -> Result<&'a str, Status> {
+        if self.sandbox_id != sandbox.id
+            || self.namespace != config.sandbox_namespace
+            || self.image != config.supervisor_image_id
+            || self.name != format!("{}-supervisor", container_name_for_sandbox(sandbox))
+        {
+            return Err(refusal());
+        }
+        Ok(&self.name)
+    }
+}
+pub(super) async fn admit_fresh(
+    docker: &Docker,
+    sandbox: &DriverSandbox,
+    config: &DockerDriverRuntimeConfig,
+) -> Result<AdmittedFreshCompanion, Status> {
+    let name = format!("{}-supervisor", container_name_for_sandbox(sandbox));
+    match docker.inspect_container(&name, None).await {
+        Err(error) if is_not_found_error(&error) => Ok(AdmittedFreshCompanion {
+            name,
+            sandbox_id: sandbox.id.clone(),
+            namespace: config.sandbox_namespace.clone(),
+            image: config.supervisor_image_id.clone(),
+        }),
+        _ => Err(Status::failed_precondition(
+            "Fresh Docker companion requires observed absence after admitted stopped-generation cleanup; existing or uncertain companion forbids generation, credential and guest-start effects",
+        )),
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CompanionBinding {
+    version: u32,
+    sandbox_id: String,
+    guest_id: String,
+    #[serde(deserialize_with = "deserialize_binding_generation")]
+    generation: openshell_core::sandbox_generation::SandboxGenerationId,
+    #[serde(deserialize_with = "deserialize_binding_epoch")]
+    auth_epoch: openshell_core::jwt::CredentialEpoch,
+    namespace: String,
+    supervisor_image: String,
+    container_id: String,
+    started_at: String,
+    pid: i64,
+    immutable_digest: String,
+    profile_digest: String,
+    authentication_digest: String,
+}
+
+fn deserialize_binding_generation<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> Result<openshell_core::sandbox_generation::SandboxGenerationId, D::Error> {
+    let wire = String::deserialize(deserializer)?;
+    openshell_core::sandbox_generation::SandboxGenerationId::parse(wire)
+        .map_err(|_| serde::de::Error::custom("invalid companion binding generation"))
+}
+fn deserialize_binding_epoch<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> Result<openshell_core::jwt::CredentialEpoch, D::Error> {
+    let wire = u64::deserialize(deserializer)?;
+    openshell_core::jwt::CredentialEpoch::new(wire)
+        .map_err(|_| serde::de::Error::custom("invalid companion binding credential epoch"))
+}
+
+fn refusal() -> Status {
+    Status::failed_precondition(
+        "Docker companion binding is missing, unqualified or does not match the current running physical instance; retained recovery cannot replace it",
+    )
+}
+
+fn immutable_digest(inspected: &ContainerInspectResponse) -> Result<String, Status> {
+    // Hash the controlled Engine configuration rather than persist environment,
+    // arguments or mounts that may contain private installation values.
+    let value = serde_json::to_value(&(
+        inspected.config.as_ref().ok_or_else(refusal)?,
+        inspected.host_config.as_ref().ok_or_else(refusal)?,
+    ))
+    .map_err(|_| refusal())?;
+    let bytes = serde_json::to_vec(&canonical_json(value)).map_err(|_| refusal())?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+fn canonical_json(value: serde_json::Value) -> serde_json::Value {
+    match value {
+        serde_json::Value::Object(fields) => {
+            let sorted: std::collections::BTreeMap<_, _> = fields
+                .into_iter()
+                .map(|(key, value)| (key, canonical_json(value)))
+                .collect();
+            serde_json::Value::Object(sorted.into_iter().collect())
+        }
+        serde_json::Value::Array(values) => {
+            serde_json::Value::Array(values.into_iter().map(canonical_json).collect())
+        }
+        scalar => scalar,
+    }
+}
+
+fn profile_digest(config: &DockerDriverRuntimeConfig) -> Result<String, Status> {
+    let tls = config
+        .guest_tls
+        .as_ref()
+        .map(|tls| (&tls.ca, &tls.cert, &tls.key));
+    let bytes = serde_json::to_vec(&(
+        &config.supervisor_image_id,
+        &config.sandbox_namespace,
+        &config.supervisor_grpc_endpoint,
+        &config.ssh_socket_path,
+        config.sandbox_pids_limit,
+        &config.upstream_proxy,
+        &config.provider_spiffe_workload_api_socket,
+        tls,
+    ))
+    .map_err(|_| refusal())?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+impl CompanionBinding {
+    fn capture(
+        sandbox: &DriverSandbox,
+        guest_id: &str,
+        generation: &str,
+        inspected: &ContainerInspectResponse,
+        config: &DockerDriverRuntimeConfig,
+        authentication: &AdmittedAuthentication,
+    ) -> Result<Self, Status> {
+        authentication.confirm_valid()?;
+        if generation != authentication.generation.as_str() {
+            return Err(auth_refusal());
+        }
+        let state = inspected.state.as_ref().ok_or_else(refusal)?;
+        if state.running != Some(true)
+            || state.paused == Some(true)
+            || state.restarting == Some(true)
+            || state.dead == Some(true)
+        {
+            return Err(refusal());
+        }
+        let pid = state.pid.filter(|pid| *pid > 0).ok_or_else(refusal)?;
+        let started_at = state
+            .started_at
+            .clone()
+            .filter(|v| !v.is_empty())
+            .ok_or_else(refusal)?;
+        let labels = inspected
+            .config
+            .as_ref()
+            .and_then(|c| c.labels.as_ref())
+            .ok_or_else(refusal)?;
+        for (key, expected) in [
+            (LABEL_MANAGED_BY, LABEL_MANAGED_BY_VALUE),
+            (LABEL_SANDBOX_ID, sandbox.id.as_str()),
+            (LABEL_SANDBOX_NAME, sandbox.name.as_str()),
+            (LABEL_SANDBOX_NAMESPACE, config.sandbox_namespace.as_str()),
+            (LABEL_ISOLATION_ROLE, LABEL_ISOLATION_ROLE_SUPERVISOR),
+        ] {
+            if labels.get(key).map(String::as_str) != Some(expected) {
+                return Err(refusal());
+            }
+        }
+        if inspected.image.as_deref() != Some(config.supervisor_image_id.as_str())
+            || guest_id.is_empty()
+            || generation.is_empty()
+        {
+            return Err(refusal());
+        }
+        Ok(Self {
+            version: 2,
+            sandbox_id: sandbox.id.clone(),
+            guest_id: guest_id.into(),
+            generation: authentication.generation.clone(),
+            auth_epoch: authentication.auth_epoch,
+            namespace: config.sandbox_namespace.clone(),
+            supervisor_image: config.supervisor_image_id.clone(),
+            container_id: inspected
+                .id
+                .clone()
+                .filter(|v| !v.is_empty())
+                .ok_or_else(refusal)?,
+            started_at,
+            pid,
+            immutable_digest: immutable_digest(inspected)?,
+            profile_digest: profile_digest(config)?,
+            authentication_digest: authentication.public_digest.clone(),
+        })
+    }
+    fn admit(
+        &self,
+        sandbox: &DriverSandbox,
+        guest_id: &str,
+        generation: &str,
+        inspected: &ContainerInspectResponse,
+        config: &DockerDriverRuntimeConfig,
+        authentication: &AdmittedAuthentication,
+    ) -> Result<(), Status> {
+        let actual = Self::capture(
+            sandbox,
+            guest_id,
+            generation,
+            inspected,
+            config,
+            authentication,
+        )?;
+        if self.version != 2
+            || self.sandbox_id != actual.sandbox_id
+            || self.guest_id != actual.guest_id
+            || self.generation != actual.generation
+            || self.auth_epoch != actual.auth_epoch
+            || self.namespace != actual.namespace
+            || self.supervisor_image != actual.supervisor_image
+            || self.container_id != actual.container_id
+            || self.started_at != actual.started_at
+            || self.pid != actual.pid
+            || self.immutable_digest != actual.immutable_digest
+            || self.profile_digest != actual.profile_digest
+            || self.authentication_digest != actual.authentication_digest
+        {
+            return Err(refusal());
+        }
+        Ok(())
+    }
+}
+
+fn path(
+    directory: &Path,
+    generation: &openshell_core::sandbox_generation::SandboxGenerationId,
+    epoch: openshell_core::jwt::CredentialEpoch,
+) -> PathBuf {
+    // Opaque admitted generation text never becomes a filesystem component.
+    directory.join(format!(
+        "companion-binding-v2-{:x}-{}.json",
+        Sha256::digest(generation.as_str().as_bytes()),
+        epoch.get()
+    ))
+}
+
+pub(super) enum BindingWriteFailure {
+    Capture(Status),
+    Commit(Status),
+}
+impl std::fmt::Debug for BindingWriteFailure {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let (stage, status) = match self {
+            Self::Capture(status) => ("capture", status),
+            Self::Commit(status) => ("commit", status),
+        };
+        formatter
+            .debug_struct("BindingWriteFailure")
+            .field("stage", &stage)
+            .field("code", &status.code())
+            .finish()
+    }
+}
+
+pub(super) fn write(
+    sandbox: &DriverSandbox,
+    guest_id: &str,
+    generation: &str,
+    inspected: &ContainerInspectResponse,
+    config: &DockerDriverRuntimeConfig,
+    authentication: &AdmittedAuthentication,
+) -> Result<(), BindingWriteFailure> {
+    let binding = CompanionBinding::capture(
+        sandbox,
+        guest_id,
+        generation,
+        inspected,
+        config,
+        authentication,
+    )
+    .map_err(BindingWriteFailure::Capture)?;
+    let directory =
+        docker_boundary_state_dir(sandbox, config).map_err(BindingWriteFailure::Commit)?;
+    write_binding(&directory, &binding).map_err(BindingWriteFailure::Commit)
+}
+
+fn write_binding(directory: &Path, binding: &CompanionBinding) -> Result<(), Status> {
+    let generation = &binding.generation;
+    let bytes = serde_json::to_vec(binding).map_err(|_| refusal())?;
+    if bytes.len() > MAX_BYTES {
+        return Err(refusal());
+    }
+    let mut temporary = tempfile::NamedTempFile::new_in(&directory).map_err(|_| refusal())?;
+    temporary
+        .as_file()
+        .set_permissions(std::fs::Permissions::from_mode(0o600))
+        .map_err(|_| refusal())?;
+    temporary
+        .write_all(&bytes)
+        .and_then(|()| temporary.as_file().sync_all())
+        .map_err(|_| refusal())?;
+    temporary
+        .persist_noclobber(path(directory, generation, binding.auth_epoch))
+        .map_err(|_| refusal())?;
+    std::fs::File::open(directory)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| refusal())?;
+    Ok(())
+}
+
+pub(super) async fn adopt(
+    docker: &Docker,
+    sandbox: &DriverSandbox,
+    guest_id: &str,
+    generation: &str,
+    config: &DockerDriverRuntimeConfig,
+    authentication: &AdmittedAuthentication,
+) -> Result<String, Status> {
+    if generation != authentication.generation.as_str() {
+        return Err(auth_refusal());
+    }
+    let directory = docker_boundary_state_dir(sandbox, config)?;
+    adopt_path(
+        docker,
+        sandbox,
+        guest_id,
+        generation,
+        config,
+        &path(
+            &directory,
+            &authentication.generation,
+            authentication.auth_epoch,
+        ),
+        authentication,
+    )
+    .await
+}
+
+async fn adopt_path(
+    docker: &Docker,
+    sandbox: &DriverSandbox,
+    guest_id: &str,
+    generation: &str,
+    config: &DockerDriverRuntimeConfig,
+    path: &Path,
+    authentication: &AdmittedAuthentication,
+) -> Result<String, Status> {
+    let bytes = read_private_bytes(path).await?;
+    let binding: CompanionBinding = serde_json::from_slice(&bytes).map_err(|_| refusal())?;
+    let inspected = docker
+        .inspect_container(&binding.container_id, None)
+        .await
+        .map_err(|_| refusal())?;
+    binding.admit(
+        sandbox,
+        guest_id,
+        generation,
+        &inspected,
+        config,
+        authentication,
+    )?;
+    Ok(binding.container_id)
+}
+
+async fn read_private_bytes(path: &Path) -> Result<Vec<u8>, Status> {
+    let file = tokio::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(path)
+        .await
+        .map_err(|_| refusal())?;
+    let metadata = file.metadata().await.map_err(|_| refusal())?;
+    if !metadata.is_file()
+        || metadata.permissions().mode() & 0o077 != 0
+        || metadata.uid() != rustix::process::geteuid().as_raw()
+    {
+        return Err(refusal());
+    }
+    let mut bytes = Vec::new();
+    file.take((MAX_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .await
+        .map_err(|_| refusal())?;
+    if bytes.len() > MAX_BYTES {
+        return Err(refusal());
+    }
+    Ok(bytes)
+}
+
+pub(super) async fn admit_authentication(
+    sandbox_id: &str,
+    config: &DockerDriverRuntimeConfig,
+    encoded: &[u8],
+) -> Result<AdmittedAuthentication, Status> {
+    let current: openshell_core::jwt::SandboxLaunchAuthentication =
+        serde_json::from_slice(encoded).map_err(|_| refusal())?;
+    current.validate().map_err(|_| refusal())?;
+    let directory = docker_boundary_state_dir_by_id(sandbox_id, config)?;
+    let bytes = read_private_bytes(&directory.join(SUPERVISOR_AUTH_BUNDLE_FILE)).await?;
+    let old: openshell_core::jwt::SupervisorAuthBundle =
+        serde_json::from_slice(&bytes).map_err(|_| refusal())?;
+    let descriptor = read_docker_runtime_descriptor(sandbox_id, config)
+        .await?
+        .ok_or_else(refusal)?;
+    if descriptor.boundary_id != sandbox_id
+        || descriptor.generation != old.runtime_generation.to_string()
+    {
+        return Err(refusal());
+    }
+    admit_authentication_values(sandbox_id, &old, &current)
+}
+
+fn admit_authentication_values(
+    sandbox_id: &str,
+    old: &openshell_core::jwt::SupervisorAuthBundle,
+    current: &openshell_core::jwt::SandboxLaunchAuthentication,
+) -> Result<AdmittedAuthentication, Status> {
+    use openshell_core::jwt::{JwtClock, SessionJwtVerifier, SessionTokenProfile, SystemJwtClock};
+    current.validate().map_err(|_| auth_refusal())?;
+    old.validate().map_err(|_| auth_refusal())?;
+    if old.runtime_generation != current.supervisor.runtime_generation
+        || old.auth_epoch != current.supervisor.auth_epoch
+    {
+        return Err(auth_refusal());
+    }
+    // The current trusted launch keys and issuer must accept the retained tokens.
+    // Rotation of correlation session_id does not change authorization identity.
+    let mut valid_until = i64::MAX;
+    for profile in [SessionTokenProfile::Gateway, SessionTokenProfile::Sandbox] {
+        let verifier = SessionJwtVerifier::new(
+            &current.gateway_id,
+            profile,
+            current.verification_keys.clone(),
+            Arc::new(SystemJwtClock),
+        )
+        .map_err(|_| auth_refusal())?;
+        let (retained, supplied) = match profile {
+            SessionTokenProfile::Gateway => (&old.gateway_token, &current.supervisor.gateway_token),
+            SessionTokenProfile::Sandbox => (&old.sandbox_token, &current.supervisor.sandbox_token),
+        };
+        let retained = verifier
+            .verify(retained.expose_secret())
+            .map_err(|_| auth_refusal())?;
+        let supplied = verifier
+            .verify(supplied.expose_secret())
+            .map_err(|_| auth_refusal())?;
+        valid_until = valid_until
+            .min(retained.expires_at)
+            .min(supplied.expires_at);
+        let now = SystemJwtClock.now_unix_seconds();
+        if retained.expires_at <= now
+            || supplied.expires_at <= now
+            || retained.runtime_generation != old.runtime_generation
+            || supplied.runtime_generation != current.supervisor.runtime_generation
+            || retained.auth_epoch != old.auth_epoch
+            || supplied.auth_epoch != current.supervisor.auth_epoch
+            || retained.sandbox_id.as_str() != sandbox_id
+            || retained.sandbox_id != supplied.sandbox_id
+            || retained.runtime_generation != supplied.runtime_generation
+            || retained.auth_epoch != supplied.auth_epoch
+            || (profile == SessionTokenProfile::Gateway && retained.token_id != supplied.token_id)
+        {
+            return Err(auth_refusal());
+        }
+    }
+    let verifier = SessionJwtVerifier::new(
+        &current.gateway_id,
+        SessionTokenProfile::Gateway,
+        current.verification_keys.clone(),
+        Arc::new(SystemJwtClock),
+    )
+    .map_err(|_| auth_refusal())?;
+    let verified = verifier
+        .verify(old.gateway_token.expose_secret())
+        .map_err(|_| auth_refusal())?;
+    let mut keys = current
+        .verification_keys
+        .iter()
+        .map(|key| (&key.key_id, &key.public_key_pem))
+        .collect::<Vec<_>>();
+    keys.sort_by(|left, right| left.0.cmp(right.0));
+    let bytes = serde_json::to_vec(&(
+        &current.gateway_id,
+        keys,
+        verified.sandbox_id.as_str(),
+        verified.runtime_generation.as_str(),
+        verified.auth_epoch,
+        verified.token_id.to_string(),
+    ))
+    .map_err(|_| auth_refusal())?;
+    Ok(AdmittedAuthentication {
+        public_digest: format!("{:x}", Sha256::digest(bytes)),
+        generation: verified.runtime_generation,
+        auth_epoch: verified.auth_epoch,
+        valid_until,
+    })
+}
+
+/// Admit the exact byte snapshot staged into the newly created companion.
+pub(super) async fn prepared_authentication(
+    sandbox_id: &str,
+    config: &DockerDriverRuntimeConfig,
+    descriptor_bytes: &[u8],
+    auth_bytes: &[u8],
+) -> Result<AdmittedAuthentication, Status> {
+    use openshell_core::jwt::{
+        SandboxLaunchAuthentication, SessionVerificationKey, SupervisorAuthBundle,
+    };
+    let directory = docker_boundary_state_dir_by_id(sandbox_id, config)?;
+    let boundary: BoundaryConfig =
+        serde_json::from_slice(&read_private_bytes(&directory.join(BOUNDARY_CONFIG_FILE)).await?)
+            .map_err(|_| auth_refusal())?;
+    let descriptor: SandboxRuntimeDescriptor =
+        serde_json::from_slice(descriptor_bytes).map_err(|_| auth_refusal())?;
+    let old: SupervisorAuthBundle =
+        serde_json::from_slice(auth_bytes).map_err(|_| auth_refusal())?;
+    if boundary.boundary_id != sandbox_id
+        || descriptor.boundary_id != sandbox_id
+        || boundary.generation != old.runtime_generation.as_str()
+        || descriptor.generation != boundary.generation
+        || boundary.auth_epoch != old.auth_epoch
+    {
+        return Err(auth_refusal());
+    }
+    let launch = SandboxLaunchAuthentication {
+        supervisor: old.clone(),
+        gateway_id: boundary.gateway_id,
+        verification_keys: boundary
+            .verification_keys
+            .into_iter()
+            .map(|key| SessionVerificationKey {
+                key_id: key.key_id,
+                public_key_pem: key.public_key_pem.into_bytes(),
+            })
+            .collect(),
+    };
+    admit_authentication_values(sandbox_id, &old, &launch)
+}
