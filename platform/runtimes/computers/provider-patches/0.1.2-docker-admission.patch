+#[tokio::test]
+async fn companion_state_startup_preserves_candidates_and_their_trust_volumes() {
+    for mount_observation in [
+        CandidateMountObservation::Complete,
+        CandidateMountObservation::MissingList,
+        CandidateMountObservation::MissingType,
+        CandidateMountObservation::MissingVolumeName,
+    ] {
+        let config = runtime_config();
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let mut responses = vec![
+                ("GET", "/containers/json?", serde_json::json!([])),
+                (
+                    "GET",
+                    "/containers/json?",
+                    serde_json::json!([
+                        {"Id":"retained-companion","Labels":{"openshell.ai/isolation-role":"supervisor","openshell.ai/sandbox-id":"retained-guest"},
+                         "Mounts":[{"Type":"volume","Name":"retained-trust"}]},
+                        {"Id":"orphan-companion","Labels":{"openshell.ai/isolation-role":"supervisor"},
+                         "Mounts":[{"Type":"volume","Name":"unresolved-trust"}]},
+                        {"Id":"staging","Labels":{"openshell.ai/isolation-role":"staging"}},
+                        {"Id":"identity","Labels":{"openshell.ai/isolation-role":"identity"}}
+                    ]),
+                ),
+                ("DELETE", "/containers/staging?", serde_json::json!({})),
+                ("DELETE", "/containers/identity?", serde_json::json!({})),
+                (
+                    "GET",
+                    "/volumes?",
+                    serde_json::json!({"Volumes":[
+                        {"Name":"retained-trust","Driver":"local","Mountpoint":"/owned","Scope":"local","Labels":{"openshell.ai/sandbox-id":"retained-guest"},"Options":{}},
+                        {"Name":"unresolved-trust","Driver":"local","Mountpoint":"/owned","Scope":"local","Labels":{},"Options":{}},
+                        {"Name":"ephemeral-orphan","Driver":"local","Mountpoint":"/owned","Scope":"local","Labels":{},"Options":{}}
+                    ]}),
+                ),
+                ("DELETE", "/volumes/ephemeral-orphan", serde_json::json!({})),
+            ];
+            match mount_observation {
+                CandidateMountObservation::Complete => {}
+                CandidateMountObservation::MissingList => {
+                    responses[1].2[1].as_object_mut().unwrap().remove("Mounts");
+                    responses.pop();
+                }
+                CandidateMountObservation::MissingType => {
+                    responses[1].2[1]["Mounts"][0]
+                        .as_object_mut()
+                        .unwrap()
+                        .remove("Type");
+                    responses.pop();
+                }
+                CandidateMountObservation::MissingVolumeName => {
+                    responses[1].2[1]["Mounts"][0]
+                        .as_object_mut()
+                        .unwrap()
+                        .remove("Name");
+                    responses.pop();
+                }
+            }
+            for (method, path, body) in responses {
+                let (mut stream, _) = listener.accept().await.unwrap();
+                let mut bytes = Vec::new();
+                loop {
+                    let mut byte = [0];
+                    stream.read_exact(&mut byte).await.unwrap();
+                    bytes.push(byte[0]);
+                    assert!(bytes.len() <= 8192);
+                    if bytes.ends_with(b"\r\n\r\n") {
+                        break;
+                    }
+                }
+                let request = String::from_utf8(bytes).unwrap();
+                let line = request.lines().next().unwrap();
+                assert!(
+                    line.starts_with(&format!("{method} ")),
+                    "startup attempted a forbidden mutation: {line}"
+                );
+                assert!(
+                    line.contains(path),
+                    "startup removed a retained candidate or trust input: {line}"
+                );
+                let body = serde_json::to_vec(&body).unwrap();
+                stream.write_all(format!("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", body.len()).as_bytes()).await.unwrap();
+                stream.write_all(&body).await.unwrap();
+            }
+            assert!(
+                tokio::time::timeout(Duration::from_millis(100), listener.accept())
+                    .await
+                    .is_err()
+            );
+        });
+        let mut driver = crate::tests::test_driver_with_config(config);
+        driver.docker = Arc::new(
+            Docker::connect_with_http(
+                &format!("http://{address}"),
+                1,
+                bollard::API_DEFAULT_VERSION,
+            )
+            .unwrap(),
+        );
+        let result = tokio::time::timeout(
+            Duration::from_secs(3),
+            driver.reconcile_runtime_resources_at_startup(),
+        )
+        .await;
+        assert!(
+            result.as_ref().unwrap().is_ok(),
+            "startup cleanup cannot destroy retained companion candidates: {result:?}"
+        );
+        tokio::time::timeout(Duration::from_secs(3), server)
+            .await
+            .unwrap()
+            .unwrap();
+    }
+}
