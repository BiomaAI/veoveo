+#[test]
+fn companion_state_current_auth_accepts_only_retained_live_token_lineage() {
+    let (current, issuer, identity) = authentication_fixture();
+    let old = current.supervisor.clone();
+    let mut supplied = current.clone();
+    supplied.supervisor.session_id = openshell_core::SandboxSessionId::new();
+    admit_authentication_values("sbx-123", &old, &supplied).unwrap();
+    let pair = issuer.mint_pair(&identity).unwrap();
+    supplied.supervisor.gateway_token = pair.gateway.token;
+    assert!(
+        admit_authentication_values("sbx-123", &old, &supplied).is_err(),
+        "Superseded lineage cannot adopt"
+    );
+    supplied = current.clone();
+    supplied.supervisor.auth_epoch = CredentialEpoch::new(2).unwrap();
+    assert!(admit_authentication_values("sbx-123", &old, &supplied).is_err());
+    supplied = current.clone();
+    supplied.gateway_id = "foreign-gateway".into();
+    assert!(admit_authentication_values("sbx-123", &old, &supplied).is_err());
+    assert!(admit_authentication_values("foreign-sandbox", &old, &current).is_err());
+    let mut expired = old.clone();
+    expired.gateway_token = SecretJwt::parse("private-malformed-token-sentinel").unwrap();
+    let error = admit_authentication_values("sbx-123", &expired, &current).unwrap_err();
+    assert!(!format!("{error:?}").contains("private-malformed-token-sentinel"));
+    let stale_issuer = SessionJwtIssuer::from_ed25519_pem(b"-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIJ1hsZ3v/VpguoRK9JLsLMREScVpezJpGXA7rAMcrn9g\n-----END PRIVATE KEY-----\n",
+            "test-key", "gateway-test", Some(Duration::from_secs(3600)), Arc::new(FixedClock(1))).unwrap();
+    let stale = stale_issuer.mint_pair(&identity).unwrap();
+    expired.gateway_token = stale.gateway.token;
+    assert!(
+        admit_authentication_values("sbx-123", &expired, &current).is_err(),
+        "Expired retained launch credentials are unsupported"
+    );
+}
