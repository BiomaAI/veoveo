@@ -387,6 +387,27 @@ pub struct MtlsAuthConfig {
     /// Kubernetes sandbox pods and external users must not share user auth.
     #[serde(default)]
     pub enabled: bool,
+    /// Only these exact certificate CNs may become user principals. Other
+    /// trusted clients (including supervisors) still require sandbox JWTs.
+    /// An empty or malformed list admits no mTLS user identities.
+    #[serde(default)]
+    pub user_common_names: Vec<String>,
+}
+
+impl MtlsAuthConfig {
+    #[must_use]
+    pub fn allows_user(&self, subject: &str) -> bool {
+        self.enabled
+            && !self.user_common_names.is_empty()
+            && self.user_common_names.len() <= 64
+            && self.user_common_names.iter().all(|name| {
+                !name.is_empty()
+                    && name.len() <= 128
+                    && name.trim() == name
+                    && !name.chars().any(char::is_control)
+            })
+            && self.user_common_names.iter().any(|name| name == subject)
+    }
 }
 
