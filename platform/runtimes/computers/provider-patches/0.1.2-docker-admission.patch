+fn private_snapshot(directory: &Path) -> std::collections::BTreeMap<std::ffi::OsString, Vec<u8>> {
+    std::fs::read_dir(directory)
+        .unwrap()
+        .map(|entry| {
+            let entry = entry.unwrap();
+            (entry.file_name(), std::fs::read(entry.path()).unwrap())
+        })
+        .collect()
+}
+fn launch_for_generation(generation: &str) -> SandboxLaunchAuthentication {
+    launch_for_epoch(generation, CredentialEpoch::new(1).unwrap())
