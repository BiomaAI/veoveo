+#[test]
+fn companion_state_wait_unknown_preserves_resources_binding_and_monitor_fence() {
+    let state = tempfile::tempdir().unwrap();
+    temp_env::with_var("XDG_STATE_HOME", Some(state.path()), || {
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        runtime.block_on(async {
+            for reply in [
+                WaitReply::TransportError,
+                WaitReply::Eof,
+                WaitReply::StructuredError(0),
+                WaitReply::StructuredError(-1),
+            ] {
+                let control = prepared_control(reply, CompanionPresence::Existing, true).await;
+                let before = private_snapshot(&control.directory);
+                let encoded = serde_json::to_vec(&control.authentication).unwrap();
+                assert!(
+                    control
+                        .driver
+                        .start_sandbox(
+                            &control.sandbox.id,
+                            &control.sandbox.name,
+                            "generation-1",
+                            &encoded
+                        )
+                        .await
+                        .unwrap()
+                );
+                let mut observed = control
+                    .driver
+                    .control_processes
+                    .lock()
+                    .await
+                    .get(&control.sandbox.id)
+                    .unwrap()
+                    .observation
+                    .clone();
+                control.engine.release_wait.notify_one();
+                tokio::time::timeout(Duration::from_secs(3), async {
+                    while *observed.borrow() != SupervisorObservation::Unresolved {
+                        observed.changed().await.unwrap();
+                    }
+                    loop {
+                        if control
+                            .driver
+                            .runtime_failures
+                            .lock()
+                            .await
+                            .get(&control.sandbox.id)
+                            .is_some()
+                        {
+                            break;
+                        }
+                        tokio::task::yield_now().await;
+                    }
+                })
+                .await
+                .unwrap();
+                assert!(
+                    control
+                        .driver
+                        .start_sandbox(
+                            &control.sandbox.id,
+                            &control.sandbox.name,
+                            "generation-1",
+                            &encoded
+                        )
+                        .await
+                        .is_err(),
+                    "Unknown wait cannot replay Running recovery or erase its fence"
+                );
+                control
+                    .driver
+                    .clear_runtime_failure(&control.sandbox.id)
+                    .await;
+                let failure = control
+                    .driver
+                    .runtime_failures
+                    .lock()
+                    .await
+                    .get(&control.sandbox.id)
+                    .unwrap()
+                    .clone();
+                assert!(failure.disposition == RuntimeFailureDisposition::ObservationUnresolved);
+                assert!(!failure.message.contains("private-wait-sentinel"));
+                let mut current = control.sandbox.clone();
+                current.status = Some(DriverSandboxStatus {
+                    conditions: vec![DriverCondition {
+                        r#type: "Ready".into(),
+                        status: "True".into(),
+                        reason: "BackendReady".into(),
+                        ..Default::default()
+                    }],
+                    ..Default::default()
+                });
+                control.driver.apply_runtime_failure(&mut current).await;
+                let conditions = &current.status.as_ref().unwrap().conditions;
+                assert!(
+                    conditions
+                        .iter()
+                        .any(|c| c.r#type == "Ready" && c.status == "Unknown")
+                );
+                assert!(
+                    conditions
+                        .iter()
+                        .any(|c| c.r#type == "ControlObservation" && c.status == "Unknown")
+                );
+                assert!(
+                    !control
+                        .driver
+                        .control_processes
+                        .lock()
+                        .await
+                        .get(&control.sandbox.id)
+                        .unwrap()
+                        .task
+                        .is_finished()
+                );
+                assert_eq!(private_snapshot(&control.directory), before);
+                for request in control.engine.requests.lock().await.iter() {
+                    assert!(
+                        request.starts_with("GET ")
+                            || (request.starts_with("POST ") && request.contains("/wait")),
+                        "Unknown wait attempted destructive effect: {request}"
+                    );
+                }
+                control.close().await;
+            }
+        });
+    });
