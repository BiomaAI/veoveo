+fn companion_state_launch_failure_diagnostics_exclude_status_messages() {
+    let failure = ControlSpawnFailure {
+        status: Status::failed_precondition("Bearer private-jwt private-payload"),
+        monitor: None,
+        stage: ControlLaunchStage::PreparedAuthentication,
+    };
+    assert_eq!(
+        failure.diagnostic(),
+        "stage=PreparedAuthentication code=FailedPrecondition"
+    );
+    for failure in [
+        BindingWriteFailure::Capture(Status::failed_precondition(
+            "Bearer private-jwt private-payload",
+        )),
+        BindingWriteFailure::Commit(Status::failed_precondition(
+            "Bearer private-jwt private-payload",
+        )),
+    ] {
+        let formatted = format!("{failure:?}");
+        assert!(formatted.contains("FailedPrecondition"));
+        for secret in ["Bearer", "private-jwt", "private-payload"] {
+            assert!(!formatted.contains(secret));
+        }
+    }
+    for secret in ["Bearer", "private-jwt", "private-payload"] {
+        assert!(!failure.diagnostic().contains(secret));
+    }
