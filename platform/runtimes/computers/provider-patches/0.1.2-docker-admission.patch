new file mode 100644
index 00000000..251ec76d
--- /dev/null
+++ b/crates/openshell-core/tests/mtls_user_admission.rs
@@ -0,0 +1,34 @@
+use openshell_core::config::MtlsAuthConfig;
+
+#[test]
+fn trusted_supervisor_certificate_does_not_become_a_user() {
+    let config = MtlsAuthConfig {
+        enabled: true,
+        user_common_names: vec!["veoveo-computers-worker".into()],
+    };
+    assert!(config.allows_user("veoveo-computers-worker"));
+    for subject in [
+        "veoveo-computer-supervisor",
+        "unknown",
+        "",
+        "VEOVEO-COMPUTERS-WORKER",
+    ] {
+        assert!(!config.allows_user(subject));
+    }
+}
+
+#[test]
+fn unconfigured_disabled_and_malformed_user_admission_fail_closed() {
+    let mut config = MtlsAuthConfig {
+        enabled: true,
+        ..Default::default()
+    };
+    assert!(!config.allows_user("worker"));
+    for names in [vec!["worker".into(), " ".into()], vec!["worker".into(); 65]] {
+        config.user_common_names = names;
+        assert!(!config.allows_user("worker"));
+    }
+    config.user_common_names = vec!["worker".into()];
+    config.enabled = false;
+    assert!(!config.allows_user("worker"));
+}
