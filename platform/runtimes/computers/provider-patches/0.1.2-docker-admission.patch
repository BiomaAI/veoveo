+#[test]
+fn companion_state_public_create_replaced_directory_refuses_cleanup() {
+    let state = tempfile::tempdir().unwrap();
+    temp_env::with_var("XDG_STATE_HOME", Some(state.path()), || {
+        tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap().block_on(async {
+            let mut control = prepared_control(WaitReply::Pending, CompanionPresence::Existing, false).await;
+            control.engine.guest_present.store(false, Ordering::Release);
+            control.engine.companion_present.store(false, Ordering::Release);
+            std::fs::remove_dir_all(&control.directory).unwrap();
+            control.engine.fresh_creation.store(true, Ordering::Release);
+            let spec = control.sandbox.spec.as_mut().unwrap();
+            spec.sandbox_token = "controlled-private-token".into();
+            spec.template.as_mut().unwrap().driver_config = Some(openshell_core::proto_struct::json_object_to_struct(serde_json::json!({"mounts":[{"type":"volume","source":"controlled-volume","target":"/controlled","read_only":true}]}).as_object().unwrap().clone()).unwrap());
+            *control.engine.create_fault.lock().await = Some(CreateFaultControl { fault: CreateFault::ReplaceInode, directory: control.directory.clone(), before: Default::default(), volume_reads: 0, displaced_before: Default::default() });
+            dispatch_create_and_observe_failure(&control, "ResourceAdmissionDenied").await;
+            let f = control.engine.create_fault.lock().await;
+            assert_eq!(f.as_ref().unwrap().volume_reads, 2, "control must reach claimed-directory local admission");
+            assert!(private_snapshot(&control.directory) == f.as_ref().unwrap().before, "replacement directory cannot inherit cleanup ownership");
+            drop(f);
+            assert_unowned_lifecycle_refusal(&control).await;
+            let f = control.engine.create_fault.lock().await;
+            let displaced_before = f.as_ref().unwrap().displaced_before.clone();
+            drop(f);
+            let displaced = control.directory.with_extension("displaced");
+            assert!(!displaced_before.is_empty(), "original claimed state must contain the operation's private token");
+            assert!(private_snapshot(&displaced) == displaced_before, "original claimed inode bytes must survive the local refusal");
+            assert!(displaced.is_dir());
+            assert!(!control.engine.requests.lock().await.iter().any(|r| r.contains("/volumes/create") || (r.starts_with("DELETE ") && !r.contains("-identity?"))));
+            control.close().await;
+            std::fs::remove_dir_all(displaced).unwrap();
+        });
+    });
+}
