+#[test]
+fn companion_state_public_create_lost_dispatch_preserves_journal_and_fence() {
+    let state = tempfile::tempdir().unwrap();
+    temp_env::with_var("XDG_STATE_HOME", Some(state.path()), || {
+        tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap().block_on(async {
+            for (fault, reason) in [(CreateFault::GuestCreateLost, "ContainerCreateObservationUnknown"), (CreateFault::GuestStartLost, "ContainerStartObservationUnknown"), (CreateFault::VolumeLost, "BoundaryChannelObservationUnknown")] {
+                let mut control = prepared_control(WaitReply::Pending, CompanionPresence::Existing, false).await;
+                control.engine.guest_present.store(false, Ordering::Release);
+                control.engine.companion_present.store(false, Ordering::Release);
+                let trust = control.directory.with_extension("fixture-trust");
+                std::fs::create_dir(&trust).unwrap();
+                let tls = control.driver.config.guest_tls.as_mut().unwrap();
+                for path in [&mut tls.ca, &mut tls.cert, &mut tls.key] {
+                    let next = trust.join(path.file_name().unwrap());
+                    std::fs::copy(&*path, &next).unwrap(); *path = next;
+                }
+                std::fs::remove_dir_all(&control.directory).unwrap();
+                control.engine.fresh_creation.store(true, Ordering::Release);
+                control.sandbox.spec.as_mut().unwrap().sandbox_token = "controlled-private-token".into();
+                *control.engine.create_fault.lock().await = Some(CreateFaultControl { fault, directory: control.directory.clone(), before: Default::default(), volume_reads: 0, displaced_before: Default::default() });
+                dispatch_create_and_observe_failure(&control, reason).await;
+                let before = control.engine.create_fault.lock().await.as_ref().unwrap().before.clone();
+                assert!(!before.is_empty(), "control must reach applied dispatch");
+                let intent: serde_json::Value = serde_json::from_slice(&std::fs::read(control.directory.join(PROVISIONING_INTENT_FILE)).unwrap()).unwrap();
+                let stage: ProvisioningStage = serde_json::from_value(intent["stage"].clone()).unwrap();
+                assert_eq!(stage, match fault { CreateFault::GuestCreateLost => ProvisioningStage::GuestCreate, CreateFault::GuestStartLost => ProvisioningStage::GuestStart, CreateFault::VolumeLost => ProvisioningStage::RuntimeVolumes, CreateFault::ReplaceInode => unreachable!() });
+                assert_eq!(intent["sandbox_id"].as_str(), Some(control.sandbox.id.as_str()));
+                assert_eq!(intent["generation"].as_str(), Some("generation-1"));
+
+                assert!(private_snapshot(&control.directory) == before, "unresolved dispatch must preserve original private bytes");
+                assert!(admit_no_unfinished_provisioning(&control.sandbox.id, &control.driver.config).is_err());
+                let previous_requests = control.engine.requests.lock().await.len();
+                assert!(control.driver.start_sandbox(&control.sandbox.id, &control.sandbox.name, "generation-1", &control.sandbox.spec.as_ref().unwrap().launch_authentication).await.is_err());
+                assert!(control.engine.requests.lock().await.iter().skip(previous_requests).all(|r| r.starts_with("GET ")), "Running/Start intent refusal precedes Engine mutations");
+                if !matches!(fault, CreateFault::VolumeLost) {
+                    let mut reopened = crate::tests::test_driver_with_config(control.driver.config.clone());
+                    reopened.docker = control.driver.docker.clone();
+                    let observed = reopened.get_sandbox_snapshot(&control.sandbox.id, &control.sandbox.name).await.unwrap().unwrap();
+                    assert!(observed.status.unwrap().conditions.iter().any(|c| c.r#type == "ProvisioningObservation" && c.status == "Unknown"));
+                }
+
+                control.driver.reconcile_runtime_resources_at_startup().await.unwrap();
+                assert!(control.driver.stop_sandbox(Request::new(StopSandboxRequest { sandbox_id: control.sandbox.id.clone(), name: control.sandbox.name.clone() })).await.is_err(), "unsettled provisioning cannot authorize destructive Stop settlement");
+                assert!(control.driver.delete_sandbox(Request::new(DeleteSandboxRequest { sandbox_id: control.sandbox.id.clone(), name: control.sandbox.name.clone() })).await.is_err(), "unsettled provisioning cannot authorize destructive Delete settlement");
+                assert!(private_snapshot(&control.directory) == before);
+
+                let requests = control.engine.requests.lock().await.clone();
+                let guest_creates = requests.iter().filter(|r| r.starts_with("POST ") && r.contains("/containers/create?") && !r.contains("-identity") && !r.contains("supervisor")).count();
+                assert_eq!(guest_creates, if matches!(fault, CreateFault::VolumeLost) {0} else {1}, "guest Create cannot be redispatched");
+                let guest_starts = requests.iter().filter(|r| r.starts_with("POST ") && r.contains("/start")).count();
+                assert_eq!(guest_starts, if matches!(fault, CreateFault::GuestStartLost) {1} else {0}, "guest Start cannot be redispatched");
+                assert!(!requests.iter().any(|r| (r.starts_with("DELETE ") && !r.contains("-identity?")) || r.contains("/stop?")), "unknown outcomes cannot authorize compensation");
+                assert!(control.driver.create_sandbox(Request::new(CreateSandboxRequest { sandbox: Some(control.sandbox.clone()) })).await.is_err(), "unresolved Create cannot redispatch");
+                let mut observed = control.sandbox.clone();
+                observed.status = Some(DriverSandboxStatus { conditions: vec![DriverCondition { r#type: "Ready".into(), status: "True".into(), reason: "BackendReady".into(), ..Default::default() }], ..Default::default() });
+                control.driver.apply_runtime_failure(&mut observed).await;
+                assert!(observed.status.unwrap().conditions.iter().any(|c| c.r#type == "ProvisioningObservation" && c.status == "Unknown"));
+                control.close().await;
+                std::fs::remove_dir_all(trust).unwrap();
+            }
+        });
+    });
+}
