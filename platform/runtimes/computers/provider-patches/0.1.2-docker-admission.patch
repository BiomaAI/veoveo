new file mode 100644
index 0000000000000000000000000000000000000000..b0dc28fb6dd410615405abb4f47baec50366f293
--- /dev/null
+++ b/crates/openshell-driver-docker/src/restart_state.rs
@@ -0,0 +1,426 @@
+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Immutable driver-private facts for restoring the exact admitted supervisor.
+use super::*;
+use bollard::models::ContainerInspectResponse;
+use openshell_core::proto::compute::v1::DriverSandboxSpec;
+use prost::Message;
+use serde::{Deserialize, Serialize};
+use std::io::Write;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use tokio::io::AsyncReadExt;
+
+const FILE: &str = "supervisor-restart-v1.json";
+const MAX_BYTES: usize = 1_048_576;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RestartState {
+    version: u32,
+    sandbox_id: String,
+    sandbox_name: String,
+    workspace: String,
+    namespace: String,
+    supervisor_image: String,
+    container_id: String,
+    image_id: String,
+    ownership_labels: HashMap<String, String>,
+    host_config: HostConfig,
+    // Maintained Prost encoding of the typed, credential-free immutable spec subset.
+    spec: Vec<u8>,
+}
+
+fn refusal(message: &'static str) -> Status {
+    Status::failed_precondition(message)
+}
+
+// These fields are immutable in the selected driver (no resource-update RPC).
+// Docker transport options, logging state and mutable process status are excluded.
+fn immutable_resources(config: &HostConfig) -> HostConfig {
+    HostConfig {
+        nano_cpus: config.nano_cpus,
+        memory: config.memory,
+        pids_limit: config.pids_limit,
+        device_requests: config.device_requests.clone(),
+        binds: config.binds.clone(),
+        mounts: config.mounts.clone(),
+        group_add: config.group_add.clone(),
+        cap_drop: config.cap_drop.clone(),
+        cap_add: config.cap_add.clone(),
+        security_opt: config.security_opt.clone(),
+        network_mode: config.network_mode.clone(),
+        privileged: config.privileged,
+        readonly_rootfs: config.readonly_rootfs,
+        tmpfs: config.tmpfs.clone(),
+        sysctls: config.sysctls.clone(),
+        ..Default::default()
+    }
+}
+
+fn immutable_spec(sandbox: &DriverSandbox) -> Result<DriverSandboxSpec, Status> {
+    let spec = sandbox
+        .spec
+        .as_ref()
+        .ok_or_else(|| refusal("Docker restart spec is missing"))?;
+    let mut template = spec
+        .template
+        .clone()
+        .ok_or_else(|| refusal("Docker restart template is missing"))?;
+    // Workload environment is already materialized in the exact container; it is
+    // not needed to recreate its supervisor and can contain caller secrets.
+    template.environment.clear();
+    Ok(DriverSandboxSpec {
+        log_level: spec.log_level.clone(),
+        template: Some(template),
+        resource_requirements: spec.resource_requirements.clone(),
+        ..Default::default()
+    })
+}
+
+impl RestartState {
+    fn capture(
+        sandbox: &DriverSandbox,
+        inspected: &ContainerInspectResponse,
+        config: &DockerDriverRuntimeConfig,
+    ) -> Result<Self, Status> {
+        let _ = DockerComputeDriver::validated_sandbox(sandbox, config)?;
+        let state = Self {
+            version: 1,
+            sandbox_id: sandbox.id.clone(),
+            sandbox_name: sandbox.name.clone(),
+            workspace: sandbox.workspace.clone(),
+            namespace: config.sandbox_namespace.clone(),
+            supervisor_image: config.supervisor_image_id.clone(),
+            container_id: inspected
+                .id
+                .clone()
+                .ok_or_else(|| refusal("Docker restart container identity is missing"))?,
+            image_id: inspected
+                .image
+                .clone()
+                .ok_or_else(|| refusal("Docker restart image identity is missing"))?,
+            ownership_labels: inspected
+                .config
+                .as_ref()
+                .and_then(|c| c.labels.clone())
+                .ok_or_else(|| refusal("Docker restart ownership labels are missing"))?,
+            host_config: immutable_resources(
+                inspected
+                    .host_config
+                    .as_ref()
+                    .ok_or_else(|| refusal("Docker restart resource configuration is missing"))?,
+            ),
+            spec: immutable_spec(sandbox)?.encode_to_vec(),
+        };
+        state.admit(sandbox, inspected, config)?;
+        Ok(state)
+    }
+
+    fn admit(
+        &self,
+        sandbox: &DriverSandbox,
+        inspected: &ContainerInspectResponse,
+        config: &DockerDriverRuntimeConfig,
+    ) -> Result<DriverSandboxSpec, Status> {
+        if self.version != 1
+            || self.sandbox_id != sandbox.id
+            || self.sandbox_name != sandbox.name
+            || self.workspace != sandbox.workspace
+            || self.namespace != config.sandbox_namespace
+            || self.supervisor_image != config.supervisor_image_id
+            || inspected.id.as_deref() != Some(self.container_id.as_str())
+            || inspected.image.as_deref() != Some(self.image_id.as_str())
+            || inspected.config.as_ref().and_then(|c| c.labels.as_ref())
+                != Some(&self.ownership_labels)
+            || inspected
+                .host_config
+                .as_ref()
+                .map(immutable_resources)
+                .as_ref()
+                != Some(&self.host_config)
+        {
+            return Err(refusal(
+                "Docker restart state does not match the exact owned container, image or resource profile",
+            ));
+        }
+        for (key, expected) in [
+            (LABEL_MANAGED_BY, LABEL_MANAGED_BY_VALUE),
+            (LABEL_SANDBOX_ID, self.sandbox_id.as_str()),
+            (LABEL_SANDBOX_NAME, self.sandbox_name.as_str()),
+            (LABEL_SANDBOX_WORKSPACE, self.workspace.as_str()),
+            (LABEL_SANDBOX_NAMESPACE, self.namespace.as_str()),
+            (LABEL_ISOLATION_BACKEND, LABEL_ISOLATION_BACKEND_OPEN_SHELL),
+            (LABEL_ISOLATION_ROLE, LABEL_ISOLATION_ROLE_SANDBOX),
+        ] {
+            if self.ownership_labels.get(key).map(String::as_str) != Some(expected) {
+                return Err(refusal(
+                    "Docker restart state has incomplete or foreign ownership labels",
+                ));
+            }
+        }
+        let spec = DriverSandboxSpec::decode(self.spec.as_slice())
+            .map_err(|_| refusal("Docker restart typed spec is corrupt"))?;
+        let mut candidate = sandbox.clone();
+        candidate.spec = Some(spec.clone());
+        if immutable_spec(&candidate)? != spec {
+            return Err(refusal(
+                "Docker restart state contains credentials or unsupported mutable spec fields",
+            ));
+        }
+        let _ = DockerComputeDriver::validated_sandbox(&candidate, config)?;
+        validate_docker_outer_fence(inspected)?;
+        Ok(spec)
+    }
+}
+
+pub(super) fn write(
+    sandbox: &DriverSandbox,
+    inspected: &ContainerInspectResponse,
+    config: &DockerDriverRuntimeConfig,
+) -> Result<(), Status> {
+    let state = RestartState::capture(sandbox, inspected, config)?;
+    let bytes = serde_json::to_vec(&state)
+        .map_err(|_| refusal("Docker restart state cannot be encoded"))?;
+    if bytes.len() > MAX_BYTES {
+        return Err(refusal("Docker restart state exceeds its 1 MiB limit"));
+    }
+    let directory = docker_boundary_state_dir(sandbox, config)?;
+    write_bytes(&directory, &bytes)
+}
+
+fn write_bytes(directory: &Path, bytes: &[u8]) -> Result<(), Status> {
+    let mut temporary = tempfile::NamedTempFile::new_in(&directory)
+        .map_err(|_| refusal("Docker restart state private staging failed"))?;
+    temporary
+        .as_file()
+        .set_permissions(std::fs::Permissions::from_mode(0o600))
+        .map_err(|_| refusal("Docker restart state private permissions failed"))?;
+    temporary
+        .write_all(&bytes)
+        .and_then(|()| temporary.as_file().sync_all())
+        .map_err(|_| refusal("Docker restart state write failed"))?;
+    temporary
+        .persist_noclobber(directory.join(FILE))
+        .map_err(|_| {
+            refusal(
+                "Docker restart state already exists or cannot be committed; refusing replacement",
+            )
+        })?;
+    std::fs::File::open(directory)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| refusal("Docker restart state directory sync failed"))?;
+    Ok(())
+}
+
+pub(super) async fn restore(
+    sandbox: &mut DriverSandbox,
+    inspected: &ContainerInspectResponse,
+    config: &DockerDriverRuntimeConfig,
+) -> Result<(), Status> {
+    let path = docker_boundary_state_dir(sandbox, config)?.join(FILE);
+    restore_path(sandbox, inspected, config, &path).await
+}
+
+async fn restore_path(
+    sandbox: &mut DriverSandbox,
+    inspected: &ContainerInspectResponse,
+    config: &DockerDriverRuntimeConfig,
+    path: &Path,
+) -> Result<(), Status> {
+    let metadata = tokio::fs::symlink_metadata(&path).await
+        .map_err(|_| refusal("Docker immutable restart state is missing or unreadable; retained container cannot restart under this profile"))?;
+    if !metadata.is_file()
+        || metadata.permissions().mode() & 0o077 != 0
+        || metadata.uid() != rustix::process::geteuid().as_raw()
+    {
+        return Err(refusal(
+            "Docker restart state is not an owner-only regular file",
+        ));
+    }
+    let file = tokio::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(path)
+        .await
+        .map_err(|_| refusal("Docker restart state cannot be opened"))?;
+    let mut bytes = Vec::new();
+    file.take((MAX_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .await
+        .map_err(|_| refusal("Docker restart state cannot be read"))?;
+    if bytes.len() > MAX_BYTES {
+        return Err(refusal("Docker restart state exceeds its 1 MiB limit"));
+    }
+    let state: RestartState = serde_json::from_slice(&bytes)
+        .map_err(|_| refusal("Docker restart state is corrupt or has an unsupported shape"))?;
+    sandbox.spec = Some(state.admit(sandbox, inspected, config)?);
+    Ok(())
+}
