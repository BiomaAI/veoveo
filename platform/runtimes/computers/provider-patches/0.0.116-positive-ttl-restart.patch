@@ -0,0 +1,184 @@
+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use std::fs;
+use std::os::unix::fs::{MetadataExt, PermissionsExt, symlink};
+
+fn protected_directory() -> tempfile::TempDir {
+    tempfile::Builder::new()
+        .permissions(fs::Permissions::from_mode(0o700))
+        .tempdir()
+        .unwrap()
+}
+
+fn protected_file(path: &Path, content: &str) {
+    fs::write(path, content).unwrap();
+    fs::set_permissions(path, fs::Permissions::from_mode(0o600)).unwrap();
+}
+
+#[test]
+fn retained_bootstrap_rotation_changes_only_the_credential() {
+    let root = protected_directory();
+    let path = root.path().join("sandbox.jwt");
+    let cache = root.path().join("retained-cache");
+    protected_file(&path, "expired.bootstrap.token\n");
+    protected_file(&cache, "warm compiled output");
+    let cache_before = fs::metadata(&cache).unwrap();
+    let token_before = fs::metadata(&path).unwrap();
+    replace_retained_bootstrap_token(&path, "fresh.bootstrap.token").unwrap();
+    assert_eq!(
+        fs::read_to_string(&path).unwrap(),
+        "fresh.bootstrap.token\n"
+    );
+    let token_after = fs::metadata(&path).unwrap();
+    assert_ne!(
+        token_before.ino(),
+        token_after.ino(),
+        "replacement is atomic"
+    );
+    assert_eq!(token_after.mode() & 0o777, 0o600);
+    assert_eq!(token_before.uid(), token_after.uid());
+    assert_eq!(fs::read_to_string(&cache).unwrap(), "warm compiled output");
+    assert_eq!(cache_before.ino(), fs::metadata(&cache).unwrap().ino());
+}
+
+#[test]
+fn retained_bootstrap_rotation_rejects_unsafe_paths_without_changing_targets() {
+    for fault in [
+        "symlink",
+        "hardlink",
+        "public-file",
+        "public-directory",
+        "missing",
+        "directory",
+        "large",
+    ] {
+        let root = protected_directory();
+        let original = root.path().join("original");
+        let path = root.path().join("sandbox.jwt");
+        protected_file(&original, "original.bootstrap.token\n");
+        protected_file(&path, "expired.bootstrap.token\n");
+        match fault {
+            "symlink" => {
+                fs::remove_file(&path).unwrap();
+                symlink(&original, &path).unwrap();
+            }
+            "hardlink" => {
+                fs::remove_file(&path).unwrap();
+                fs::hard_link(&original, &path).unwrap();
+            }
+            "public-file" => fs::set_permissions(&path, fs::Permissions::from_mode(0o644)).unwrap(),
+            "public-directory" => {
+                fs::set_permissions(root.path(), fs::Permissions::from_mode(0o755)).unwrap();
+            }
+            "missing" => fs::remove_file(&path).unwrap(),
+            "directory" => {
+                fs::remove_file(&path).unwrap();
+                fs::create_dir(&path).unwrap();
+            }
+            "large" => fs::write(&path, vec![b'x'; 65538]).unwrap(),
+            _ => unreachable!(),
+        }
+        assert!(
+            replace_retained_bootstrap_token(&path, "fresh.bootstrap.token").is_err(),
+            "{fault}"
+        );
+        assert_eq!(
+            fs::read_to_string(&original).unwrap(),
+            "original.bootstrap.token\n"
+        );
+    }
+}
+
+#[test]
+fn retained_bootstrap_rotation_rejects_malformed_or_oversized_tokens() {
+    let root = protected_directory();
+    let path = root.path().join("sandbox.jwt");
+    protected_file(&path, "expired.bootstrap.token\n");
+    for token in [
+        String::new(),
+        "one-segment".into(),
+        "header.payload.signature\n".into(),
+        format!("header.{}.signature", "x".repeat(65536)),
+    ] {
+        assert!(replace_retained_bootstrap_token(&path, &token).is_err());
+        assert_eq!(
+            fs::read_to_string(&path).unwrap(),
+            "expired.bootstrap.token\n"
+        );
+    }
+}
+
+fn retained_container(path: &Path) -> ContainerInspectResponse {
+    ContainerInspectResponse {
+        config: Some(bollard::models::ContainerConfig {
+            labels: Some(HashMap::from([
+                (LABEL_MANAGED_BY.into(), LABEL_MANAGED_BY_VALUE.into()),
+                (LABEL_SANDBOX_ID.into(), "sandbox-id".into()),
+                (LABEL_SANDBOX_NAME.into(), "sandbox-name".into()),
+                (LABEL_SANDBOX_NAMESPACE.into(), "namespace".into()),
+            ])),
+            ..Default::default()
+        }),
+        state: Some(ContainerState {
+            status: Some(ContainerStateStatusEnum::EXITED),
+            ..Default::default()
+        }),
+        mounts: Some(vec![bollard::models::MountPoint {
+            source: Some(path.to_string_lossy().into_owned()),
+            destination: Some(SANDBOX_TOKEN_MOUNT_PATH.into()),
+            rw: Some(false),
+            ..Default::default()
+        }]),
+        ..Default::default()
+    }
+}
+
+#[test]
+fn retained_bootstrap_rotation_requires_exact_stopped_container_and_mount() {
+    let path = Path::new("/private/tokens/sandbox-id.jwt");
+    let original = retained_container(path);
+    let check = |container: &ContainerInspectResponse| {
+        validate_bootstrap_restart(container, "sandbox-id", "sandbox-name", "namespace", path)
+    };
+    check(&original).unwrap();
+    for label in [
+        LABEL_MANAGED_BY,
+        LABEL_SANDBOX_ID,
+        LABEL_SANDBOX_NAME,
+        LABEL_SANDBOX_NAMESPACE,
+    ] {
+        let mut container = original.clone();
+        container
+            .config
+            .as_mut()
+            .unwrap()
+            .labels
+            .as_mut()
+            .unwrap()
+            .insert(label.into(), "wrong".into());
+        assert!(check(&container).is_err());
+    }
+    for state in [
+        ContainerStateStatusEnum::RUNNING,
+        ContainerStateStatusEnum::PAUSED,
+        ContainerStateStatusEnum::RESTARTING,
+    ] {
+        let mut container = original.clone();
+        container.state.as_mut().unwrap().status = Some(state);
+        assert!(check(&container).is_err());
+    }
+    for fault in ["source", "destination", "writable", "missing"] {
+        let mut container = original.clone();
+        let mount = &mut container.mounts.as_mut().unwrap()[0];
+        match fault {
+            "source" => mount.source = Some("/private/someone-else.jwt".into()),
+            "destination" => mount.destination = Some("/unrelated".into()),
+            "writable" => mount.rw = Some(true),
+            "missing" => container.mounts = None,
+            _ => unreachable!(),
+        }
+        assert!(check(&container).is_err(), "{fault}");
+    }
+}
