+fn validate_bootstrap_restart(
+    inspected: &ContainerInspectResponse,
+    sandbox_id: &str,
+    sandbox_name: &str,
+    namespace: &str,
+    path: &Path,
+) -> Result<(), Status> {
+    let valid_labels = inspected
+        .config
+        .as_ref()
+        .and_then(|config| config.labels.as_ref())
+        .is_some_and(|labels| {
+            [
+                (LABEL_MANAGED_BY, LABEL_MANAGED_BY_VALUE),
+                (LABEL_SANDBOX_ID, sandbox_id),
+                (LABEL_SANDBOX_NAME, sandbox_name),
+                (LABEL_SANDBOX_NAMESPACE, namespace),
+            ]
+            .into_iter()
+            .all(|(key, value)| labels.get(key).is_some_and(|found| found == value))
+        });
+    let stopped = inspected
+        .state
+        .as_ref()
+        .and_then(|state| state.status)
+        .is_some_and(|state| {
+            matches!(
+                state,
+                ContainerStateStatusEnum::CREATED | ContainerStateStatusEnum::EXITED
+            )
+        });
+    let valid_mount = inspected.mounts.as_ref().is_some_and(|mounts| {
+        mounts.iter().any(|mount| {
+            mount.source.as_deref().map(Path::new) == Some(path)
+                && mount.destination.as_deref() == Some(SANDBOX_TOKEN_MOUNT_PATH)
+                && mount.rw == Some(false)
+        })
+    });
+    if sandbox_id.is_empty() || sandbox_name.is_empty() || !valid_labels || !stopped || !valid_mount
+    {
+        return Err(Status::failed_precondition(
+            "retained sandbox bootstrap identity, state or mount differs",
+        ));
+    }
+    Ok(())
+}
+
+/// Replace only a protected, existing bootstrap file. Docker resolves the
+/// original bind source again at start; the container and workspace are kept.
+fn replace_retained_bootstrap_token(path: &Path, token: &str) -> Result<(), Status> {
+    use std::io::Write;
+    use std::os::unix::fs::MetadataExt;
+
+    if token.is_empty()
+        || token.len() > 65536
+        || token.split('.').count() != 3
+        || token.split('.').any(str::is_empty)
+        || !token
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b"-_.".contains(&byte))
+    {
+        return Err(Status::invalid_argument(
+            "invalid retained sandbox bootstrap token",
+        ));
+    }
+    let replace = || -> std::io::Result<()> {
+        let fail = || std::io::Error::other("unsafe retained sandbox bootstrap file");
+        let parent = path.parent().ok_or_else(fail)?;
+        if !path.is_absolute() || path.canonicalize()? != path || parent.canonicalize()? != parent {
+            return Err(fail());
+        }
+        let original = std::fs::symlink_metadata(path)?;
+        let directory = std::fs::symlink_metadata(parent)?;
+        let uid = rustix::process::geteuid().as_raw();
+        if !original.is_file()
+            || original.nlink() != 1
+            || original.uid() != uid
+            || original.mode() & 0o077 != 0
+            || original.len() > 65537
+            || !directory.is_dir()
+            || directory.uid() != uid
+            || directory.mode() & 0o077 != 0
+        {
+            return Err(fail());
+        }
+        let mut replacement = tempfile::NamedTempFile::new_in(parent)?;
+        writeln!(replacement, "{token}")?;
+        replacement.as_file().sync_all()?;
+        let current = std::fs::symlink_metadata(path)?;
+        if current.dev() != original.dev() || current.ino() != original.ino() {
+            return Err(fail());
+        }
+        replacement.persist(path).map_err(|error| error.error)?;
+        std::fs::File::open(parent)?.sync_all()
+    };
+    replace().map_err(|_| {
+        Status::failed_precondition("could not renew protected retained sandbox bootstrap")
+    })
+}
