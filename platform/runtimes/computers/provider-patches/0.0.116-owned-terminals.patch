+/// Re-own only the freshly allocated terminal descriptor, not a path which
+/// sandbox code could replace. Mode 0600 prevents access by an inherited tty
+/// group. Any failure aborts the child before it can execute workload code.
+#[cfg(unix)]
+fn assign_terminal_owner(fd: RawFd, uid: Uid, gid: Gid) -> Result<()> {
+    // Callers retain the freshly allocated slave until child exec.
+    if !nix::unistd::isatty(fd).into_diagnostic()? {
+        return Err(miette::miette!(
+            "child terminal descriptor is not a terminal"
+        ));
+    }
+    // Tighten mode while we still own the descriptor. Chown first would
+    // require CAP_FOWNER for the following chmod, beyond the needed CHOWN.
+    nix::sys::stat::fchmod(
+        fd,
+        nix::sys::stat::Mode::S_IRUSR | nix::sys::stat::Mode::S_IWUSR,
+    )
+    .into_diagnostic()?;
+    nix::unistd::fchown(fd, Some(uid), Some(gid)).into_diagnostic()?;
+    Ok(())
+}
