         .expect("test JSON must convert to a protobuf Struct")
 }
 
+fn bounded_log_config() -> serde_json::Value {
+    serde_json::json!({"log_limits": {
+        "max_file_bytes": 10_485_760,
+        "max_files": 3,
+        "supervisor_tmpfs_bytes": 33_554_432
+    }})
+}
+
+fn sandbox_with_logs(config: serde_json::Value) -> DriverSandbox {
+    let mut sandbox = test_sandbox();
+    let template = sandbox.spec.as_mut().unwrap().template.as_mut().unwrap();
+    template.driver_config = Some(json_struct(config));
+    template.resources = Some(DriverResourceRequirements {
+        memory_limit: "512Mi".to_string(),
+        ..Default::default()
+    });
+    sandbox
+}
+
+#[test]
+fn log_limits_absence_preserves_legacy_container_contract() {
+    let host = build_container_create_body(&test_sandbox(), &runtime_config())
+        .unwrap()
+        .host_config
+        .unwrap();
+    assert!(host.log_config.is_none());
+    assert!(host.mounts.unwrap().is_empty());
+}
+
+#[test]
+fn log_limits_render_exact_rotation_and_protected_tmpfs_with_existing_home() {
+    let mut config = bounded_log_config();
+    config["mounts"] = serde_json::json!([
+        {"type": "volume", "source": "retained-home", "target": "/sandbox/persistent",
+         "read_only": false, "subpath": "home"},
+        {"type": "tmpfs", "target": "/tmp", "size_bytes": 16_777_216, "mode": 1023}
+    ]);
+    let sandbox = sandbox_with_logs(config);
+    DockerComputeDriver::validate_sandbox(&sandbox, &runtime_config()).unwrap();
+    let host = build_container_create_body(&sandbox, &runtime_config())
+        .unwrap()
+        .host_config
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(host.log_config.unwrap()).unwrap(),
+        serde_json::json!({
+            "Type": "json-file", "Config": {
+                "max-size": "10485760", "max-file": "3", "compress": "false",
+                "mode": "non-blocking", "max-buffer-size": "262144"
+            }
+        })
+    );
+    let mounts = host.mounts.unwrap();
+    assert_eq!(mounts.len(), 3);
+    assert_eq!(mounts[0].source.as_deref(), Some("retained-home"));
+    assert_eq!(
+        mounts[0]
+            .volume_options
+            .as_ref()
+            .unwrap()
+            .subpath
+            .as_deref(),
+        Some("home")
+    );
+    assert_eq!(mounts[1].target.as_deref(), Some("/tmp"));
+    let log_mount = serde_json::to_value(&mounts[2]).unwrap();
+    assert_eq!(
+        log_mount,
+        serde_json::json!({
+            "Type": "tmpfs", "Target": "/var/log", "TmpfsOptions": {
+                "SizeBytes": 33_554_432, "Mode": 448, "Options": [["noexec"]]
+            }
+        })
+    );
+    assert!(host.restart_policy.is_none());
+}
+
+#[test]
+fn log_limits_reject_null_partial_unknown_or_non_object_envelopes() {
+    for value in [
+        serde_json::Value::Null,
+        serde_json::json!({}),
+        serde_json::json!([]),
+        serde_json::json!(false),
+        serde_json::json!("default"),
+    ] {
+        let sandbox = sandbox_with_logs(serde_json::json!({"log_limits": value}));
+        assert_eq!(
+            DockerComputeDriver::validate_sandbox(&sandbox, &runtime_config())
+                .unwrap_err()
+                .code(),
+            tonic::Code::InvalidArgument
+        );
+    }
+    for field in ["max_file_bytes", "max_files", "supervisor_tmpfs_bytes"] {
+        let mut config = bounded_log_config();
+        config["log_limits"].as_object_mut().unwrap().remove(field);
+        assert!(
+            DockerComputeDriver::validate_sandbox(&sandbox_with_logs(config), &runtime_config())
+                .is_err()
+        );
+    }
+    for field in ["driver", "options", "path", "env", "labels", "max_size"] {
+        let mut config = bounded_log_config();
+        config["log_limits"][field] = serde_json::json!("override");
+        let err =
+            DockerComputeDriver::validate_sandbox(&sandbox_with_logs(config), &runtime_config())
+                .unwrap_err();
+        assert!(err.message().contains("unknown field"), "{field}: {err}");
+    }
+}
+
+#[test]
+fn log_limits_reject_invalid_numbers_before_provisioning() {
+    for (field, minimum, maximum) in [
+        ("max_file_bytes", 1_048_576_u32, 67_108_864_u32),
+        ("max_files", 1, 10),
+        ("supervisor_tmpfs_bytes", 1_048_576, 67_108_864),
+    ] {
+        for value in [
+            serde_json::Value::Null,
+            serde_json::json!(true),
+            serde_json::json!("1"),
+            serde_json::json!(-1),
+            serde_json::json!(0),
+            serde_json::json!(minimum - 1),
+            serde_json::json!(maximum + 1),
+            serde_json::json!(f64::from(minimum) + 0.5),
+            serde_json::json!(1e100),
+        ] {
+            let mut config = bounded_log_config();
+            config["log_limits"][field] = value.clone();
+            let err = DockerComputeDriver::validate_sandbox(
+                &sandbox_with_logs(config),
+                &runtime_config(),
+            )
+            .unwrap_err();
+            assert_eq!(
+                err.code(),
+                tonic::Code::InvalidArgument,
+                "{field}={value}: {err}"
+            );
+        }
+        for value in [minimum, maximum] {
+            let mut config = bounded_log_config();
+            config["log_limits"][field] = serde_json::json!(value);
+            DockerComputeDriver::validate_sandbox(&sandbox_with_logs(config), &runtime_config())
+                .unwrap();
+        }
+    }
+}
+
+#[test]
+fn log_limits_reject_nonfinite_protobuf_numbers() {
+    for number in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+        let mut sandbox = sandbox_with_logs(bounded_log_config());
+        let config = sandbox
+            .spec
+            .as_mut()
+            .unwrap()
+            .template
+            .as_mut()
+            .unwrap()
+            .driver_config
+            .as_mut()
+            .unwrap();
+        let prost_types::value::Kind::StructValue(limits) = config
+            .fields
+            .get_mut("log_limits")
