diff --git a/crates/openshell-driver-docker/src/log_limits.rs b/crates/openshell-driver-docker/src/log_limits.rs
new file mode 100644
index 0000000..153ec37
--- /dev/null
+++ b/crates/openshell-driver-docker/src/log_limits.rs
@@ -0,0 +1,123 @@
+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Explicit, closed log storage limits for newly created Docker sandboxes.
+
+use bollard::models::{HostConfigLogConfig, Mount, MountTmpfsOptions, MountTypeEnum};
+use openshell_core::driver_mounts;
+use serde::Deserialize;
+use std::collections::HashMap;
+use tonic::Status;
+
+const SUPERVISOR_LOG_PATH: &str = "/var/log";
+const MIB: u32 = 1_048_576;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Deserialize)]
+#[serde(try_from = "LogLimitsInput")]
+pub struct DockerLogLimits {
+    max_file_bytes: i64,
+    max_files: i64,
+    supervisor_tmpfs_bytes: i64,
+}
+
+// Protobuf Struct represents numbers as f64, including integral values.
+// All fields are required; accepting null or a partial object would silently
+// restore an unlimited daemon default at a resource-admission boundary.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct LogLimitsInput {
+    max_file_bytes: f64,
+    max_files: f64,
+    supervisor_tmpfs_bytes: f64,
+}
+
+impl TryFrom<LogLimitsInput> for DockerLogLimits {
+    type Error = String;
+
+    fn try_from(input: LogLimitsInput) -> Result<Self, Self::Error> {
+        Ok(Self {
+            max_file_bytes: bounded_integer(input.max_file_bytes, MIB, 64 * MIB, "max_file_bytes")?,
+            max_files: bounded_integer(input.max_files, 1, 10, "max_files")?,
+            supervisor_tmpfs_bytes: bounded_integer(
+                input.supervisor_tmpfs_bytes,
+                MIB,
+                64 * MIB,
+                "supervisor_tmpfs_bytes",
+            )?,
+        })
+    }
+}
+
+fn bounded_integer(value: f64, minimum: u32, maximum: u32, field: &str) -> Result<i64, String> {
+    if !value.is_finite()
+        || value.fract() != 0.0
+        || value < f64::from(minimum)
+        || value > f64::from(maximum)
+    {
+        return Err(format!(
+            "log_limits.{field} must be an integer from {minimum} through {maximum}"
+        ));
+    }
+    // The integral/range checks above prove an exactly representable u32.
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+    let integer = value as u32;
+    Ok(i64::from(integer))
+}
+
+pub fn deserialize_optional_log_limits<'de, D>(
+    deserializer: D,
+) -> Result<Option<DockerLogLimits>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    DockerLogLimits::deserialize(deserializer).map(Some)
+}
+
+impl DockerLogLimits {
+    pub fn validate_memory(self, memory_bytes: Option<i64>) -> Result<(), Status> {
+        let Some(memory_bytes) = memory_bytes else {
+            return Err(Status::failed_precondition(
+                "docker log_limits require an explicit template memory limit",
+            ));
+        };
+        if self.supervisor_tmpfs_bytes > memory_bytes / 2 {
+            return Err(Status::failed_precondition(
+                "log_limits.supervisor_tmpfs_bytes must not exceed half the template memory limit",
+            ));
+        }
+        Ok(())
+    }
+
+    pub fn validate_path(path: &str) -> Result<(), Status> {
+        driver_mounts::validate_mount_control_path(path, SUPERVISOR_LOG_PATH)
+            .map_err(Status::failed_precondition)
+    }
+
+    pub fn log_config(self) -> HostConfigLogConfig {
+        HostConfigLogConfig {
+            typ: Some("json-file".to_string()),
+            config: Some(HashMap::from([
+                ("max-size".to_string(), self.max_file_bytes.to_string()),
+                ("max-file".to_string(), self.max_files.to_string()),
+                ("compress".to_string(), "false".to_string()),
+                ("mode".to_string(), "non-blocking".to_string()),
+                ("max-buffer-size".to_string(), "262144".to_string()),
+            ])),
+        }
+    }
+
+    pub fn supervisor_mount(self) -> Mount {
+        Mount {
+            typ: Some(MountTypeEnum::TMPFS),
+            target: Some(SUPERVISOR_LOG_PATH.to_string()),
+            tmpfs_options: Some(MountTmpfsOptions {
+                size_bytes: Some(self.supervisor_tmpfs_bytes),
+                mode: Some(0o700),
+                // Docker supplies nodev/nosuid for tmpfs. Its structured API
+                // accepts noexec here, not arbitrary fstab mount options.
+                options: Some(vec![vec!["noexec".to_string()]]),
+            }),
+            ..Default::default()
+        }
+    }
+}
