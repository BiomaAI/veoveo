        "type": "object"
      }
    ],
    "title": "ArtifactProvenance"
  },
  "ArtifactReleaseState": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "enum": [
      "private",
      "releasable",
      "released"
    ],
    "title": "ArtifactReleaseState",
    "type": "string"
  },
