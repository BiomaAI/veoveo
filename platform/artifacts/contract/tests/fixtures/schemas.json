    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Canonical metadata for an artifact managed by a server-owned store.\n\n`artifact_uri` is the protocol identity (`{scheme}://artifact/{artifact_id}`).\n`download_url` is optional bulk-transfer plumbing for large artifacts and\nmust not become a discovery API.",
    "properties": {
      "artifactId": {
        "$ref": "#/$defs/ArtifactId"
      },
      "artifactUri": {
        "$ref": "#/$defs/ArtifactUri"
      },
      "byteLen": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "compliance": {
        "$ref": "#/$defs/ComplianceMetadata",
        "default": {}
      },
      "createdAt": {
        "format": "date-time",
        "type": "string"
      },
      "downloadUrl": {
        "type": [
          "string",
          "null"
        ]
      },
      "filename": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "metadata": {
        "default": null
      },
      "mimeType": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "releaseState": {
        "$ref": "#/$defs/ArtifactReleaseState",
        "default": "private"
      }
    },
    "required": [
      "artifactId",
      "byteLen",
      "artifactUri",
      "createdAt"
    ],
    "title": "ArtifactMetadata",
    "type": "object"
  },
