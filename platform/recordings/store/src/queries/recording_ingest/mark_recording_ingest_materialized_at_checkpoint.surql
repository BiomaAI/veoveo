BEGIN TRANSACTION; LET $updated = (UPDATE ONLY $stream SET materialized_through_sequence = $through, updated_at = $now, revision += 1 WHERE (materialized_through_sequence = NONE OR materialized_through_sequence < $through) AND revision = $revision RETURN AFTER); IF $updated = NONE { THROW 'recording_ingest_checkpoint_conflict'; }; UPDATE recording_ingest_batch SET state = 'materialized', materialized_at = $now WHERE tenant = $tenant AND stream = $stream AND sequence <= $through AND state = 'durable' RETURN NONE; COMMIT TRANSACTION;
