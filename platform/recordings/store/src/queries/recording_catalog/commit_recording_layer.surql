BEGIN TRANSACTION; LET $current = (SELECT * FROM ONLY $layer); IF $current.revision != $revision OR $current.state != 'staged' OR $current.artifact != NONE { THROW 'recording_layer_revision_conflict'; }; UPDATE ONLY $layer SET state = 'committed', artifact = $artifact, staging_path = NONE, failure_reason = NONE, updated_at = time::now(), revision += 1 RETURN NONE; UPDATE ONLY $dataset SET revision += 1, updated_at = time::now() RETURN NONE; COMMIT TRANSACTION;
