-- Immutable manifest publication intent; no backfill or compatibility defaults.
DEFINE TABLE recording_manifest_publication TYPE NORMAL SCHEMAFULL CHANGEFEED 4w2d INCLUDE ORIGINAL PERMISSIONS NONE;

DEFINE FIELD id ON recording_manifest_publication TYPE uuid PERMISSIONS FULL;
DEFINE FIELD version ON recording_manifest_publication TYPE 1 PERMISSIONS FULL;
DEFINE FIELD tenant ON recording_manifest_publication TYPE record<tenant> PERMISSIONS FULL;
DEFINE FIELD actor ON recording_manifest_publication TYPE record<principal> PERMISSIONS FULL;
DEFINE FIELD source_owner ON recording_manifest_publication TYPE record<principal> PERMISSIONS FULL;
DEFINE FIELD source_work_context ON recording_manifest_publication TYPE record<work_context> PERMISSIONS FULL;
DEFINE FIELD recording ON recording_manifest_publication TYPE record<recording> PERMISSIONS FULL;
DEFINE FIELD dataset ON recording_manifest_publication TYPE record<recording_dataset> PERMISSIONS FULL;
DEFINE FIELD dataset_revision ON recording_manifest_publication TYPE int ASSERT $value >= 0 PERMISSIONS FULL;
DEFINE FIELD recording_revision ON recording_manifest_publication TYPE int ASSERT $value >= 0 PERMISSIONS FULL;
DEFINE FIELD sealed_at ON recording_manifest_publication TYPE datetime PERMISSIONS FULL;
DEFINE FIELD descriptor_sha256 ON recording_manifest_publication TYPE string ASSERT $value.len() = 64 PERMISSIONS FULL;
DEFINE FIELD publisher ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD publisher.clientId ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD publisher.profile ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD publisher.protectedResource ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD body.schema ON recording_manifest_publication TYPE 'veoveo.ai/recording-manifest/v10' PERMISSIONS FULL;
DEFINE FIELD body.datasetId ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.recordingSegmentId ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.catalogRevision ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.sealedAt ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.layers ON recording_manifest_publication TYPE array<object> ASSERT $value.len() > 0 PERMISSIONS FULL;
DEFINE FIELD OVERWRITE body.layers.* ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD body.blueprint ON recording_manifest_publication TYPE option<object> PERMISSIONS FULL;
DEFINE FIELD descriptor ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD descriptor.artifactId ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD descriptor.expectedByteLen ON recording_manifest_publication TYPE int ASSERT $value > 0 PERMISSIONS FULL;
DEFINE FIELD descriptor.expectedSha256 ON recording_manifest_publication TYPE string ASSERT $value.len() = 64 PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.mimeType ON recording_manifest_publication TYPE 'application/vnd.veoveo.recording-manifest+json' PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.filename ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.classification ON recording_manifest_publication TYPE none | string PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.dataLabels ON recording_manifest_publication TYPE none | array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE descriptor.artifact.dataLabels.* ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.retentionExpiresAt ON recording_manifest_publication TYPE none | string PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance.kind ON recording_manifest_publication TYPE 'recording_manifest' PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance.recordingId ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance.datasetId ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance.catalogRevision ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance.datasetRevision ON recording_manifest_publication TYPE int ASSERT $value >= 0 PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance.recordingRevision ON recording_manifest_publication TYPE int ASSERT $value >= 0 PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance.sealedAt ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD descriptor.artifact.metadata.provenance.sha256 ON recording_manifest_publication TYPE string ASSERT $value.len() = 64 PERMISSIONS FULL;
DEFINE FIELD body.layers.*.layerId ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.layers.*.layerName ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.layers.*.kind ON recording_manifest_publication TYPE 'capture' | 'properties' | 'derived' PERMISSIONS FULL;
DEFINE FIELD body.layers.*.ordinal ON recording_manifest_publication TYPE null | int PERMISSIONS FULL;
DEFINE FIELD body.layers.*.byteLen ON recording_manifest_publication TYPE int ASSERT $value > 0 PERMISSIONS FULL;
DEFINE FIELD body.layers.*.sha256 ON recording_manifest_publication TYPE string ASSERT $value.len() = 64 PERMISSIONS FULL;
DEFINE FIELD body.layers.*.artifactUri ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.layers.*.rrdVersion ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.layers.*.schemaDigest ON recording_manifest_publication TYPE string ASSERT $value.len() = 64 PERMISSIONS FULL;
DEFINE FIELD body.blueprint.blueprintId ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD body.blueprint.revision ON recording_manifest_publication TYPE int ASSERT $value > 0 PERMISSIONS FULL;
DEFINE FIELD body.blueprint.byteLen ON recording_manifest_publication TYPE int ASSERT $value > 0 PERMISSIONS FULL;
DEFINE FIELD body.blueprint.messageCount ON recording_manifest_publication TYPE int ASSERT $value > 0 PERMISSIONS FULL;
DEFINE FIELD body.blueprint.sha256 ON recording_manifest_publication TYPE string ASSERT $value.len() = 64 PERMISSIONS FULL;
DEFINE FIELD body.blueprint.artifactUri ON recording_manifest_publication TYPE string PERMISSIONS FULL;

DEFINE FIELD OVERWRITE authority ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.classification ON recording_manifest_publication TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.context_key ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.data_labels ON recording_manifest_publication TYPE array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.data_labels.* ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.delegation_id ON recording_manifest_publication TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.initial_grants ON recording_manifest_publication TYPE array<object> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.initial_grants.* ON recording_manifest_publication TYPE object PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.initial_grants.*.permission ON recording_manifest_publication TYPE 'read' | 'write' | 'admin' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.initial_grants.*.subject_key ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.initial_grants.*.subject_kind ON recording_manifest_publication TYPE 'principal' | 'group' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.initiator_key ON recording_manifest_publication TYPE none | string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.invocation_mode ON recording_manifest_publication TYPE 'direct' | 'delegated' | 'automated' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.membership ON recording_manifest_publication TYPE 'viewer' | 'contributor' | 'custodian' | 'owner' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.owner_key ON recording_manifest_publication TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.owner_kind ON recording_manifest_publication TYPE 'principal' | 'group' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE authority.policy_revision ON recording_manifest_publication TYPE string PERMISSIONS FULL;

DEFINE INDEX recording_manifest_publication_recording_unique ON recording_manifest_publication FIELDS tenant, recording UNIQUE;

-- The existing properties row journals the checked original RRD JSON preimage.
DEFINE FIELD properties_preparation ON recording_layer TYPE option<object> ASSERT IF $this.kind = 'properties' { $value != NONE } ELSE { $value == NONE } PERMISSIONS FULL;
DEFINE FIELD properties_preparation.version ON recording_layer TYPE 1 PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body ON recording_layer TYPE object PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.dataset_id ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.recording_id ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.dataset_key ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.producer_recording_key ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.lifecycle_state ON recording_layer TYPE 'sealed' PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.started_at ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.ended_at ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.sealed_at ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.source_revision ON recording_layer TYPE int PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.immutable_manifest_digest ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.model_revisions ON recording_layer TYPE option<object> PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.model_revisions.* ON recording_layer TYPE string PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.environment_revisions ON recording_layer TYPE option<object> PERMISSIONS FULL;
DEFINE FIELD properties_preparation.body.environment_revisions.* ON recording_layer TYPE string PERMISSIONS FULL;
