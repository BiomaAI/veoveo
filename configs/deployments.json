{
  "profiles": [
    {
      "id": "kubernetes-connected",
      "installationScope": "one_enterprise",
      "connectivity": "connected",
      "tenantModel": {
        "kind": "internal_tenants",
        "tenantKeysAreInstallationLocal": true,
        "crossTenantAccessDeniedByDefault": true
      },
      "platformStore": {
        "engine": "surreal_db",
        "version": "3.3.0",
        "storageEngine": "rocks_db",
        "topology": "single_node",
        "databaseHa": "out_of_scope",
        "durableVolumeRequired": true,
        "changefeedSourceOfTruth": "native_changefeed",
        "liveQueries": "changefeed_wake",
        "endpoint": "ws://veoveo-surrealdb:8000"
      },
      "objectStore": {
        "kind": "external_s3_compatible",
        "endpoint": "https://s3.enterprise.example",
        "bucket": "veoveo-artifacts",
        "serverSideEncryptionRequired": true,
        "customerManagedKeysSupported": true
      },
      "analyticalRuntime": {
        "engine": "duck_db",
        "purpose": "isolated_analytical_workspace",
        "arbitrarySql": true,
        "ownerScopedWorkspaces": true,
        "durablePlatformState": false,
        "externalDataAccess": "governed_ingest_artifact_or_attach",
        "containerSandboxRequired": true
      },
      "ingress": {
        "kind": "kubernetes_ingress",
        "publicBaseUrl": "https://veoveo.enterprise.example",
        "tlsTerminated": true
      },
      "identityProvider": {
        "kind": "external_oidc",
        "issuer": "https://idp.enterprise.example",
        "discoveryAvailableOffline": false
      },
      "secretManager": {
        "kind": "kubernetes_existing_secret",
        "existingSecretName": "veoveo-installation-secrets",
        "rotationOwnedByOperator": true
      },
      "serviceToService": {
        "gatewayIdentity": "gateway_signed_ed25519_jwt",
        "transport": "service_mesh_mtls"
      },
      "telemetry": {
        "collector": "open_telemetry_collector",
        "endpoint": "http://veoveo-otel-collector:4318",
        "signals": [
          "logs",
          "traces",
          "metrics",
          "audit_events"
        ],
        "siemExportSupported": true
      },
      "services": [
        "gateway",
        "console_bff",
        "console",
        "artifact_service",
        "artifact_mcp",
        "recording_hub",
        "recording_mcp",
        "hosted_mcp_server",
        "platform_store",
        "object_store",
        "telemetry_collector"
      ],
      "retention": {
        "taskMetadataDays": 90,
        "artifactMetadataDays": 90,
        "artifactBytesDays": 90,
        "usageAnalyticsDays": 365,
        "auditDays": 365
      }
    },
    {
      "id": "kubernetes-offline",
      "installationScope": "one_enterprise",
      "connectivity": "offline",
      "tenantModel": {
        "kind": "internal_tenants",
        "tenantKeysAreInstallationLocal": true,
        "crossTenantAccessDeniedByDefault": true
      },
      "platformStore": {
        "engine": "surreal_db",
        "version": "3.3.0",
        "storageEngine": "rocks_db",
        "topology": "single_node",
        "databaseHa": "out_of_scope",
        "durableVolumeRequired": true,
        "changefeedSourceOfTruth": "native_changefeed",
        "liveQueries": "changefeed_wake",
        "endpoint": "ws://veoveo-surrealdb:8000"
      },
      "objectStore": {
        "kind": "rust_fs",
        "endpoint": "http://veoveo-rustfs:9000",
        "bucket": "artifact-plane",
        "serverSideEncryptionRequired": false,
        "customerManagedKeysSupported": false
      },
      "analyticalRuntime": {
        "engine": "duck_db",
        "purpose": "isolated_analytical_workspace",
        "arbitrarySql": true,
        "ownerScopedWorkspaces": true,
        "durablePlatformState": false,
        "externalDataAccess": "governed_ingest_artifact_or_attach",
        "containerSandboxRequired": true
      },
      "ingress": {
        "kind": "kubernetes_ingress",
        "publicBaseUrl": "https://veoveo.airgap.example",
        "tlsTerminated": true
      },
      "identityProvider": {
        "kind": "external_oidc",
        "issuer": "https://idp.airgap.example",
        "discoveryAvailableOffline": true
      },
      "secretManager": {
        "kind": "kubernetes_existing_secret",
        "existingSecretName": "veoveo-installation-secrets",
        "rotationOwnedByOperator": true
      },
      "serviceToService": {
        "gatewayIdentity": "gateway_signed_ed25519_jwt",
        "transport": "service_mesh_mtls"
      },
      "telemetry": {
        "collector": "open_telemetry_collector",
        "endpoint": "http://veoveo-otel-collector:4318",
        "signals": [
          "logs",
          "traces",
          "metrics",
          "audit_events"
        ],
        "siemExportSupported": true
      },
      "services": [
        "gateway",
        "console_bff",
        "console",
        "artifact_service",
        "artifact_mcp",
        "recording_hub",
        "recording_mcp",
        "hosted_mcp_server",
        "platform_store",
        "object_store",
        "telemetry_collector"
      ],
      "retention": {
        "taskMetadataDays": 90,
        "artifactMetadataDays": 90,
        "artifactBytesDays": 90,
        "usageAnalyticsDays": 365,
        "auditDays": 365
      }
    }
  ]
}
