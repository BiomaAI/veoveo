diff --git a/tests/src/LoggerSinkTests.cpp b/tests/src/LoggerSinkTests.cpp
new file mode 100644
index 0000000..8627491
--- /dev/null
+++ b/tests/src/LoggerSinkTests.cpp
@@ -0,0 +1,31 @@
+#include "cesium/omniverse/LoggerSink.h"
+
+#include <doctest/doctest.h>
+
+namespace cesium::omniverse::tests {
+
+TEST_SUITE("Logger sink") {
+    TEST_CASE("sensitive URL query values are redacted") {
+        const std::string message =
+            "request https://example.invalid/tile.glb?key=secret-key&session=secret-session&safe=value failed";
+        const std::string redacted = redactSensitiveUrlQuery(message);
+
+        CHECK(redacted.find("secret-key") == std::string::npos);
+        CHECK(redacted.find("secret-session") == std::string::npos);
+        CHECK(redacted.find("key=[REDACTED]") != std::string::npos);
+        CHECK(redacted.find("session=[REDACTED]") != std::string::npos);
+        CHECK(redacted.find("safe=value") != std::string::npos);
+    }
+
+    TEST_CASE("query names are matched case-insensitively") {
+        const std::string redacted = redactSensitiveUrlQuery(
+            "https://example.invalid/root.json?ACCESS_TOKEN=one&TOKEN=two");
+
+        CHECK(redacted.find("one") == std::string::npos);
+        CHECK(redacted.find("two") == std::string::npos);
+        CHECK(redacted.find("ACCESS_TOKEN=[REDACTED]") != std::string::npos);
+        CHECK(redacted.find("TOKEN=[REDACTED]") != std::string::npos);
+    }
+}
+
+} // namespace cesium::omniverse::tests
