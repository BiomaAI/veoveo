--- a/src/core/src/LoggerSink.cpp
+++ b/src/core/src/LoggerSink.cpp
@@ -1,7 +1,72 @@
 #include "cesium/omniverse/LoggerSink.h"
 
+#include <array>
+#include <cctype>
+#include <string_view>
+
 namespace cesium::omniverse {
 
+namespace {
+
+bool isSensitiveQueryName(std::string_view name) {
+    constexpr std::array<std::string_view, 4> sensitiveNames{{
+        "access_token",
+        "key",
+        "session",
+        "token",
+    }};
+    for (const std::string_view sensitiveName : sensitiveNames) {
+        if (name.size() != sensitiveName.size()) {
+            continue;
+        }
+        bool matches = true;
+        for (size_t i = 0; i < name.size(); ++i) {
+            if (static_cast<char>(std::tolower(static_cast<unsigned char>(name[i]))) != sensitiveName[i]) {
+                matches = false;
+                break;
+            }
+        }
+        if (matches) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace
+
+std::string redactSensitiveUrlQuery(std::string message) {
+    size_t delimiter = message.find('?');
+    while (delimiter != std::string::npos) {
+        size_t nameStart = delimiter + 1;
+        while (nameStart < message.size()) {
+            const size_t equals = message.find('=', nameStart);
+            if (equals == std::string::npos) {
+                break;
+            }
+            const size_t nameEnd = message.find_first_of("& #\t\r\n\"'", nameStart);
+            if (nameEnd != std::string::npos && nameEnd < equals) {
+                break;
+            }
+            size_t valueEnd = message.find_first_of("& #\t\r\n\"'", equals + 1);
+            if (valueEnd == std::string::npos) {
+                valueEnd = message.size();
+            }
+            if (isSensitiveQueryName(std::string_view(message).substr(nameStart, equals - nameStart))) {
+                constexpr std::string_view replacement = "[REDACTED]";
+                message.replace(equals + 1, valueEnd - equals - 1, replacement);
+                valueEnd = equals + 1 + replacement.size();
+            }
+            if (valueEnd >= message.size() || message[valueEnd] != '&') {
+                break;
+            }
+            nameStart = valueEnd + 1;
+        }
+        delimiter = message.find('?', delimiter + 1);
+    }
+    return message;
+}
+
 LoggerSink::LoggerSink(omni::log::Level logLevel)
     : _logLevel(logLevel) {
     switch (logLevel) {
@@ -61,6 +126,6 @@ std::string LoggerSink::formatMessage(const spdlog::details::log_msg& msg) {
 
     spdlog::memory_buf_t formatted;
     formatter_->format(msg, formatted);
-    return fmt::to_string(formatted);
+    return redactSensitiveUrlQuery(fmt::to_string(formatted));
 }
 } // namespace cesium::omniverse
