{
  "agent": {
    "tenant": "${VEOVEO_AGENT_TENANT}",
    "id": "${VEOVEO_AGENT_ID}",
    "displayName": "${VEOVEO_AGENT_NAME}"
  },
  "model": {
    "baseUrl": "${VEOVEO_AGENT_MODEL_URL}",
    "apiKeyEnv": "VEOVEO_MANAGED_MODEL_KEY",
    "model": "${VEOVEO_AGENT_MODEL_ID}",
    "temperature": 0.1,
    "maxOutputTokens": 4096
  },
  "gateway": {
    "url": "${VEOVEO_GATEWAY_URL}",
    "transportUrl": "${VEOVEO_GATEWAY_TRANSPORT_URL}",
    "profile": "${VEOVEO_AGENT_PROFILE}",
    "clientId": "${VEOVEO_AGENT_CLIENT_ID}",
    "workContext": "${VEOVEO_AGENT_WORK_CONTEXT}",
    "audience": "${VEOVEO_GATEWAY_AUDIENCE}",
    "resource": "${VEOVEO_GATEWAY_RESOURCE}",
    "scopes": [
      "map:dataset:read",
      "map:route",
      "operator:use",
      "time:read",
      "uav-sim:control"
    ],
    "privateKeyEnv": "VEOVEO_MANAGED_PRIVATE_KEY",
    "privateKeyKid": "${VEOVEO_AGENT_KEY_ID}"
  },
  "episode": {
    "maxTurns": 16,
    "requestTimeoutS": 300,
    "taskDeadlineS": 900
  },
  "memory": {
    "memoryWriteTables": [
      "mission_intents",
      "resource_bookmarks"
    ]
  },
  "context": {
    "maxContextTokens": 24000,
    "sections": [
      {
        "name": "Simulation session; current control grants select the vehicle",
        "priority": 0,
        "sql": "SELECT '${VEOVEO_PARAM_SESSION}' AS requested_session"
      },
      {
        "name": "Open mission intents",
        "priority": 1,
        "sql": "SELECT mission_key, operator_request, state, map_route_uri, map_route_digest_sha256, uav_plan_uri, updated_at FROM mission_intents WHERE state NOT IN ('completed', 'cancelled', 'failed') ORDER BY updated_at DESC LIMIT 12"
      },
      {
        "name": "Canonical resources",
        "priority": 2,
        "sql": "SELECT name, uri, revision, digest_sha256, updated_at FROM resource_bookmarks ORDER BY name LIMIT 20"
      },
      {
        "name": "Recent episodes",
        "priority": 3,
        "sql": "SELECT seq, summary FROM agent_memory.episode_log ORDER BY seq DESC LIMIT 8"
      }
    ]
  },
  "budgets": {
    "perEpisode": {
      "maxCompletionCalls": 32,
      "maxToolCalls": 24
    },
    "hourlyMaxEpisodes": 120
  },
  "schedule": {
    "heartbeatIntervalS": 300,
    "minWakeIntervalS": 2,
    "wakeCoalesceWindowMs": 250,
    "inputGraceS": 30
  },
  "resourceSubscriptions": [],
  "migrationsDir": "migrations",
  "preamble": "Execute the admitted managed-agent revision under current gateway and domain authority."
}
