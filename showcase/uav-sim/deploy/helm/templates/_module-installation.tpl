{{- define "uav-sim.modulePlan" -}}
{{- $raw := required "enabled UAV MCP requires moduleInstallation.planJson generated by gateway module-plan" .Values.moduleInstallation.planJson -}}
{{- $plan := mustFromJson $raw -}}
{{- if ne $plan.format "veoveo.ai/module-plan/v1" }}{{ fail "unsupported UAV module plan format" }}{{ end -}}
{{- if not (regexMatch "^sha256:[a-f0-9]{64}$" $plan.composition) }}{{ fail "UAV module plan requires a composition digest" }}{{ end -}}
{{- if not (regexMatch "^[1-9][0-9]*$" $plan.generation) }}{{ fail "UAV module plan requires a positive decimal-string generation" }}{{ end -}}
{{- if not $plan.credentialRevision }}{{ fail "UAV module plan requires a credential revision" }}{{ end -}}
{{- $selected := false -}}
{{- range $plan.lanes }}{{- if eq .module "uav" }}{{- $selected = true -}}{{- end }}{{- end -}}
{{- if not (and $selected (has "uav" $plan.enabled)) }}{{ fail "enabled UAV MCP requires the selected uav module lane" }}{{ end -}}
{{- toJson $plan -}}
{{- end -}}

{{- define "uav-sim.modulePlanName" -}}
{{- printf "%s-uav-module-plan-%s" (.Release.Name | trunc 20 | trimSuffix "-") (.Values.moduleInstallation.planJson | sha256sum | trunc 16) -}}
{{- end -}}

{{- define "uav-sim.modulePlanEnv" -}}
{{- $plan := include "uav-sim.modulePlan" . | fromJson -}}
- name: VEOVEO_MODULE_PLAN
  value: /etc/veoveo/modules/plan.json
- name: VEOVEO_MODULE_COMPOSITION
  value: {{ $plan.composition | quote }}
- name: VEOVEO_INSTALLATION_GENERATION
  value: {{ $plan.generation | quote }}
- name: VEOVEO_CREDENTIAL_REVISION
  value: {{ $plan.credentialRevision | quote }}
- name: VEOVEO_SURREAL_RUNTIME_USERNAME
  valueFrom:
    secretKeyRef: {name: {{ .Values.platform.surrealRuntimeSecret }}, key: username}
{{- end -}}
