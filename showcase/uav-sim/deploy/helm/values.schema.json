{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "images",
    "platform",
    "recordingForwarder",
    "recording",
    "world",
    "cache",
    "session",
    "posePublication",
    "streamPublication",
    "interactive",
    "service",
    "resources",
    "scheduling",
    "networkPolicy"
  ],
  "properties": {
    "veoveo-extension": {
      "type": "object"
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "veoveoRegistry", "veoveoTag", "imagePullSecrets"],
      "properties": {
        "production": {"type": "boolean"},
        "veoveoRegistry": {"type": "string"},
        "veoveoTag": {"type": "string"},
        "imageDigests": {
          "type": "object",
          "propertyNames": {"pattern": "^veoveo/[a-z0-9][a-z0-9-]*$"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {"name": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pullPolicy", "runtime", "mcp", "forwarder"],
      "properties": {
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "runtime": {"$ref": "#/definitions/image"},
        "mcp": {"$ref": "#/definitions/image"},
        "forwarder": {"$ref": "#/definitions/image"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "publicBaseUrl",
        "installationSecret",
        "cesiumSecret",
        "cesiumTokenKey",
        "surrealService",
        "surrealNamespace",
        "surrealDatabase",
        "surrealRuntimeSecret",
        "recordingTenantKey"
      ],
      "properties": {
        "installationId": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "publicBaseUrl": {"type": "string", "pattern": "^https?://"},
        "installationSecret": {"type": "string", "minLength": 1},
        "cesiumSecret": {"type": "string", "minLength": 1},
        "cesiumTokenKey": {"const": "cesium-ion-access-token"},
        "surrealService": {"type": "string", "minLength": 1},
        "surrealNamespace": {"type": "string", "minLength": 1},
        "surrealDatabase": {"type": "string", "minLength": 1},
        "surrealRuntimeSecret": {"type": "string", "minLength": 1},
        "recordingTenantKey": {"type": "string", "minLength": 1}
      }
    },
    "recordingForwarder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gatewayTransportUrl",
        "clientId",
        "keyId",
        "signingAlgorithm",
        "privateKey",
        "maximumQueueBytes",
        "batchMessageLimit",
        "batchFlushMilliseconds",
        "grpcMemoryLimitBytes",
        "persistence",
        "resources"
      ],
      "properties": {
        "gatewayTransportUrl": {"type": "string", "pattern": "^https?://[A-Za-z0-9._:-]+/?$"},
        "clientId": {"type": "string", "minLength": 1},
        "keyId": {"type": "string", "minLength": 1},
        "signingAlgorithm": {"enum": ["rs256", "es256", "ed-dsa"]},
        "privateKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "maximumQueueBytes": {"type": "integer", "minimum": 8388608},
        "batchMessageLimit": {"type": "integer", "minimum": 1, "maximum": 65536},
        "batchFlushMilliseconds": {"type": "integer", "minimum": 1, "maximum": 60000},
        "grpcMemoryLimitBytes": {"type": "integer", "minimum": 8388608},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "storageClass", "accessMode"],
          "properties": {
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"},
            "storageClass": {"type": "string"},
            "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telemetryHz", "queueCapacity", "mapProvider"],
      "properties": {
        "telemetryHz": {"type": "integer", "minimum": 1, "maximum": 120},
        "queueCapacity": {"type": "integer", "minimum": 16, "maximum": 65536},
        "mapProvider": {"enum": ["openStreetMap", "mapboxSatellite"]}
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "cesiumIonAssetId"],
      "properties": {
        "source": {"const": "google_photorealistic_3d_tiles"},
        "cesiumIonAssetId": {"const": 2275207}
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "version", "size", "storageClass", "accessMode"],
      "properties": {
        "policy": {"enum": ["ephemeral", "persistent"]},
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"
        },
        "storageClass": {"type": "string"},
        "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vehicleCount",
        "physicsHz",
        "renderingHz",
        "tileReadyFrames",
        "px4ConnectTimeoutSeconds",
        "privacyConsent",
        "fleetLoop",
        "camera"
      ],
      "properties": {
        "id": {"$ref": "#/definitions/identity"},
        "vehicleCount": {"type": "integer", "minimum": 1, "maximum": 16},
        "physicsHz": {"type": "integer", "minimum": 30, "maximum": 1000},
        "renderingHz": {"type": "integer", "minimum": 1, "maximum": 120},
        "tileReadyFrames": {"type": "integer", "minimum": 1, "maximum": 600},
        "px4ConnectTimeoutSeconds": {"type": "number", "minimum": 30, "maximum": 600},
        "privacyConsent": {"type": "boolean"},
        "fleetLoop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relativeAltitudeM",
            "verticalSeparationM",
            "takeoffTimeoutSeconds",
            "centerEastM",
            "centerNorthM",
            "eastRadiusM",
            "northRadiusM",
            "radialSeparationM",
            "waypointCount",
            "speedMps",
            "holdSeconds"
          ],
          "properties": {
            "relativeAltitudeM": {"type": "number", "minimum": 1, "maximum": 500},
            "verticalSeparationM": {"type": "number", "minimum": 0, "maximum": 100},
            "takeoffTimeoutSeconds": {"type": "number", "minimum": 30, "maximum": 1800},
            "centerEastM": {"type": "number", "minimum": -100000, "maximum": 100000},
            "centerNorthM": {"type": "number", "minimum": -100000, "maximum": 100000},
            "eastRadiusM": {"type": "number", "minimum": 10, "maximum": 100000},
            "northRadiusM": {"type": "number", "minimum": 10, "maximum": 100000},
            "radialSeparationM": {"type": "number", "minimum": 0, "maximum": 1000},
            "waypointCount": {"type": "integer", "minimum": 4, "maximum": 256},
            "speedMps": {"type": "number", "minimum": 0.1, "maximum": 100},
            "holdSeconds": {"type": "number", "minimum": 0, "maximum": 3600}
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vehicleId", "width", "height", "fps", "bitRateBps", "optics", "mount"],
          "properties": {
            "vehicleId": {"$ref": "#/definitions/identity"},
            "width": {"type": "integer", "minimum": 64, "maximum": 3840},
            "height": {"type": "integer", "minimum": 64, "maximum": 2160},
            "fps": {"type": "integer", "minimum": 1, "maximum": 60},
            "bitRateBps": {"type": "integer", "minimum": 100000, "maximum": 50000000},
            "optics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["focalLengthMm", "clippingRangeM"],
              "properties": {
                "focalLengthMm": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 1000
                },
                "clippingRangeM": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["near", "far"],
                  "properties": {
                    "near": {"type": "number", "minimum": 0.001, "maximum": 10000},
                    "far": {"type": "number", "minimum": 0.01, "maximum": 10000000}
                  }
                }
              }
            },
            "mount": {
              "type": "object",
              "additionalProperties": false,
              "required": ["translationM", "orientationWxyz"],
              "properties": {
                "translationM": {"$ref": "#/definitions/vector3"},
                "orientationWxyz": {"$ref": "#/definitions/quaternion"}
              }
            }
          }
        }
      }
    },
    "posePublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cadenceHz",
        "bufferDurationMs",
        "producerId",
        "producerSpiffeId",
        "epochId",
        "endpointHost",
        "endpointPort",
        "serverHostname",
        "entityTableRevision",
        "existingTlsSecret",
        "caCertificateKey",
        "clientCertificateKey",
        "clientPrivateKeyKey"
      ],
      "properties": {
        "cadenceHz": {"type": "integer", "minimum": 1, "maximum": 120},
        "bufferDurationMs": {"type": "integer", "minimum": 50, "maximum": 5000},
        "producerId": {"$ref": "#/definitions/identity"},
        "producerSpiffeId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 512,
          "pattern": "^spiffe://[^/\\s][^\\s]*$"
        },
        "epochId": {"$ref": "#/definitions/identity"},
        "endpointHost": {"$ref": "#/definitions/dnsNameOrIp"},
        "endpointPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "serverHostname": {"$ref": "#/definitions/dnsNameOrIp"},
        "entityTableRevision": {"type": "integer", "minimum": 1},
        "existingTlsSecret": {"type": "string", "minLength": 1},
        "caCertificateKey": {"type": "string", "minLength": 1},
        "clientCertificateKey": {"type": "string", "minLength": 1},
        "clientPrivateKeyKey": {"type": "string", "minLength": 1}
      }
    },
    "streamPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "endpointHost",
        "endpointPort",
        "payloadType",
        "sourceVehicleId"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "endpointHost": {"$ref": "#/definitions/dnsNameOrIp"},
        "endpointPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "payloadType": {"type": "integer", "minimum": 96, "maximum": 127},
        "sourceVehicleId": {"$ref": "#/definitions/identity"}
      }
    },
    "interactive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "progressDeadlineSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "progressDeadlineSeconds": {"type": "integer", "minimum": 600, "maximum": 3600}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {"port": {"const": 8802}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "mcp"],
      "properties": {
        "runtime": {"type": "object"},
        "mcp": {"type": "object"}
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeClassName", "nodeSelector", "tolerations", "affinity"],
      "properties": {
        "runtimeClassName": {"type": "string", "minLength": 1},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "affinity": {"type": "object"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "dnsNamespaceSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "dnsNamespaceSelector": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  },
  "definitions": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "dnsNameOrIp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number", "minimum": -100, "maximum": 100},
        "y": {"type": "number", "minimum": -100, "maximum": 100},
        "z": {"type": "number", "minimum": -100, "maximum": 100}
      }
    },
    "quaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "x", "y", "z"],
      "properties": {
        "w": {"type": "number", "minimum": -1, "maximum": 1},
        "x": {"type": "number", "minimum": -1, "maximum": 1},
        "y": {"type": "number", "minimum": -1, "maximum": 1},
        "z": {"type": "number", "minimum": -1, "maximum": 1}
      }
    }
  }
}
