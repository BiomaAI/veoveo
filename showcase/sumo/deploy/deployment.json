{
  "schemaVersion": "veoveo.io/deployment/v2",
  "name": "sumo",
  "registry": {
    "address": "k3d-veoveo-registry.localhost:5001",
    "localConfig": "../../../deploy/local/k3d/registry.json"
  },
  "sources": [
    {
      "name": "veoveo",
      "role": "platform",
      "repository": {
        "kind": "local",
        "path": "../../.."
      },
      "revision": "HEAD",
      "imageGroups": [
        "showcase-sumo-base",
        "platform-core",
        "showcase-sumo"
      ],
      "releases": [
        {
          "name": "veoveo",
          "chart": "deploy/helm/veoveo",
          "values": [
            "deploy/local/k3d/values.yaml",
            "showcase/sumo/deploy/platform-values.yaml"
          ],
          "valuesContract": "platform",
          "createNamespace": true,
          "timeoutSeconds": 720
        },
        {
          "name": "sumo",
          "chart": "showcase/sumo/deploy/helm",
          "values": [],
          "valuesContract": "veoveo-source",
          "createNamespace": false,
          "timeoutSeconds": 720
        }
      ]
    }
  ],
  "kubernetes": {
    "context": "k3d-veoveo-sumo",
    "localCluster": {
      "name": "veoveo-sumo",
      "config": "../../../deploy/local/k3d/cluster.yaml",
      "nodeBootstrapManifests": [
        "../../../deploy/local/k3d/node/nvidia-device-plugin.yaml"
      ]
    }
  },
  "namespace": "veoveo",
  "resources": {
    "manifests": [
      "../../../deploy/local/k3d/development-resources.yaml"
    ],
    "configMaps": [
      {
        "name": "veoveo-gateway-control-plane",
        "files": {
          "gateway.json": "gateway.json",
          "jwks.json": "jwks.json"
        }
      }
    ],
    "secrets": []
  },
  "platform": {
    "installationPreset": "custom",
    "components": [
      "gateway",
      "platform-store",
      "object-store",
      "artifact-service",
      "recording-data-plane",
      "console",
      "telemetry",
      "ingress"
    ],
    "mcpServers": [
      "recording"
    ],
    "artifactAudiences": [
      "artifact",
      "media",
      "timeseries",
      "optimization",
      "duckdb",
      "frames",
      "map",
      "recording",
      "stream",
      "reason",
      "datasheet"
    ],
    "externalWorkloads": [
      "sumo-simulator"
    ],
    "gpuScheduling": null
  },
  "gatewayRequirements": [],
  "waitForDeployments": []
}
