BEGIN TRANSACTION; LET $updated = (UPDATE ONLY $task SET status = 'waiting', request = $request, updated_at = $now WHERE updated_at = $expected_updated_at AND request = $expected_request AND owner_context = $expected_owner_context AND status IN ['queued', 'running', 'waiting'] AND server = $server AND tenant = $tenant AND owner = $owner AND lease_owner = $worker AND lease_expires_at > $now RETURN AFTER); IF $updated = NONE { THROW 'task input transition conflict'; }; CREATE ONLY $input CONTENT $content RETURN NONE; COMMIT TRANSACTION;