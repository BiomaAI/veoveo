BEGIN TRANSACTION; LET $updated = (UPDATE ONLY $input SET response = $response, responded_at = $now WHERE task = $task AND response = NONE RETURN AFTER); IF $updated != NONE { LET $task_updated = (UPDATE ONLY $task SET updated_at = $now WHERE request = $expected_request AND owner_context = $expected_owner_context AND server = $server AND status IN ['queued', 'running', 'waiting'] AND server = $server AND tenant = $tenant AND owner = $owner
    AND profile = $profile AND owner_context.principal_key = $principal_key
    AND owner_context.profile = $profile_key
    AND (owner_context.tenant_key ?? NONE) = $tenant_key
    AND owner_context.data_labels ALLINSIDE $labels AND task_type IN $task_types RETURN AFTER); IF $task_updated = NONE { THROW 'task cannot accept input'; }; }; RETURN $updated; COMMIT TRANSACTION;