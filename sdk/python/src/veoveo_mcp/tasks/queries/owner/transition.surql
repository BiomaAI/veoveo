BEGIN TRANSACTION; LET $updated = (UPDATE ONLY $task SET status = $next, request = $request, progress = $progress, result = $result, result_uri = $result_uri, error = $error, cancel_requested_at = $cancel_requested_at, completed_at = $completed_at, lease_owner = IF $terminal { NONE } ELSE { lease_owner }, lease_expires_at = IF $terminal { NONE } ELSE { lease_expires_at }, updated_at = $now WHERE status = $expected AND updated_at = $expected_updated_at AND request = $expected_request AND owner_context = $expected_owner_context AND server = $server AND tenant = $tenant AND owner = $owner AND ($control_transition OR (lease_owner = $worker AND lease_expires_at > $now) OR ($expired_cancellation AND (lease_expires_at = NONE OR lease_expires_at <= $now))) AND server = $server AND tenant = $tenant AND owner = $owner
    AND profile = $profile AND owner_context.principal_key = $principal_key
    AND owner_context.profile = $profile_key
    AND (owner_context.tenant_key ?? NONE) = $tenant_key
    AND owner_context.data_labels ALLINSIDE $labels RETURN AFTER); RETURN $updated; COMMIT TRANSACTION;