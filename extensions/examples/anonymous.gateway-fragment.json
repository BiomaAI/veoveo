{
  "schemaVersion": "veoveo.io/gateway-server-fragment/v1",
  "server": {
    "slug": "anonymous",
    "uri_scheme": "anonymous",
    "mount_path": "/anonymous",
    "mcp_path": "/anonymous/mcp",
    "upstream": {
      "transport": "streamable_http",
      "url": "http://anonymous-mcp:8811/anonymous/mcp",
      "health_url": "http://anonymous-mcp:8811/anonymous/healthz",
      "security": "cluster_internal_http"
    },
    "capabilities": {
      "apps": true,
      "tools": true,
      "resources": true,
      "resource_templates": false,
      "resource_subscriptions": true,
      "prompts": false,
      "completions": false,
      "tasks": true
    },
    "resource_projection": "server_owned",
    "app_resource_dependencies": [
      {
        "app_resource": "ui://anonymous/operations.html",
        "server": "frames",
        "scheme": "frames",
        "uri_prefix": "frames://world/",
        "required_scope": "frames:read",
        "operations": [
          "read"
        ]
      }
    ],
    "tools": [
      "run"
    ],
    "required_scopes": [
      "operator:use"
    ],
    "metadata": {}
  },
  "requiredPlatformCapabilities": [
    "artifact",
    "frames",
    "map",
    "media",
    "recording",
    "rrd"
  ],
  "requiredArtifactAudiences": [
    "anonymous"
  ],
  "recordingProducerRequired": false,
  "metadata": {}
}
