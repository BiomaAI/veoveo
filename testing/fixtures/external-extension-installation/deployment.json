{
  "schemaVersion": "veoveo.io/deployment/v3",
  "name": "anonymous-extension",
  "registry": {
    "address": "registry.example.internal:5002",
    "transport": "tls",
    "localConfig": null
  },
  "sources": [
    {
      "name": "veoveo",
      "role": "platform",
      "repository": {
        "kind": "local",
        "path": "../../.."
      },
      "revision": "HEAD",
      "imageGroups": [],
      "releases": [
        {
          "name": "veoveo",
          "chart": "deploy/helm/veoveo",
          "sourceValues": [],
          "installationValues": [],
          "valuesContract": "platform",
          "createNamespace": true,
          "timeoutSeconds": 720
        }
      ]
    }
  ],
  "kubernetes": {
    "context": "anonymous-extension",
    "localCluster": null
  },
  "namespace": "veoveo",
  "resources": {
    "manifests": [],
    "configMaps": [],
    "secrets": []
  },
  "platform": {
    "installationPreset": "custom",
    "components": [
      "gateway",
      "platform-store",
      "object-store",
      "artifact-service",
      "recording-data-plane"
    ],
    "mcpServers": [
      "artifact",
      "frames",
      "map",
      "media",
      "recording"
    ],
    "artifactAudiences": [
      "anonymous"
    ]
  },
  "gatewayRequirements": [
    "gateway-requirements.json"
  ],
  "waitForDeployments": []
}
