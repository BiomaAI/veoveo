{
  "schemaVersion": "veoveo.io/deployment/v3",
  "name": "anonymous-simulation-extension",
  "registry": {
    "address": "k3d-veoveo-registry.localhost:5001",
    "transport": "insecure-http",
    "localConfig": "../../../deploy/local/k3d/registry.json"
  },
  "sources": [
    {
      "name": "veoveo",
      "role": "platform",
      "repository": {
        "kind": "local",
        "path": "../../.."
      },
      "revision": "HEAD",
      "imageGroups": [],
      "releases": [
        {
          "name": "veoveo",
          "chart": "deploy/helm/veoveo",
          "sourceValues": [
            "deploy/local/k3d/values.yaml"
          ],
          "installationValues": [
            "platform-values.yaml"
          ],
          "valuesContract": "platform",
          "createNamespace": true,
          "timeoutSeconds": 1200
        }
      ]
    },
    {
      "name": "anonymous-simulation",
      "role": "extension",
      "repository": {
        "kind": "local",
        "path": "../../.."
      },
      "revision": "HEAD",
      "imageGroups": [
        "external-simulation-extension-fixture"
      ],
      "releases": [
        {
          "name": "anonymous-simulation",
          "chart": "testing/fixtures/external-simulation-extension/deploy/helm",
          "sourceValues": [],
          "installationValues": [],
          "valuesContract": "extension",
          "createNamespace": false,
          "timeoutSeconds": 600
        }
      ]
    }
  ],
  "kubernetes": {
    "context": "k3d-anonymous-simulation",
    "localCluster": {
      "name": "anonymous-simulation",
      "config": "cluster.yaml",
      "nodeBootstrapManifests": [
        "nvidia-device-plugin.yaml"
      ]
    }
  },
  "namespace": "veoveo",
  "resources": {
    "manifests": [
      "../../../deploy/local/k3d/development-resources.yaml",
      "pose-tls.development.yaml"
    ],
    "configMaps": [
      {
        "name": "veoveo-gateway-control-plane",
        "files": {
          "gateway.json": "gateway.json",
          "jwks.json": "../../../showcase/sumo/deploy/jwks.json"
        }
      }
    ],
    "secrets": []
  },
  "platform": {
    "installationPreset": "custom",
    "components": [
      "gateway",
      "ingress",
      "platform-store",
      "object-store",
      "artifact-service",
      "gpu-renderer",
      "simulation-runtime-support"
    ],
    "mcpServers": [
      "artifact",
      "frames",
      "simulation-view"
    ],
    "artifactAudiences": [
      "anonymous-simulation",
      "simulation-view"
    ],
    "externalWorkloads": [
      "anonymous-simulation-mcp"
    ],
    "gpuScheduling": {
      "runtimeClassName": "nvidia",
      "allocatableDevices": 1,
      "workloads": [
        {
          "workload": "simulation-view-renderer",
          "devices": 1,
          "isolation": "exclusive",
          "evidenceDigest": null
        }
      ]
    }
  },
  "gatewayRequirements": [
    "gateway-requirements.json"
  ],
  "waitForDeployments": [
    "simulation-view-mcp",
    "simulation-view-renderer",
    "anonymous-simulation-mcp"
  ]
}
