{
  "schemaVersion": "veoveo.io/deployment/v6",
  "name": "anonymous-simulation-extension",
  "registry": {
    "pushAddress": "127.0.0.1:5001",
    "pullAddress": "k3d-veoveo-registry.localhost:5001",
    "transport": "insecure-http",
    "localConfig": "../../../deploy/local/k3d/registry.json"
  },
  "sources": [
    {
      "name": "veoveo",
      "role": "platform",
      "repository": {
        "kind": "local",
        "path": "../../.."
      },
      "revision": "HEAD",
      "imageGroups": [],
      "releases": [
        {
          "name": "veoveo",
          "chart": "deploy/helm/veoveo",
          "sourceValues": [
            "deploy/local/k3d/values.yaml"
          ],
          "installationValues": [
            "platform-values.yaml"
          ],
          "valuesContract": "platform",
          "createNamespace": true,
          "timeoutSeconds": 1200
        }
      ]
    },
    {
      "name": "anonymous-simulation",
      "role": "extension",
      "repository": {
        "kind": "local",
        "path": "../../.."
      },
      "revision": "HEAD",
      "imageGroups": [
        "external-simulation-extension-fixture"
      ],
      "releases": [
        {
          "name": "anonymous-simulation",
          "chart": "testing/fixtures/external-simulation-extension/deploy/helm",
          "sourceValues": [],
          "installationValues": [],
          "valuesContract": "extension",
          "createNamespace": false,
          "timeoutSeconds": 600
        }
      ]
    }
  ],
  "kubernetes": {
    "context": "k3d-anonymous-simulation",
    "localCluster": {
      "name": "anonymous-simulation",
      "config": "cluster.yaml",
      "nodeBootstrapManifests": [
        "nvidia-runtime-class.yaml"
      ]
    }
  },
  "namespace": "veoveo",
  "resources": {
    "manifests": [
      "../../../deploy/local/k3d/development-resources.yaml"
    ],
    "configMaps": [],
    "secrets": []
  },
  "gatewayActivation": {
    "configMapNamePrefix": "veoveo-gateway",
    "controlPlaneKey": "gateway.json",
    "controlPlane": "gateway.json",
    "publicFiles": {
      "jwks.json": "../../../showcase/sumo/deploy/jwks.json"
    },
    "confidentialSecret": "veoveo-installation-secrets",
    "requiredSecretKeys": [
      "authorization-server-private-key-der-b64",
      "internal-signing-key-der-b64",
      "internal-signing-key-id",
      "oidc-client-secret",
      "refresh-delivery-key-b64"
    ]
  },
  "platform": {
    "installationPreset": "custom",
    "components": [
      "gateway",
      "ingress",
      "simulation-runtime-support"
    ],
    "mcpServers": [],
    "artifactAudiences": [],
    "externalWorkloads": [
      "anonymous-simulation-mcp"
    ],
    "gpuScheduling": null
  },
  "gatewayRequirements": [
    "gateway-requirements.json"
  ],
  "waitForDeployments": [
    "anonymous-simulation-mcp"
  ]
}
