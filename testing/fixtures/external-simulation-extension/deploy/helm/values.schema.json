{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["veoveo", "image", "service", "liveView", "resources", "networkPolicy"],
  "properties": {
    "veoveo-extension": {"type": "object"},
    "veoveo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationId", "production", "registry", "sourceTag", "imageDigests", "imagePullSecrets", "installationSecret", "gpuPlacement"],
      "properties": {
        "installationId": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "production": {"type": "boolean"},
        "registry": {"type": "string"},
        "sourceTag": {"type": "string", "not": {"const": "latest"}},
        "imageDigests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
        "imagePullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
        "installationSecret": {"type": "string", "minLength": 1},
        "gpuPlacement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "claimName", "runtimeClassName", "evidenceDigest", "workloadRequests", "workloadReplicas"],
          "properties": {
            "enabled": {"type": "boolean"},
            "claimName": {"type": "string"},
            "runtimeClassName": {"type": "string", "minLength": 1},
            "evidenceDigest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
            "workloadRequests": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
            "workloadReplicas": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}
    },
    "liveView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicSignalingUrl", "publicMediaHost", "publicMediaPort", "leaseSeconds", "maximumViewers"],
      "properties": {
        "publicSignalingUrl": {"type": "string", "pattern": "^wss?://[^@]+$"},
        "publicMediaHost": {"type": "string", "minLength": 2, "maxLength": 45},
        "publicMediaPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "leaseSeconds": {"type": "integer", "minimum": 5, "maximum": 3600},
        "maximumViewers": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}},
        "limits": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dnsNamespaceSelector"],
      "properties": {"dnsNamespaceSelector": {"type": "object", "minProperties": 1}}
    }
  }
}
