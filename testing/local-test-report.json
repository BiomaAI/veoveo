    {
      "name": "cuopt-gpu",
      "command": [
        "bash",
        "-lc",
        "set -euo pipefail\ncontainer_name=veoveo-cuopt-2608-test\nif docker ps -a --filter \"name=^/${container_name}$\" --format \"{{.ID}}\" | grep -q .; then\n  echo \"refusing to replace existing container ${container_name}\" >&2\n  exit 1\nfi\ntest_dir=$(mktemp -d /tmp/veoveo-cuopt-2608-test.XXXXXX)\ncase \"${test_dir}\" in /tmp/veoveo-cuopt-2608-test.*) ;; *) echo \"unexpected temp directory ${test_dir}\" >&2; exit 1 ;; esac\ncleanup() {\n  docker stop --timeout 10 \"${container_name}\" >/dev/null 2>&1 || true\n  if [ -d \"${test_dir}\" ] && [ ! -L \"${test_dir}\" ]; then find \"${test_dir}\" -xdev -depth -delete; fi\n}\ntrap cleanup EXIT\ndocker run --detach --rm --name \"${container_name}\" --gpus device=0 --user \"$(id -u):$(id -g)\" --volume \"${test_dir}:/run/veoveo-cuopt\" veoveo/cuopt-executor:0.1.0 >/dev/null\nfor _ in $(seq 1 180); do\n  if [ -S \"${test_dir}/executor.sock\" ]; then break; fi\n  if ! docker ps --filter \"name=^/${container_name}$\" --format \"{{.ID}}\" | grep -q .; then docker logs \"${container_name}\" >&2 || true; exit 1; fi\n  sleep 1\ndone\nif [ ! -S \"${test_dir}/executor.sock\" ]; then docker logs \"${container_name}\" >&2 || true; exit 1; fi\nVEOVEO_CUOPT_TEST_SOCKET=\"${test_dir}/executor.sock\" cargo test -p veoveo-optimization-mcp --test cuopt_gpu -- --ignored --nocapture\n"
      ],
