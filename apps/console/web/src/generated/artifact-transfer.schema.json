{
  "$defs": {
    "AccessLevel": {
      "description": "A capability level. Ordered `Read < Write < Admin`, so `min` yields the\nlesser privilege — exactly what capping a group role by a grant level needs.",
      "enum": [
        "read",
        "write",
        "admin"
      ],
      "type": "string"
    },
    "ArtifactAccessRequest": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId"
        },
        "createdAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "decidedAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": [
            "string",
            "null"
          ]
        },
        "decidedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "decisionNote": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ArtifactAccessRequestId"
        },
        "justification": {
          "type": "string"
        },
        "requestedLevel": {
          "$ref": "#/$defs/AccessLevel"
        },
        "requester": {
          "$ref": "#/$defs/PrincipalId"
        },
        "state": {
          "$ref": "#/$defs/ArtifactAccessRequestState"
        },
        "updatedAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        }
      },
      "required": [
        "id",
        "artifactId",
        "workContext",
        "requester",
        "requestedLevel",
        "justification",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "ArtifactAccessRequestId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_artifact_contract::ledger"
              },
              "profile": "ArtifactAccessRequestId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "type": "string"
    },
    "ArtifactAccessRequestPage": {
      "additionalProperties": false,
      "properties": {
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactAccessRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/ArtifactAccessRequest"
          },
          "type": "array"
        }
      },
      "required": [
        "requests"
      ],
      "type": "object"
    },
    "ArtifactAccessRequestState": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "cancelled"
      ],
      "type": "string"
    },
    "ArtifactId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_artifact_contract::identity"
              },
              "profile": "ArtifactId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Canonical identity of one logical artifact occurrence. Every put creates a\nfresh UUIDv7 even when its bytes deduplicate to an existing tenant blob.",
      "type": "string"
    },
    "ArtifactShareLink": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId"
        },
        "expiresAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "linkId": {
          "$ref": "#/$defs/ArtifactShareLinkId"
        },
        "maxDownloads": {
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "linkId",
        "artifactId",
        "url",
        "expiresAt"
      ],
      "type": "object"
    },
    "ArtifactShareLinkId": {
      "description": "Identity of an expiring Artifact share, distinct from an occurrence.\n```compile_fail\nuse veoveo_artifact_contract::{ArtifactId, ArtifactShareLinkId};\nfn revoke(_: ArtifactShareLinkId) {}\nrevoke(ArtifactId::new());\n```",
      "type": "string"
    },
    "ArtifactUploadId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_artifact_contract::ledger"
              },
              "profile": "ArtifactUploadId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "type": "string"
    },
    "ArtifactUploadNotification": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "changed",
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/ArtifactUploadNotificationState"
            },
            "uploadId": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "required": [
            "op",
            "uploadId",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactUploadNotificationState": {
      "description": "Upload notifications trigger a currently authorized status read.",
      "enum": [
        "finalizing",
        "verifying",
        "completed",
        "cancelled",
        "expired",
        "failed"
      ],
      "type": "string"
    },
    "ArtifactUploadPolicy": {
      "additionalProperties": false,
      "description": "Absence of a configured policy disables public uploads. There is no Default.",
      "properties": {
        "allowedMimeTypes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "inactivitySeconds": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "lifetimeSeconds": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "maxActiveUploadsPerTenant": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "maxInflightBytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "maxObjectBytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "maxPartBytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "maxParts": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "parallelParts": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "partBytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "partTimeoutSeconds": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "tenantQuotaBytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maxObjectBytes",
        "tenantQuotaBytes",
        "maxActiveUploadsPerTenant",
        "partBytes",
        "maxPartBytes",
        "maxParts",
        "parallelParts",
        "maxInflightBytes",
        "inactivitySeconds",
        "lifetimeSeconds",
        "partTimeoutSeconds",
        "allowedMimeTypes"
      ],
      "type": "object"
    },
    "ArtifactUploadReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId"
        },
        "artifactUri": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "byteLen": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "createdAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/UploadSha256"
        },
        "uploadId": {
          "$ref": "#/$defs/ArtifactUploadId"
        }
      },
      "required": [
        "uploadId",
        "artifactId",
        "artifactUri",
        "sha256",
        "byteLen",
        "mimeType",
        "filename",
        "createdAt"
      ],
      "type": "object"
    },
    "ArtifactUploadSession": {
      "additionalProperties": false,
      "properties": {
        "acceptedBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "acceptedPartCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "createdAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "descriptor": {
          "$ref": "#/$defs/CreateArtifactUpload"
        },
        "expiresAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/UploadErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "$ref": "#/$defs/UploadLayout"
        },
        "nextPartCursor": {
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/UploadPartReceipt"
          },
          "type": "array"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactUploadReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/ArtifactUploadState"
        },
        "uploadId": {
          "$ref": "#/$defs/ArtifactUploadId"
        }
      },
      "required": [
        "uploadId",
        "state",
        "descriptor",
        "layout",
        "acceptedBytes",
        "acceptedPartCount",
        "parts",
        "createdAt",
        "expiresAt"
      ],
      "type": "object"
    },
    "ArtifactUploadState": {
      "enum": [
        "open",
        "finalizing",
        "verifying",
        "completed",
        "cancelled",
        "expired",
        "failed"
      ],
      "type": "string"
    },
    "ArtifactUri": {
      "description": "Neutral or server-presented Artifact occurrence URI.",
      "type": "string"
    },
    "CreateArtifactUpload": {
      "additionalProperties": false,
      "properties": {
        "byteLen": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "filename": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/UploadSha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "filename",
        "mimeType"
      ],
      "type": "object"
    },
    "EffectiveArtifactUploadPolicy": {
      "additionalProperties": false,
      "properties": {
        "accessDescription": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/PrincipalId"
        },
        "allowed": {
          "type": "boolean"
        },
        "availableBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "destinationName": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactUploadPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        }
      },
      "required": [
        "allowed",
        "explanation",
        "actor",
        "workContext",
        "destinationName",
        "accessDescription"
      ],
      "type": "object"
    },
    "PrincipalId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "PrincipalId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Stable authenticated user or service-principal identity.",
      "type": "string"
    },
    "UploadErrorCode": {
      "enum": [
        "malformed",
        "unauthenticated",
        "denied",
        "not_found",
        "conflict",
        "expired",
        "too_large",
        "unsupported_type",
        "integrity",
        "quota_exceeded",
        "busy",
        "unavailable"
      ],
      "type": "string"
    },
    "UploadLayout": {
      "additionalProperties": false,
      "properties": {
        "maxParts": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "maxTotalBytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "parallelParts": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "partBytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "partBytes",
        "maxParts",
        "maxTotalBytes",
        "parallelParts"
      ],
      "type": "object"
    },
    "UploadPartReceipt": {
      "additionalProperties": false,
      "properties": {
        "byteLen": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "partNumber": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/UploadSha256"
        }
      },
      "required": [
        "partNumber",
        "byteLen",
        "sha256"
      ],
      "type": "object"
    },
    "UploadSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "WorkContextId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "WorkContextId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Tenant-local boundary that governs related work and every output it produces.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Source-owner Artifact transfer and access contracts consumed by browser clients.",
  "properties": {
    "accessRequest": {
      "$ref": "#/$defs/ArtifactAccessRequest"
    },
    "accessRequestPage": {
      "$ref": "#/$defs/ArtifactAccessRequestPage"
    },
    "descriptor": {
      "$ref": "#/$defs/CreateArtifactUpload"
    },
    "notification": {
      "$ref": "#/$defs/ArtifactUploadNotification"
    },
    "part": {
      "$ref": "#/$defs/UploadPartReceipt"
    },
    "policy": {
      "$ref": "#/$defs/EffectiveArtifactUploadPolicy"
    },
    "receipt": {
      "$ref": "#/$defs/ArtifactUploadReceipt"
    },
    "session": {
      "$ref": "#/$defs/ArtifactUploadSession"
    },
    "shareLink": {
      "$ref": "#/$defs/ArtifactShareLink"
    }
  },
  "required": [
    "notification",
    "descriptor",
    "receipt",
    "session",
    "part",
    "policy",
    "accessRequest",
    "accessRequestPage",
    "shareLink"
  ],
  "title": "ArtifactTransferSchema",
  "type": "object"
}
