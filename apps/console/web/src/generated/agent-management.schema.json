{
  "$defs": {
    "AgentDefinitionId": {
      "type": "string"
    },
    "AgentManagedInstanceId": {
      "type": "string"
    },
    "AgentModelId": {
      "type": "string"
    },
    "AgentTemplateId": {
      "type": "string"
    },
    "Authoring": {
      "additionalProperties": false,
      "properties": {
        "definitionLimit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "instanceLimit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelChoice"
          },
          "type": "array"
        },
        "permissions": {
          "$ref": "#/$defs/AuthoringPermissions"
        },
        "storageLimitGib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        }
      },
      "required": [
        "workContext",
        "permissions",
        "models",
        "definitionLimit",
        "instanceLimit",
        "storageLimitGib"
      ],
      "type": "object"
    },
    "AuthoringPermissions": {
      "additionalProperties": false,
      "properties": {
        "archive": {
          "type": "boolean"
        },
        "control": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "deploy": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean"
        },
        "instanceControl": {
          "type": "boolean"
        },
        "manageContext": {
          "type": "boolean"
        },
        "publish": {
          "type": "boolean"
        },
        "readContent": {
          "type": "boolean"
        },
        "transfer": {
          "type": "boolean"
        }
      },
      "required": [
        "readContent",
        "create",
        "edit",
        "publish",
        "control",
        "archive",
        "transfer",
        "deploy",
        "instanceControl",
        "manageContext"
      ],
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "deadlineSeconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxCompletionCalls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxOutputTokens": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxToolCalls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maxOutputTokens",
        "maxCompletionCalls",
        "maxToolCalls",
        "deadlineSeconds"
      ],
      "type": "object"
    },
    "CapabilityChoice": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/GatewayToolName"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "description"
      ],
      "type": "object"
    },
    "CatalogWake": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "sequence"
      ],
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "execution": {
          "$ref": "#/$defs/Execution"
        },
        "instructions": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelReference"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/GatewayToolName"
          },
          "type": "array"
        }
      },
      "required": [
        "model",
        "instructions",
        "tools",
        "budgets",
        "execution"
      ],
      "type": "object"
    },
    "CreateDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AgentDefinitionId"
        },
        "name": {
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DefinitionSource"
        }
      },
      "required": [
        "requestId",
        "id",
        "name",
        "description",
        "source"
      ],
      "type": "object"
    },
    "Definition": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "$ref": "#/$defs/WorkContextId"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "draftDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/AgentDefinitionId"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "format": "uuid",
          "type": "string"
        },
        "publishedDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/DefinitionStatus"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "owner",
        "workContext",
        "revision",
        "status",
        "disabled",
        "draftDigest",
        "audience",
        "updatedAt"
      ],
      "type": "object"
    },
    "DefinitionPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Definition"
          },
          "type": "array"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentDefinitionId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "DefinitionSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/Content"
            },
            "kind": {
              "const": "blank",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "content"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "definition": {
              "$ref": "#/$defs/AgentDefinitionId"
            },
            "digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "kind": {
              "const": "duplicate",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "definition",
            "digest"
          ],
          "type": "object"
        }
      ]
    },
    "DefinitionStatus": {
      "enum": [
        "enabled",
        "disabled",
        "archived"
      ],
      "type": "string"
    },
    "Draft": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/Content"
        },
        "definition": {
          "$ref": "#/$defs/AgentDefinitionId"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "definition",
        "revision",
        "content"
      ],
      "type": "object"
    },
    "Execution": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "chat",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "managed",
              "type": "string"
            },
            "parameters": {
              "additionalProperties": {
                "$ref": "#/$defs/TemplateParameter"
              },
              "type": "object"
            },
            "resourceSubscriptions": {
              "items": {
                "$ref": "#/$defs/ResourceUri"
              },
              "type": "array"
            },
            "template": {
              "$ref": "#/$defs/AgentTemplateId"
            },
            "templateRevision": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "template",
            "templateRevision",
            "parameters",
            "resourceSubscriptions"
          ],
          "type": "object"
        }
      ]
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/FindingCode"
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "field",
        "message"
      ],
      "type": "object"
    },
    "FindingCode": {
      "enum": [
        "invalid_content",
        "model_unavailable",
        "model_changed",
        "capability_unavailable",
        "capacity_exceeded",
        "template_unavailable",
        "audience_forbidden"
      ],
      "type": "string"
    },
    "GatewayToolName": {
      "description": "Gateway-scoped tool name after server namespace projection.",
      "type": "string"
    },
    "InstanceChange": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "desired": {
              "$ref": "#/$defs/InstanceDesired"
            },
            "kind": {
              "const": "state",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "desired"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "revision",
              "type": "string"
            },
            "revision": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "stop",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "retry",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "InstanceDesired": {
      "enum": [
        "running",
        "paused",
        "archived"
      ],
      "type": "string"
    },
    "InstancePage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ManagedInstance"
          },
          "type": "array"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentManagedInstanceId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "InstancePhase": {
      "enum": [
        "queued",
        "credentials",
        "storage",
        "draining",
        "workload",
        "ready",
        "paused",
        "archived",
        "failed",
        "superseded"
      ],
      "type": "string"
    },
    "LifecycleOperation": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "instance": {
          "$ref": "#/$defs/AgentManagedInstanceId"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/InstancePhase"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "instance",
        "generation",
        "phase",
        "updatedAt"
      ],
      "type": "object"
    },
    "ManagedInstance": {
      "additionalProperties": false,
      "properties": {
        "activeGeneration": {
          "format": "int64",
          "type": "integer"
        },
        "activeRevision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "$ref": "#/$defs/OAuthClientId"
        },
        "definition": {
          "$ref": "#/$defs/AgentDefinitionId"
        },
        "desired": {
          "$ref": "#/$defs/InstanceDesired"
        },
        "generation": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/AgentManagedInstanceId"
        },
        "name": {
          "type": "string"
        },
        "observed": {
          "$ref": "#/$defs/InstancePhase"
        },
        "operation": {
          "format": "uuid",
          "type": "string"
        },
        "owner": {
          "format": "uuid",
          "type": "string"
        },
        "principal": {
          "format": "uuid",
          "type": "string"
        },
        "requestedRevision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "storageGib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "template": {
          "$ref": "#/$defs/AgentTemplateId"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        }
      },
      "required": [
        "id",
        "name",
        "definition",
        "owner",
        "workContext",
        "template",
        "requestedRevision",
        "generation",
        "activeGeneration",
        "desired",
        "observed",
        "clientId",
        "principal",
        "storageGib",
        "operation",
        "updatedAt"
      ],
      "type": "object"
    },
    "MetadataChange": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "presentation",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "description"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "transfer",
              "type": "string"
            },
            "owner": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "owner"
          ],
          "type": "object"
        }
      ]
    },
    "ModelChoice": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "$ref": "#/$defs/Budgets"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ModelReference"
        }
      },
      "required": [
        "reference",
        "name",
        "provider",
        "model",
        "limits"
      ],
      "type": "object"
    },
    "ModelReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/AgentModelId"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "OAuthClientId": {
      "description": "Registered OAuth client id allowed to request gateway-profile tokens.",
      "type": "string"
    },
    "ParameterChoice": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/ParameterShape"
        }
      },
      "required": [
        "name",
        "label",
        "shape"
      ],
      "type": "object"
    },
    "ParameterShape": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "identifier",
              "type": "string"
            },
            "maxLength": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "maxLength"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choice",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            },
            "maximum": {
              "format": "int64",
              "type": "integer"
            },
            "minimum": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "minimum",
            "maximum"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ProvisionInstance": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/AgentDefinitionId"
        },
        "id": {
          "$ref": "#/$defs/AgentManagedInstanceId"
        },
        "name": {
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "id",
        "name",
        "definition",
        "revision"
      ],
      "type": "object"
    },
    "PublishDefinition": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "$ref": "#/$defs/WorkContextId"
          },
          "type": "array"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "expectedRevision": {
          "format": "int64",
          "type": "integer"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "expectedRevision",
        "digest",
        "audience"
      ],
      "type": "object"
    },
    "PublishedRevision": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/Content"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "createdBy": {
          "format": "uuid",
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/AgentDefinitionId"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "definition",
        "digest",
        "content",
        "createdBy",
        "createdAt"
      ],
      "type": "object"
    },
    "ResourceUri": {
      "type": "string"
    },
    "RevisionPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PublishedRevision"
          },
          "type": "array"
        },
        "next": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "RevisionRequest": {
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "format": "int64",
          "type": "integer"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "expectedRevision"
      ],
      "type": "object"
    },
    "RoleId": {
      "description": "Identity-provider role identifier used by gateway policy.",
      "type": "string"
    },
    "SaveDraft": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/Content"
        },
        "expectedRevision": {
          "format": "int64",
          "type": "integer"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "expectedRevision",
        "content"
      ],
      "type": "object"
    },
    "ScopeName": {
      "description": "OAuth/OIDC scope value. It must not contain whitespace or control characters.",
      "type": "string"
    },
    "TemplateChoice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/AgentTemplateId"
        },
        "membership": {
          "$ref": "#/$defs/WorkContextMembershipLevel"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/AgentModelId"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterChoice"
          },
          "type": "array"
        },
        "resourceSubscriptions": {
          "items": {
            "$ref": "#/$defs/ResourceUri"
          },
          "type": "array"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleId"
          },
          "type": "array"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/ScopeName"
          },
          "type": "array"
        },
        "storageGib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "tools": {
