{
  "$defs": {
    "PlaybackAccess": {
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "grantId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingReadGrantId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        },
        "redapToken": {
          "type": "string"
        }
      },
      "required": [
        "grantId",
        "redapToken",
        "expiresAt"
      ],
      "type": "object"
    },
    "PlaybackArchive": {
      "additionalProperties": false,
      "properties": {
        "byteLen": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "catalogRevision": {
          "type": "string"
        },
        "datasetId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingDatasetId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        },
        "layerCount": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "optimizationProfile": {
          "type": "string"
        },
        "recordingSegmentId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        },
        "rrdVersion": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "datasetId",
        "recordingSegmentId",
        "catalogRevision",
        "rrdVersion",
        "optimizationProfile",
        "byteLen",
        "layerCount"
      ],
      "type": "object"
    },
    "PlaybackBlueprint": {
      "additionalProperties": false,
      "properties": {
        "blueprintId": {
          "type": "string"
        },
        "byteLen": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "mapProvider": {
          "$ref": "#/$defs/PlaybackMapProvider"
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "blueprintId",
        "revision",
        "sha256",
        "byteLen",
        "mapProvider"
      ],
      "type": "object"
    },
    "PlaybackLiveReceiver": {
      "additionalProperties": false,
      "description": "Recording-scoped channel, available throughout Live, including capture-layer gaps.",
      "properties": {
        "historySeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "transport": {
          "$ref": "#/$defs/PlaybackLiveTransport"
        },
        "videoPrerollSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "historySeconds",
        "videoPrerollSeconds",
        "transport"
      ],
      "type": "object"
    },
    "PlaybackLiveTransport": {
      "enum": [
        "rerun_rrd_channel_v2"
      ],
      "type": "string"
    },
    "PlaybackManifestSchema": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "grammar": "format_tag",
            "kind": "builtin"
          }
        }
      },
      "enum": [
        "veoveo.ai/recording-playback/v11"
      ],
      "type": "string"
    },
    "PlaybackMapProvider": {
      "enum": [
        "none",
        "open_street_map",
        "mapbox",
        "mixed"
      ],
      "type": "string"
    },
    "RecordingState": {
      "enum": [
        "live",
        "ready",
        "sealing",
        "sealed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An admitted, immutable manifest. Rust construction and JSON use the same checks.\n```compile_fail\nuse veoveo_recording_contract::PlaybackManifest;\nfn change_parent(manifest: &mut PlaybackManifest) {\n    manifest.recording_segment_id = Default::default();\n}\n```",
  "properties": {
    "access": {
      "$ref": "#/$defs/PlaybackAccess"
    },
    "applicationId": {
      "type": "string"
    },
    "archive": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackArchive"
        },
        {
          "type": "null"
        }
      ]
    },
    "blueprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackBlueprint"
        },
        {
          "type": "null"
        }
      ]
    },
    "catalogRevision": {
      "type": "string"
    },
    "datasetId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_recording_contract::ids"
              },
              "profile": "RecordingDatasetId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "type": "string"
    },
    "endedAt": {
      "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
      "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "type": [
        "string",
        "null"
      ]
    },
    "live": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackLiveReceiver"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordingKey": {
      "type": "string"
    },
    "recordingSegmentId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_recording_contract::ids"
              },
              "profile": "RecordingId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "type": "string"
    },
    "schema": {
      "$ref": "#/$defs/PlaybackManifestSchema"
    },
    "startedAt": {
      "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
      "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/RecordingState"
    }
  },
  "required": [
    "schema",
    "datasetId",
    "recordingSegmentId",
    "applicationId",
    "recordingKey",
    "state",
    "startedAt",
    "catalogRevision",
    "access"
  ],
  "title": "PlaybackManifest",
  "type": "object"
}
