{
  "$defs": {
    "AccessDescriptor": {
      "additionalProperties": false,
      "properties": {
        "dataLabels": {
          "items": {
            "$ref": "#/$defs/DataLabelId"
          },
          "type": "array"
        },
        "expiresAt": {
          "description": "Deadline for every read path, including tenant, context and owner access.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/ReadGrant"
          },
          "type": "array"
        },
        "owner": {
          "$ref": "#/$defs/AccessSubject"
        },
        "readPolicy": {
          "$ref": "#/$defs/ReadPolicy"
        },
        "tenant": {
          "$ref": "#/$defs/TenantId"
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        }
      },
      "required": [
        "tenant",
        "workContext",
        "readPolicy",
        "owner",
        "dataLabels"
      ],
      "type": "object"
    },
    "AccessLevel": {
      "description": "A capability level. Ordered `Read < Write < Admin`, so `min` yields the\nlesser privilege — exactly what capping a group role by a grant level needs.",
      "enum": [
        "read",
        "write",
        "admin"
      ],
      "type": "string"
    },
    "AccessSubject": {
      "description": "A principal or group that can own governed data or receive access.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "const": "principal",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/GroupId"
            },
            "kind": {
              "const": "group",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "AccountActivity": {
      "enum": [
        "create",
        "update",
        "delete",
        "membership_change",
        "grant",
        "revoke"
      ],
      "type": "string"
    },
    "AdminOperationFailure": {
      "enum": [
        "agent_management",
        "agent_conversation",
        "agent_input_request",
        "agent_message",
        "artifact_grant",
        "artifact_grant_revoke",
        "artifact_release_state",
        "artifact_share_link",
        "artifact_share_link_revoke",
        "build_http_client",
        "cancel_task",
        "control_plane_sha",
        "expired_revocation",
        "invalid_control_plane",
        "issue_internal_token",
        "latest_revision_read",
        "persist_control_plane_revision",
        "persist_jwt_revocation",
        "prune_jwt_revocations",
        "revision_id",
        "server_admin_proxy",
        "task_ownership",
        "task_route"
      ],
      "type": "string"
    },
    "AdministrativeAccess": {
      "enum": [
        "read",
        "write"
      ],
      "type": "string"
    },
    "AdministrativeOperation": {
      "enum": [
        "control_plane",
        "jwt_revoke",
        "jwt_prune",
        "agent_message",
        "agent_conversation",
        "agent_input_requests",
        "agent_input_decision",
        "agent_definitions_read",
        "agent_definitions_read_content",
        "agent_definitions_create",
        "agent_definitions_edit",
        "agent_definitions_publish",
        "agent_definitions_use",
        "agent_definitions_control",
        "agent_definitions_archive",
        "agent_definitions_transfer",
        "agent_instances_deploy",
        "agent_instances_control",
        "artifact_release",
        "artifact_grant",
        "artifact_revoke",
        "artifact_share",
        "artifact_unshare",
        "artifact_access_request_create",
        "artifact_access_request_list",
        "artifact_access_request_decide",
        "artifact_access_request_cancel",
        "console_cluster",
        "console_snapshot",
        "console_stream",
        "console_artifact",
        "server_proxy",
        "task_cancel"
      ],
      "type": "string"
    },
    "ArtifactActivity": {
      "enum": [
        "publish",
        "download",
        "grant",
        "revoke",
        "share",
        "unshare",
        "delete",
        "inspect",
        "grants_read",
        "release",
        "access_request_create",
        "access_request_read",
        "access_request_decide",
        "access_request_cancel",
        "read_capability_issue",
        "read_capability_revoke",
        "write_capability_issue",
        "write_capability_redeem",
        "share_redeem"
      ],
      "type": "string"
    },
    "ArtifactId": {
      "description": "Canonical identity of one logical artifact occurrence. Every put creates a\nfresh UUIDv7 even when its bytes deduplicate to an existing tenant blob.",
      "type": "string"
    },
    "ArtifactReleaseState": {
      "enum": [
        "private",
        "releasable",
        "released"
      ],
      "type": "string"
    },
    "AuditClass": {
      "enum": [
        "api_activity",
        "authentication",
        "account_change",
        "artifact_activity",
        "live_view_access",
        "computer_activity"
      ],
      "type": "string"
    },
    "AuditCursor": {
      "additionalProperties": false,
      "properties": {
        "last_id": {
          "$ref": "#/$defs/AuditRecordId"
        },
        "order": {
          "$ref": "#/$defs/AuditOrder"
        },
        "partition": {
          "$ref": "#/$defs/AuditPartition"
        }
      },
      "required": [
        "order",
        "partition",
        "last_id"
      ],
      "type": "object"
    },
    "AuditDailyCount": {
      "properties": {
        "class": {
          "$ref": "#/$defs/AuditClass"
        },
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "day": {
          "format": "date-time",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/AuditOutcome"
        },
        "partition": {
          "$ref": "#/$defs/AuditPartition"
        }
      },
      "required": [
        "partition",
        "day",
        "class",
        "outcome",
        "count"
      ],
      "type": "object"
    },
    "AuditDailyCursor": {
      "additionalProperties": false,
      "description": "Stable keyset over one partition's grouped counts. Date bounds are inclusive/exclusive.",
      "properties": {
        "class": {
          "$ref": "#/$defs/AuditClass"
        },
        "day": {
          "format": "date-time",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/AuditOutcome"
        },
        "partition": {
          "$ref": "#/$defs/AuditPartition"
        }
      },
      "required": [
        "partition",
        "day",
        "class",
        "outcome"
      ],
      "type": "object"
    },
    "AuditDailyPage": {
      "properties": {
        "counts": {
          "items": {
            "$ref": "#/$defs/AuditDailyCount"
          },
          "type": "array"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditDailyCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "counts"
      ],
      "type": "object"
    },
    "AuditDailyQuery": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditDailyCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "format": "date-time",
          "type": "string"
        },
        "limit": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "partition": {
          "$ref": "#/$defs/AuditPartition"
        },
        "until": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "partition",
        "from",
        "until",
        "limit"
      ],
      "type": "object"
    },
    "AuditDetail": {
      "description": "Closed payloads contain identifiers, measurements and reviewed enums only.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "access": {
              "$ref": "#/$defs/AdministrativeAccess"
            },
            "kind": {
              "const": "admin_admission",
              "type": "string"
            },
            "operation": {
              "$ref": "#/$defs/AdministrativeOperation"
            }
          },
          "required": [
            "kind",
            "operation",
            "access"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "access": {
              "$ref": "#/$defs/AdministrativeAccess"
            },
            "failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AdminOperationFailure"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "const": "admin_completion",
              "type": "string"
            },
            "operation": {
              "$ref": "#/$defs/AdministrativeOperation"
            }
          },
          "required": [
            "kind",
            "operation",
            "access"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "read",
              "type": "string"
            },
            "method": {
              "$ref": "#/$defs/AuditReadMethod"
            }
          },
          "required": [
            "kind",
            "method"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "collection": {
              "$ref": "#/$defs/DiscoveryKind"
            },
            "denied": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "discovery",
              "type": "string"
            },
            "visible": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "visible_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "collection",
            "visible",
            "denied",
            "visible_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activity": {
              "$ref": "#/$defs/TaskActivity"
            },
            "kind": {
              "const": "task",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "activity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tool_admission",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "duration_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "error_code": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "tool_completion",
              "type": "string"
            },
            "result": {
              "$ref": "#/$defs/ToolResultKind"
            }
          },
          "required": [
            "kind",
            "result",
            "duration_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activity": {
              "$ref": "#/$defs/AuthenticationActivity"
            },
            "kind": {
              "const": "authentication",
              "type": "string"
            },
            "method": {
              "$ref": "#/$defs/AuthMethod"
            },
            "reason": {
              "$ref": "#/$defs/AuthReasonCode"
            }
          },
          "required": [
            "kind",
            "activity",
            "method",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activity": {
              "$ref": "#/$defs/AccountActivity"
            },
            "kind": {
              "const": "account_change",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "activity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activity": {
              "$ref": "#/$defs/ArtifactActivity"
            },
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            },
            "related": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ResourceUri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "release_state": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactReleaseState"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AccessLevel"
                },
                {
                  "type": "null"
                }
              ]
            },
            "subject": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AccessSubject"
                },
                {
                  "type": "null"
                }
              ]
            },
            "window_start": {
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "activity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activity": {
              "$ref": "#/$defs/LiveViewActivity"
            },
            "kind": {
              "const": "live_view",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "activity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activity": {
              "$ref": "#/$defs/ComputerActivity"
            },
            "kind": {
              "const": "computer",
              "type": "string"
            },
            "stage": {
              "$ref": "#/$defs/ComputerAuditStage"
            },
            "task": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "activity",
            "stage"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activity": {
              "$ref": "#/$defs/RecordingActivity"
            },
            "kind": {
              "const": "recording",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "activity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "recording_catalog_grant",
              "type": "string"
            },
            "recordings": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "selection_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "recordings",
            "selection_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "dictation_open",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "dictation_denial",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chunks": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "duration_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "end": {
              "$ref": "#/$defs/DictationEnd"
            },
            "kind": {
              "const": "dictation_summary",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "end",
            "chunks",
            "duration_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "knowledge_read",
              "type": "string"
            },
            "member": {
              "$ref": "#/$defs/ResourceUri"
            },
            "observation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/KnowledgeReadObservation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "$ref": "#/$defs/KnowledgeReadStatus"
            }
          },
          "required": [
            "kind",
            "member",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "collection": {
              "$ref": "#/$defs/CollectionId"
            },
            "end": {
              "format": "date-time",
              "type": "string"
            },
            "failed": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "indexing_window",
              "type": "string"
            },
            "members_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "not_modified": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "reads": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "start": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "collection",
            "start",
            "end",
            "reads",
            "not_modified",
            "failed",
            "members_digest"
          ],
          "type": "object"
        }
      ]
    },
    "AuditOrder": {
      "enum": [
        "oldest_first",
        "newest_first"
      ],
      "type": "string"
    },
    "AuditOutcome": {
      "enum": [
        "allowed",
        "denied",
        "succeeded",
        "failed"
      ],
      "type": "string"
    },
    "AuditPartition": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "installation",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tenant",
              "type": "string"
            },
            "tenant": {
              "$ref": "#/$defs/TenantId"
            }
          },
          "required": [
            "kind",
            "tenant"
          ],
          "type": "object"
        }
      ]
    },
    "AuditQuery": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "class": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "order": {
          "$ref": "#/$defs/AuditOrder"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "partition": {
          "$ref": "#/$defs/AuditPartition"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditTraceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "until": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "order",
        "partition",
        "limit"
      ],
      "type": "object"
    },
    "AuditReadMethod": {
      "enum": [
        "resource_read",
        "prompt_get",
        "completion",
        "subscription",
        "status",
        "usage",
        "audit_view",
        "audit_export"
      ],
      "type": "string"
    },
    "AuditReason": {
      "enum": [
        "accepted",
        "policy_denied",
        "tenant_mismatch",
        "insufficient_clearance",
        "insufficient_access",
        "unauthenticated",
        "invalid_credential",
        "expired_credential",
        "replay",
        "revoked",
        "invalid_request",
        "not_found",
        "conflict",
        "unavailable",
        "quota_exceeded",
        "cancelled",
        "timed_out",
        "upstream_failure",
        "internal_failure",
        "unknown_profile",
        "unknown_server",
        "unknown_tool",
        "unknown_resource",
        "unknown_prompt",
        "unknown_task",
        "unknown_artifact",
        "unknown_principal",
        "unknown_scope",
        "unknown_data_label",
        "unknown_tenant",
        "unknown_token_issuer",
        "missing_principal",
        "missing_tenant",
        "missing_group",
        "missing_role",
        "missing_scope",
        "missing_data_label",
        "missing_principal_assurance",
        "token_audience_mismatch",
        "token_not_yet_valid"
      ],
      "type": "string"
    },
    "AuditRecordId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "AuditRecordSummary": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "class": {
          "$ref": "#/$defs/AuditClass"
        },
        "detail": {
          "$ref": "#/$defs/AuditDetail"
        },
