{
  "$defs": {
    "AccessGrantCollection": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/AccessGrantView"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "computerId",
        "grants"
      ],
      "type": "object"
    },
    "AccessGrantKind": {
      "enum": [
        "browser",
        "cli"
      ],
      "type": "string"
    },
    "AccessGrantView": {
      "additionalProperties": false,
      "properties": {
        "currentSession": {
          "description": "Issued under this sign-in family; it may belong to another browser tab.",
          "type": "boolean"
        },
        "expiresAt": {
          "description": "An upper bound. Current policy, idle expiry or revocation can end access sooner.",
          "format": "date-time",
          "type": "string"
        },
        "grantId": {
          "format": "uuid",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AccessGrantKind"
        },
        "lastActivityAt": {
          "format": "date-time",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "redeemed": {
          "description": "Redemption is recorded history, not a claim that a transport is connected.",
          "type": "boolean"
        }
      },
      "required": [
        "grantId",
        "kind",
        "name",
        "redeemed",
        "currentSession",
        "issuedAt",
        "expiresAt",
        "lastActivityAt"
      ],
      "type": "object"
    },
    "AccessRevocation": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "grantId": {
          "format": "uuid",
          "type": "string"
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "required": [
        "computerId",
        "grantId",
        "revoked"
      ],
      "type": "object"
    },
    "Action": {
      "enum": [
        "create",
        "start",
        "stop"
      ],
      "type": "string"
    },
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "AutomationExecutionLimits": {
      "additionalProperties": false,
      "properties": {
        "maximumOutputBytes": {
          "format": "uint32",
          "maximum": 67108864,
          "minimum": 1,
          "type": "integer"
        },
        "maximumSeconds": {
          "format": "uint32",
          "maximum": 7200,
          "minimum": 1,
          "type": "integer"
        },
        "onInterruption": {
          "$ref": "#/$defs/AutomationInterruption",
          "description": "Cancellation, expiry or uncertain execution can stop this Computer run.\nIts retained files remain. This grants no independent agent Stop action."
        }
      },
      "required": [
        "maximumSeconds",
        "maximumOutputBytes",
        "onInterruption"
      ],
      "type": "object"
    },
    "AutomationGrantCollection": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/AutomationGrantView"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "computerId",
        "grants"
      ],
      "type": "object"
    },
    "AutomationGrantView": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "executionLimits": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutomationExecutionLimits"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "grantId": {
          "format": "uuid",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "oauthClientId": {
          "type": "string"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/AutomationPermission"
          },
          "type": "array",
          "uniqueItems": true
        },
        "principalId": {
          "type": "string"
        },
        "revokedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "computerId",
        "grantId",
        "principalId",
        "oauthClientId",
        "name",
        "permissions",
        "issuedAt",
        "expiresAt"
      ],
      "type": "object"
    },
    "AutomationInterruption": {
      "enum": [
        "stop_computer"
      ],
      "type": "string"
    },
    "AutomationPermission": {
      "enum": [
        "read",
        "execute",
        "start",
        "stop"
      ],
      "type": "string"
    },
    "CapacityAvailability": {
      "enum": [
        "setup_required",
        "available",
        "exhausted",
        "compute_unavailable",
        "storage_unavailable",
        "maintenance"
      ],
      "type": "string"
    },
    "CliPairingChallenge": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "pairingId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "computerId",
        "pairingId",
        "expiresAt"
      ],
      "type": "object"
    },
    "CliPairingConfirmBody": {
      "additionalProperties": false,
      "type": "object"
    },
    "CliPairingInput": {
      "additionalProperties": false,
      "properties": {
        "callbackPort": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1024,
          "type": "integer"
        },
        "code": {
          "pattern": "^[A-HJ-NP-Z2-9]{3}-[A-HJ-NP-Z2-9]{4}$",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "code",
        "callbackPort"
      ],
      "type": "object"
    },
    "CliPairingResult": {
      "additionalProperties": false,
      "properties": {
        "callbackPort": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1024,
          "type": "integer"
        },
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "grantId": {
          "format": "uuid",
          "type": "string"
        },
        "pairingId": {
          "format": "uuid",
          "type": "string"
        },
        "token": {
          "$ref": "#/$defs/CliPairingToken"
        }
      },
      "required": [
        "computerId",
        "pairingId",
        "grantId",
        "token",
        "callbackPort",
        "expiresAt"
      ],
      "type": "object"
    },
    "CliPairingToken": {
      "description": "Only serialize into the one-use no-store response and local callback body.\n\n```compile_fail\nuse veoveo_computers_contract::CliPairingToken;\nfn cannot_log(token: CliPairingToken) { let _ = format!(\"{token:?}\"); }\n```",
      "maxLength": 107,
      "minLength": 107,
      "type": "string"
    },
    "ComputerEvent": {
      "additionalProperties": false,
      "description": "An authorized invalidation; clients reread current state after each event.",
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ComputerEventKind"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ComputerEventKind": {
      "enum": [
        "snapshot_changed"
      ],
      "type": "string"
    },
    "ComputerLimits": {
      "additionalProperties": false,
      "properties": {
        "perOwner": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "perTenant": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "perOwner",
        "perTenant",
        "provider"
      ],
      "type": "object"
    },
    "ComputerPhase": {
      "enum": [
        "reserved",
        "provisioning",
        "starting",
        "ready",
        "stopping",
        "stopped",
        "error",
        "recovery_required"
      ],
      "type": "string"
    },
    "ComputerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/CapacityAvailability"
        },
        "canCreate": {
          "type": "boolean"
        },
        "computers": {
          "items": {
            "$ref": "#/$defs/ComputerView"
          },
          "type": "array"
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputerLimits"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextCursor": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "availability",
        "canCreate",
        "computers"
      ],
      "type": "object"
    },
    "ComputerView": {
      "additionalProperties": false,
      "properties": {
        "activeTaskId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "busy": {
          "type": "boolean"
        },
        "canConnect": {
          "type": "boolean"
        },
        "canCreate": {
          "description": "An authorized reserved Computer can be provisioned once unfenced.",
          "type": "boolean"
        },
        "canDelete": {
          "type": "boolean"
        },
        "canStart": {
          "description": "An authorized stopped Computer can be started once unfenced.",
          "type": "boolean"
        },
        "canStop": {
          "description": "A ready Computer can be stopped once unfenced.",
          "type": "boolean"
        },
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/ComputerPhase"
        },
        "templateId": {
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "computerId",
        "templateId",
        "phase",
        "busy",
        "canCreate",
        "canStart",
        "canStop",
        "canDelete",
        "canConnect",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "CreateInput": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "description": "Continue provisioning an owned reservation, or omit for a new Computer.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "forbidden",
        "not_found",
        "busy",
        "invalid_input",
        "invalid_state",
        "capacity_full",
        "access_limit",
        "storage_unavailable",
        "storage_headroom",
        "template_mismatch",
        "ticket_rejected",
        "unavailable",
        "operation_failed"
      ],
      "type": "string"
    },
    "ExecutionOutput": {
      "additionalProperties": false,
      "description": "Governed occurrence reference. Bytes remain behind Artifact read authority.",
      "properties": {
        "artifactId": {
          "format": "uuid",
          "type": "string"
        },
        "byteCount": {
          "format": "uint32",
          "maximum": 67108864,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifactId",
        "byteCount"
      ],
      "type": "object"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "description": "A known foreground result. Nonzero exit is a completed command with a tool\nerror; it does not imply transport failure or termination of detached children.",
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "executionId": {
          "format": "uuid",
          "type": "string"
        },
        "exitCode": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "stderr": {
          "$ref": "#/$defs/ExecutionOutput"
        },
        "stdout": {
          "$ref": "#/$defs/ExecutionOutput"
        }
      },
      "required": [
        "computerId",
        "executionId",
        "exitCode",
        "stdout",
        "stderr"
      ],
      "type": "object"
    },
    "IssueAutomationGrantInput": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "executionLimits": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutomationExecutionLimits"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "oauthClientId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/AutomationPermission"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "principalId": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "computerId",
        "requestId",
        "principalId",
        "oauthClientId",
        "name",
        "permissions",
        "expiresAt"
      ],
      "type": "object"
    },
    "LifecycleInput": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "computerId",
        "requestId"
      ],
      "type": "object"
    },
    "LifecycleResult": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "operationId": {
          "format": "uuid",
          "type": "string"
        },
        "result_uri": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "computerId",
        "operationId",
        "action"
      ],
      "type": "object"
    },
    "OperationReceipt": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OperationStatus"
        },
        "taskId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "computerId",
        "action",
        "status"
      ],
      "type": "object"
    },
    "OperationStatus": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled",
        "recovery_required"
      ],
      "type": "string"
    },
    "OperationView": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "completedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "computer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputerView"
            },
            {
              "type": "null"
            }
          ]
        },
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiError"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/OperationStatus"
        },
        "taskId": {
          "format": "uuid",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "computerId",
        "action",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "RevokeAccessBody": {
      "additionalProperties": false,
      "type": "object"
    },
    "RevokeAccessInput": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "grantId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "computerId",
        "grantId"
      ],
      "type": "object"
    },
    "RevokeAutomationGrantInput": {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "grantId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "computerId",
        "grantId"
      ],
      "type": "object"
    },
    "StartInput": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId"
      ],
      "type": "object"
    },
    "StopInput": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId"
      ],
      "type": "object"
    },
    "TemplateView": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "homeCapacityMib": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "memoryMib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "templateId": {
          "type": "string"
        }
      },
      "required": [
        "templateId",
        "cpus",
        "memoryMib"
      ],
      "type": "object"
    },
    "TerminalAttach": {
      "additionalProperties": false,
      "description": "The relay enforces version, dimensions and a 1024-byte first-frame bound.",
      "properties": {
        "cols": {
          "format": "uint32",
          "maximum": 500,
          "minimum": 2,
          "type": "integer"
        },
        "computerId": {
          "format": "uuid",
          "type": "string"
        },
        "rows": {
          "format": "uint32",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "token": {
          "$ref": "#/$defs/TerminalToken"
        },
        "type": {
          "$ref": "#/$defs/TerminalAttachKind"
        },
        "version": {
          "format": "uint8",
          "maximum": 2,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "type",
        "computerId",
        "token",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "TerminalAttachKind": {
      "enum": [
        "attach"
      ],
      "type": "string"
    },
    "TerminalLease": {
      "additionalProperties": false,
      "description": "A current service-issued deadline. Relays preserve it and cannot extend it.",
      "properties": {
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/TerminalLeaseKind"
        }
      },
      "required": [
        "type",
        "sequence",
        "expiresAt"
      ],
      "type": "object"
    },
    "TerminalLeaseKind": {
      "enum": [
        "lease"
      ],
      "type": "string"
    },
    "TerminalReady": {
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TerminalReadyKind"
        },
        "version": {
          "format": "uint8",
          "maximum": 2,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "type",
        "expiresAt"
      ],
      "type": "object"
    },
    "TerminalReadyKind": {
      "enum": [
        "ready"
      ],
      "type": "string"
    },
    "TerminalReplayComplete": {
      "additionalProperties": false,
      "description": "This fence is not permission to send input until historical rendering drains.",
      "properties": {
        "type": {
          "$ref": "#/$defs/TerminalReplayCompleteKind"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "TerminalReplayCompleteKind": {
      "enum": [
        "replay_complete"
      ],
      "type": "string"
    },
    "TerminalResize": {
      "additionalProperties": false,
      "properties": {
        "cols": {
          "format": "uint32",
          "maximum": 500,
          "minimum": 2,
          "type": "integer"
        },
        "rows": {
          "format": "uint32",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
