{
  "$defs": {
    "AgentConversationEntry": {
      "additionalProperties": false,
      "description": "One actor-attributed projection of durable agent runtime state.\n\nConversation entries are not a second source of truth. Operator entries\nproject durable wakes and agent entries project durable episodes.",
      "properties": {
        "actorId": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "entryId": {
          "type": "string"
        },
        "episodeId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "inReplyToRequestIds": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "occurredAt": {
          "format": "date-time",
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/AgentConversationRole"
        },
        "state": {
          "$ref": "#/$defs/AgentConversationEntryState"
        },
        "wakeId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "entryId",
        "role",
        "actorId",
        "content",
        "state",
        "occurredAt"
      ],
      "type": "object"
    },
    "AgentConversationEntryState": {
      "enum": [
        "accepted",
        "running",
        "completed",
        "budget_terminated",
        "stopped",
        "failed"
      ],
      "type": "string"
    },
    "AgentConversationRole": {
      "enum": [
        "operator",
        "agent"
      ],
      "type": "string"
    },
    "AgentConversationView": {
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/AgentConversationEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "agentId",
        "entries"
      ],
      "type": "object"
    },
    "AgentInputRequestDecision": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "accept",
              "type": "string"
            },
            "content": {
              "default": null
            },
            "requestId": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "action",
            "requestId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "decline",
              "type": "string"
            },
            "requestId": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "action",
            "requestId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "cancel",
              "type": "string"
            },
            "requestId": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "action",
            "requestId"
          ],
          "type": "object"
        }
      ]
    },
    "AgentInputRequestView": {
      "additionalProperties": false,
      "properties": {
        "inputRequestId": {
          "format": "uuid",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "requestedAt": {
          "format": "date-time",
          "type": "string"
        },
        "requestedSchema": true
      },
      "required": [
        "inputRequestId",
        "message",
        "requestedAt"
      ],
      "type": "object"
    },
    "AgentOperatorMessageRequest": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "requestId": {
          "description": "Client-generated UUIDv7 used as the durable retry identity.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "message"
      ],
      "type": "object"
    },
    "AgentWakeReceipt": {
      "additionalProperties": false,
      "properties": {
        "acceptedAt": {
          "format": "date-time",
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        },
        "wakeId": {
          "format": "uuid",
          "type": "string"
        },
        "workContext": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "wakeId",
        "agentId",
        "workContext",
        "acceptedAt"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Source-owner operator-control contracts consumed by browser clients.",
  "properties": {
    "conversation": {
      "$ref": "#/$defs/AgentConversationView"
    },
    "decision": {
      "$ref": "#/$defs/AgentInputRequestDecision"
    },
    "inputRequest": {
      "$ref": "#/$defs/AgentInputRequestView"
    },
    "message": {
      "$ref": "#/$defs/AgentOperatorMessageRequest"
    },
    "receipt": {
      "$ref": "#/$defs/AgentWakeReceipt"
    }
  },
  "required": [
    "message",
    "decision",
    "receipt",
    "inputRequest",
    "conversation"
  ],
  "title": "AgentControlSchema",
  "type": "object"
}
