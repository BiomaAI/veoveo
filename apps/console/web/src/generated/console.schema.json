{
  "$defs": {
    "AccessLevel": {
      "description": "A capability level. Ordered `Read < Write < Admin`, so `min` yields the\nlesser privilege — exactly what capping a group role by a grant level needs.",
      "enum": [
        "read",
        "write",
        "admin"
      ],
      "type": "string"
    },
    "AccessRequestEvent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactAccessRequestId"
            },
            "op": {
              "const": "changed",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "AccessSubject": {
      "description": "A principal or group that can own governed data or receive access.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "const": "principal",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/GroupId"
            },
            "kind": {
              "const": "group",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "AgentEvent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "upsert",
              "type": "string"
            },
            "row": {
              "$ref": "#/$defs/AgentSummary"
            }
          },
          "required": [
            "op",
            "row"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "op": {
              "const": "delete",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "AgentState": {
      "enum": [
        "idle",
        "running",
        "waiting",
        "disabled",
        "failed"
      ],
      "type": "string"
    },
    "AgentSummary": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lastEpisodeAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "pendingWakes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "profile": {
          "$ref": "#/$defs/GatewayProfileId"
        },
        "runnerLeaseExpiresAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        }
      },
      "required": [
        "id",
        "name",
        "profile",
        "state",
        "pendingWakes",
        "detail"
      ],
      "type": "object"
    },
    "ArtifactAccessDenialReason": {
      "enum": [
        "tenant_boundary",
        "clearance",
        "need_to_know"
      ],
      "type": "string"
    },
    "ArtifactAccessRequestId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_artifact_contract::ledger"
              },
              "profile": "ArtifactAccessRequestId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "type": "string"
    },
    "ArtifactAccessSource": {
      "description": "Access origin determines the domain of the subject identifier.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "principal_grant",
              "type": "string"
            },
            "level": {
              "$ref": "#/$defs/AccessLevel"
            },
            "subject": {
              "$ref": "#/$defs/PrincipalId"
            }
          },
          "required": [
            "kind",
            "subject",
            "level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "group_grant",
              "type": "string"
            },
            "level": {
              "$ref": "#/$defs/AccessLevel"
            },
            "subject": {
              "$ref": "#/$defs/GroupId"
            }
          },
          "required": [
            "kind",
            "subject",
            "level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "work_context",
              "type": "string"
            },
            "level": {
              "$ref": "#/$defs/AccessLevel"
            },
            "subject": {
              "$ref": "#/$defs/WorkContextId"
            }
          },
          "required": [
            "kind",
            "subject",
            "level"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactEffectiveAccessSummary": {
      "additionalProperties": false,
      "properties": {
        "admin": {
          "type": "boolean"
        },
        "clearanceSatisfied": {
          "type": "boolean"
        },
        "denialReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactAccessDenialReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "read": {
          "type": "boolean"
        },
        "requestable": {
          "type": "boolean"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ArtifactAccessSource"
          },
          "type": "array"
        },
        "write": {
          "type": "boolean"
        }
      },
      "required": [
        "read",
        "write",
        "admin",
        "clearanceSatisfied",
        "requestable",
        "sources"
      ],
      "type": "object"
    },
    "ArtifactEvent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "upsert",
              "type": "string"
            },
            "row": {
              "$ref": "#/$defs/ArtifactSummary"
            }
          },
          "required": [
            "op",
            "row"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "op": {
              "const": "delete",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactGovernanceSummary": {
      "additionalProperties": false,
      "properties": {
        "delegationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/DelegationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "initiator": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocationMode": {
          "$ref": "#/$defs/InvocationMode"
        },
        "policyRevision": {
          "$ref": "#/$defs/PolicyVersion"
        },
        "producer": {
          "$ref": "#/$defs/PrincipalId"
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        }
      },
      "required": [
        "workContext",
        "producer",
        "invocationMode",
        "policyRevision"
      ],
      "type": "object"
    },
    "ArtifactGrantSummaryValue": {
      "description": "Grant kind and subject cannot disagree inside a usable wire value.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "createdAt": {
              "format": "date-time",
              "type": "string"
            },
            "expiresAt": {
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "labels": {
              "items": {
                "$ref": "#/$defs/DataLabelId"
              },
              "type": "array"
            },
            "permission": {
              "$ref": "#/$defs/AccessLevel"
            },
            "subject": {
              "$ref": "#/$defs/PrincipalId"
            },
            "subjectKind": {
              "const": "principal",
              "type": "string"
            }
          },
          "required": [
            "subjectKind",
            "subject",
            "permission",
            "labels",
            "createdAt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "createdAt": {
              "format": "date-time",
              "type": "string"
            },
            "expiresAt": {
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "labels": {
              "items": {
                "$ref": "#/$defs/DataLabelId"
              },
              "type": "array"
            },
            "permission": {
              "$ref": "#/$defs/AccessLevel"
            },
            "subject": {
              "$ref": "#/$defs/GroupId"
            },
            "subjectKind": {
              "const": "group",
              "type": "string"
            }
          },
          "required": [
            "subjectKind",
            "subject",
            "permission",
            "labels",
            "createdAt"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_artifact_contract::identity"
              },
              "profile": "ArtifactId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Canonical identity of one logical artifact occurrence. Every put creates a\nfresh UUIDv7 even when its bytes deduplicate to an existing tenant blob.",
      "type": "string"
    },
    "ArtifactRecordingSummary": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/RecordingArtifactProvenanceKind"
        },
        "layerId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingLayerId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": [
            "string",
            "null"
          ]
        },
        "ordinal": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "recordingId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        }
      },
      "required": [
        "recordingId",
        "kind"
      ],
      "type": "object"
    },
    "ArtifactReleaseState": {
      "enum": [
        "private",
        "releasable",
        "released"
      ],
      "type": "string"
    },
    "ArtifactShareLinkId": {
      "description": "Identity of an expiring Artifact share, distinct from an occurrence.\n```compile_fail\nuse veoveo_artifact_contract::{ArtifactId, ArtifactShareLinkId};\nfn revoke(_: ArtifactShareLinkId) {}\nrevoke(ArtifactId::new());\n```",
      "type": "string"
    },
    "ArtifactShareLinkSummary": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "downloadCount": {
          "format": "int64",
          "type": "integer"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ArtifactShareLinkId"
        },
        "maxDownloads": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "permission": {
          "$ref": "#/$defs/AccessLevel"
        },
        "revokedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "permission",
        "expiresAt",
        "downloadCount",
        "createdAt",
        "active"
      ],
      "type": "object"
    },
    "ArtifactSummary": {
      "additionalProperties": false,
      "properties": {
        "activeLinks": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "authorizedGrants": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "byteLength": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "classification": {
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "effectiveAccess": {
          "$ref": "#/$defs/ArtifactEffectiveAccessSummary"
        },
        "filename": {
          "type": "string"
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/ArtifactGrantSummaryValue"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/DataLabelId"
          },
          "type": "array"
        },
        "mediaType": {
          "type": "string"
        },
        "outputOwner": {
          "$ref": "#/$defs/AccessSubject"
        },
        "owner": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ArtifactGovernanceSummary"
        },
        "recording": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRecordingSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "releaseState": {
          "$ref": "#/$defs/ArtifactReleaseState"
        },
        "retentionExpiresAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "shareLinks": {
          "items": {
            "$ref": "#/$defs/ArtifactShareLinkSummary"
          },
          "type": "array"
        },
        "taskId": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "filename",
        "mediaType",
        "byteLength",
        "owner",
        "outputOwner",
        "provenance",
        "effectiveAccess",
        "classification",
        "labels",
        "releaseState",
        "authorizedGrants",
        "activeLinks",
        "grants",
        "shareLinks",
        "createdAt"
      ],
      "type": "object"
    },
    "ConsoleBootstrap": {
      "additionalProperties": false,
      "properties": {
        "canReadAudit": {
          "type": "boolean"
        },
        "canReadInstallation": {
          "type": "boolean"
        },
        "installation": {
          "$ref": "#/$defs/ConsoleInstallation"
        },
        "profile": {
          "$ref": "#/$defs/GatewayProfileId"
        },
        "session": {
          "$ref": "#/$defs/ConsoleSession"
        }
      },
      "required": [
        "profile",
        "installation",
        "session",
        "canReadInstallation",
        "canReadAudit"
      ],
      "type": "object"
    },
    "ConsoleInstallation": {
      "additionalProperties": false,
      "properties": {
        "accentColor": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "logo": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "offlineMode": {
          "type": "boolean"
        },
        "productLabel": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "productLabel",
        "version",
        "offlineMode",
        "generatedAt"
      ],
      "type": "object"
    },
    "ConsoleSession": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "$ref": "#/$defs/PrincipalId"
        },
        "availableTenants": {
          "items": {
            "$ref": "#/$defs/ConsoleTenant"
          },
          "type": "array"
        },
        "displayName": {
          "type": "string"
        },
        "invocationMode": {
          "$ref": "#/$defs/InvocationMode"
        },
        "membership": {
          "$ref": "#/$defs/WorkContextMembershipLevel"
        },
        "principalId": {
          "$ref": "#/$defs/PrincipalId"
        },
        "tenantId": {
          "$ref": "#/$defs/TenantId"
        },
        "tenantName": {
          "type": "string"
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        },
        "workContextTitle": {
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "principalId",
        "actorId",
        "tenantId",
        "tenantName",
        "workContext",
        "workContextTitle",
        "membership",
        "invocationMode",
        "availableTenants"
      ],
      "type": "object"
    },
    "ConsoleSnapshot": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentSummary"
          },
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactSummary"
          },
          "type": "array"
        },
        "installation": {
          "$ref": "#/$defs/ConsoleInstallation"
        },
        "policies": {
          "items": {
            "$ref": "#/$defs/PolicySummary"
          },
          "type": "array"
        },
        "principals": {
          "items": {
            "$ref": "#/$defs/PrincipalSummary"
          },
          "type": "array"
        },
        "recordings": {
          "items": {
            "$ref": "#/$defs/RecordingSummary"
          },
          "type": "array"
        },
        "servers": {
          "items": {
            "$ref": "#/$defs/ServerSummary"
          },
          "type": "array"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceSummary"
          },
          "type": "array"
        },
        "session": {
          "$ref": "#/$defs/ConsoleSession"
        },
        "stream": {
          "$ref": "#/$defs/StreamInfo"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "installation",
        "session",
        "principals",
        "stream",
        "services",
        "tasks",
        "artifacts",
        "agents",
        "recordings",
        "servers",
        "policies"
      ],
      "type": "object"
    },
    "ConsoleTenant": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/TenantId"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "DataLabelId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "DataLabelId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Policy data label such as `cui`, `itar`, `pii`, or an IdP-provided clearance label.",
      "type": "string"
    },
    "DelegationId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "DelegationId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Auditable identity of authority delegated by an initiator to another actor.",
      "type": "string"
    },
    "GatewayProfileId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::platform_names"
              },
              "profile": "GatewayProfileId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Veoveo profile id exposed under `/mcp/{profile}`.",
      "type": "string"
    },
    "GatewayServerHealthState": {
      "enum": [
        "healthy",
        "degraded",
        "offline"
      ],
      "type": "string"
    },
    "GroupId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "GroupId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Identity-provider group identifier used by gateway policy.",
      "type": "string"
    },
    "InvocationMode": {
      "description": "How the current actor obtained authority to perform the work.",
      "enum": [
        "direct",
        "delegated",
        "automated"
      ],
      "type": "string"
