{
  "$defs": {
    "AccessSubject": {
      "description": "A principal or group that can own governed data or receive access.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "const": "principal",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/GroupId"
            },
            "kind": {
              "const": "group",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_artifact_contract::identity"
              },
              "profile": "ArtifactId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Canonical identity of one logical artifact occurrence. Every put creates a\nfresh UUIDv7 even when its bytes deduplicate to an existing tenant blob.",
      "type": "string"
    },
    "ArtifactMetadata": {
      "additionalProperties": false,
      "description": "Canonical metadata for an artifact managed by a server-owned store.\n\n`artifact_uri` is the protocol identity (`{scheme}://artifact/{artifact_id}`).\n`download_url` is optional bulk-transfer plumbing for large artifacts and\nmust not become a discovery API.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId"
        },
        "artifactUri": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "byteLen": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "compliance": {
          "$ref": "#/$defs/ComplianceMetadata",
          "default": {}
        },
        "createdAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": "string"
        },
        "downloadUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "filename": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "default": null
        },
        "mimeType": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "releaseState": {
          "$ref": "#/$defs/ArtifactReleaseState",
          "default": "private"
        }
      },
      "required": [
        "artifactId",
        "byteLen",
        "artifactUri",
        "createdAt"
      ],
      "type": "object"
    },
    "ArtifactProvenance": {
      "description": "Immutable explanation of how an artifact came into being.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "delegationId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NoIdentity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "initiator": {
              "$ref": "#/$defs/PrincipalId"
            },
            "invocationMode": {
              "const": "direct",
              "type": "string"
            },
            "policyRevision": {
              "$ref": "#/$defs/PolicyVersion"
            },
            "producer": {
              "$ref": "#/$defs/PrincipalId"
            }
          },
          "required": [
            "invocationMode",
            "producer",
            "initiator",
            "policyRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "delegationId": {
              "$ref": "#/$defs/DelegationId"
            },
            "initiator": {
              "$ref": "#/$defs/PrincipalId"
            },
            "invocationMode": {
              "const": "delegated",
              "type": "string"
            },
            "policyRevision": {
              "$ref": "#/$defs/PolicyVersion"
            },
            "producer": {
              "$ref": "#/$defs/PrincipalId"
            }
          },
          "required": [
            "invocationMode",
            "producer",
            "initiator",
            "delegationId",
            "policyRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "delegationId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NoIdentity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "initiator": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NoIdentity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "invocationMode": {
              "const": "automated",
              "type": "string"
            },
            "policyRevision": {
              "$ref": "#/$defs/PolicyVersion"
            },
            "producer": {
              "$ref": "#/$defs/PrincipalId"
            }
          },
          "required": [
            "invocationMode",
            "producer",
            "policyRevision"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactReleaseState": {
      "enum": [
        "private",
        "releasable",
        "released"
      ],
      "type": "string"
    },
    "ArtifactUri": {
      "description": "Neutral or server-presented Artifact occurrence URI.",
      "type": "string"
    },
    "ComplianceMetadata": {
      "additionalProperties": false,
      "description": "Compliance and tenancy labels that travel with server-owned artifacts.\n\nObject metadata is not the only authorization source; servers should keep\nowner rows for task/artifact access checks. These typed fields keep exported\nartifact metadata aligned with the gateway principal and policy model.",
      "properties": {
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataLabelId"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataLabels": {
          "items": {
            "$ref": "#/$defs/DataLabelId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessSubject"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "retentionExpiresAt": {
          "description": "RFC3339 timestamps with Chrono signed extended years and leap-second nanoseconds; receiving calendar and chronology admission is required.",
          "pattern": "^([+-][0-9]{4,6}|[0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "type": [
            "string",
            "null"
          ]
        },
        "tenantId": {
          "anyOf": [
            {
              "$ref": "#/$defs/TenantId"
            },
            {
              "type": "null"
            }
          ]
        },
        "workContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkContextId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "DataLabelId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "DataLabelId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Policy data label such as `cui`, `itar`, `pii`, or an IdP-provided clearance label.",
      "type": "string"
    },
    "DelegationId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "DelegationId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Auditable identity of authority delegated by an initiator to another actor.",
      "type": "string"
    },
    "DictationId": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/DictationSessionId"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DictationSessionId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_speech_contract::identity"
              },
              "profile": "DictationSessionId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "format": "uuid",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "DictationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/DictationSessionId"
        },
        "maxDurationSeconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "nextSequence": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "resultUri": {
          "$ref": "#/$defs/DictationUri"
        },
        "status": {
          "$ref": "#/$defs/DictationStatus"
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transcript"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "resultUri",
        "status",
        "nextSequence",
        "maxDurationSeconds"
      ],
      "type": "object"
    },
    "DictationStatus": {
      "enum": [
        "listening",
        "flushing",
        "completed",
        "cancelled",
        "failed"
      ],
      "type": "string"
    },
    "DictationUri": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar resource schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_speech_contract::resources"
              },
              "profile": "DictationUri",
              "version": "unversioned"
            },
            "kind": "owner_resource"
          }
        }
      },
      "pattern": "^speech://dictation/[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "type": "string"
    },
    "GroupId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "GroupId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Identity-provider group identifier used by gateway policy.",
      "type": "string"
    },
    "NoIdentity": false,
    "PolicyVersion": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "PolicyVersion",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Immutable policy version identifier emitted with decisions and audit records.",
      "type": "string"
    },
    "PrincipalId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "PrincipalId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Stable authenticated user or service-principal identity.",
      "type": "string"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "double",
          "type": "number"
        },
        "start": {
          "format": "double",
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/Word"
          },
          "type": "array"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "words"
      ],
      "type": "object"
    },
    "StartDictation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/DictationSessionId"
        },
        "sampleRate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "sampleRate"
      ],
      "type": "object"
    },
    "TenantId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "TenantId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Tenant, organization, or customer boundary identifier.",
      "type": "string"
    },
    "TranscribeRequest": {
      "additionalProperties": false,
      "properties": {
        "artifactUri": {
          "$ref": "#/$defs/ArtifactUri",
          "description": "`artifact://` URI of an uploaded audio or video file you can read."
        }
      },
      "required": [
        "artifactUri"
      ],
      "type": "object"
    },
    "Transcript": {
      "additionalProperties": false,
      "properties": {
        "durationSeconds": {
          "format": "double",
          "type": "number"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "durationSeconds",
        "segments"
      ],
      "type": "object"
    },
    "TranscriptDocument": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "modelRevision": {
          "type": "string"
        },
        "schema": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "grammar": "format_tag",
                "kind": "builtin"
              }
            }
          },
          "const": "veoveo.ai/speech-transcript/v2",
          "type": "string"
        },
        "sourceArtifactUri": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "sourceSha256": {
          "$ref": "#/$defs/UploadSha256"
        },
        "transcript": {
          "$ref": "#/$defs/Transcript"
        }
      },
      "required": [
        "schema",
        "sourceArtifactUri",
        "sourceSha256",
        "model",
        "modelRevision",
        "transcript"
      ],
      "type": "object"
    },
    "TranscriptionOutput": {
      "additionalProperties": false,
      "properties": {
        "captions": {
          "$ref": "#/$defs/ArtifactMetadata"
        },
        "durationSeconds": {
          "format": "double",
          "type": "number"
        },
        "resultUri": {
          "$ref": "#/$defs/TranscriptionUri"
        },
        "sourceArtifactUri": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "transcript": {
          "$ref": "#/$defs/ArtifactMetadata"
        }
      },
      "required": [
        "resultUri",
        "sourceArtifactUri",
        "transcript",
        "captions",
        "durationSeconds"
      ],
      "type": "object"
    },
    "TranscriptionUri": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar resource schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_speech_contract::resources"
              },
              "profile": "TranscriptionUri",
              "version": "unversioned"
            },
            "kind": "owner_resource"
          }
        }
      },
      "pattern": "^speech://transcript/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "type": "string"
    },
    "UploadSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Word": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "double",
          "type": "number"
        },
        "start": {
          "format": "double",
          "type": "number"
        },
        "word": {
          "type": "string"
        }
      },
      "required": [
        "word",
        "start",
        "end"
      ],
      "type": "object"
    },
    "WorkContextId": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "declaration": {
              "applicability": "the declared scalar identity schema",
              "authority": {
                "kind": "owner",
                "module": "veoveo_types::identity"
              },
              "profile": "WorkContextId",
              "version": "unversioned"
            },
            "kind": "owner_identity"
          }
        }
      },
      "description": "Tenant-local boundary that governs related work and every output it produces.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "dictation": {
      "$ref": "#/$defs/DictationSnapshot"
    },
    "dictationId": {
      "$ref": "#/$defs/DictationId"
    },
    "document": {
      "$ref": "#/$defs/TranscriptDocument"
    },
    "output": {
      "$ref": "#/$defs/TranscriptionOutput"
    },
    "startDictation": {
      "$ref": "#/$defs/StartDictation"
    },
    "transcribe": {
      "$ref": "#/$defs/TranscribeRequest"
    }
  },
  "required": [
    "startDictation",
    "dictationId",
    "dictation",
    "transcribe",
    "output",
    "document"
  ],
  "title": "SchemaBundle",
  "type": "object"
}
