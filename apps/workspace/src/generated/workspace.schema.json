      "properties": {
        "definition": {
          "type": "string"
        }
      },
      "required": [
        "definition"
      ],
      "type": "object"
    },
    "AgentActivity": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/ChatAgent"
          },
          "type": "array"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/Run"
          },
          "type": "array"
        }
      },
      "required": [
        "agents",
        "runs"
      ],
      "type": "object"
    },
    "AgentDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "model": {
          "type": "string"
