{
  "$defs": {
    "AddAgent": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "type": "string"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "definition",
        "revision"
      ],
      "type": "object"
    },
    "AgentActivity": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/ChatAgent"
          },
          "type": "array"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/Run"
          },
          "type": "array"
        }
      },
      "required": [
        "agents",
        "runs"
      ],
      "type": "object"
    },
    "AgentCatalogPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AgentDefinition"
          },
          "type": "array"
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "AgentDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/GatewayToolName"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "provider",
        "model",
        "revision",
        "tools"
      ],
      "type": "object"
    },
    "AgentModelId": {
      "type": "string"
    },
    "AgentRevisionPreview": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "$ref": "#/$defs/AgentRevisionView"
        },
        "target": {
          "$ref": "#/$defs/AgentRevisionView"
        }
      },
      "required": [
        "current",
        "target"
      ],
      "type": "object"
    },
    "AgentRevisionView": {
      "additionalProperties": false,
      "properties": {
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        },
        "instructionsDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelReference"
        },
        "publishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "publishedBy": {
          "$ref": "#/$defs/PersonId"
        },
        "publishedByName": {
          "type": "string"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/GatewayToolName"
          },
          "type": "array"
        }
      },
      "required": [
        "revision",
        "model",
        "tools",
        "budgets",
        "instructionsDigest",
        "publishedBy",
        "publishedByName",
        "publishedAt"
      ],
      "type": "object"
    },
    "AnswerOperation": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/InputAnswer"
          },
          "type": "array"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "answers"
      ],
      "type": "object"
    },
    "AppOperationView": {
      "additionalProperties": false,
      "properties": {
        "native": {
          "description": "Native MCP 2026-07-28 result, validated by the pinned App protocol adapter."
        },
        "operation": {
          "$ref": "#/$defs/OperationSummary"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "AppOrigin": {
      "additionalProperties": false,
      "properties": {
        "appUri": {
          "type": "string"
        }
      },
      "required": [
        "appUri"
      ],
      "type": "object"
    },
    "AppTaskRequest": {
      "additionalProperties": false,
      "properties": {
        "appUri": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "appUri",
        "taskId"
      ],
      "type": "object"
    },
    "ArtifactId": {
      "description": "Canonical identity of one logical artifact occurrence. Every put creates a\nfresh UUIDv7 even when its bytes deduplicate to an existing tenant blob.",
      "type": "string"
    },
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "deadlineSeconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxCompletionCalls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxOutputTokens": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxToolCalls": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maxOutputTokens",
        "maxCompletionCalls",
        "maxToolCalls",
        "deadlineSeconds"
      ],
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputSchema": {
          "description": "A domain-owned JSON Schema, not a Workspace-controlled record shape."
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "inputSchema"
      ],
      "type": "object"
    },
    "Chat": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "membersCanInvite": {
          "type": "boolean"
        },
        "owner": {
          "$ref": "#/$defs/PersonId"
        },
        "participation": {
          "$ref": "#/$defs/Participation"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "sequence": {
          "format": "int64",
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "owner",
        "archived",
        "membersCanInvite",
        "participation",
        "sequence",
        "revision",
        "updatedAt"
      ],
      "type": "object"
    },
    "ChatAgent": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "definition": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "definition",
        "name",
        "provider",
        "model",
        "revision",
        "active"
      ],
      "type": "object"
    },
    "ChatAttachment": {
      "description": "Human-published references and labels. Neither the reference nor chat membership grants reads.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "ChatSettings": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "expectedRevision": {
          "format": "int64",
          "type": "integer"
        },
        "membersCanInvite": {
          "type": "boolean"
        },
        "owner": {
          "$ref": "#/$defs/PersonId"
        },
        "participation": {
          "$ref": "#/$defs/Participation"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "expectedRevision",
        "title",
        "archived",
        "membersCanInvite",
        "participation",
        "owner"
      ],
      "type": "object"
    },
    "ChatSnapshot": {
      "additionalProperties": false,
      "properties": {
        "chat": {
          "$ref": "#/$defs/Chat"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/Member"
          },
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        }
      },
      "required": [
        "chat",
        "members",
        "messages"
      ],
      "type": "object"
    },
    "ChatWake": {
      "additionalProperties": false,
      "description": "A wake identifies only a committed chat head. Consumers fetch authorized\nstate; invitation metadata and private capability results are not broadcast.",
      "properties": {
        "sequence": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "sequence"
      ],
      "type": "object"
    },
    "CreateChat": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "DecideInvitation": {
      "additionalProperties": false,
      "properties": {
        "chatId": {
          "format": "uuid",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/InvitationState"
        }
      },
      "required": [
        "chatId",
        "state"
      ],
      "type": "object"
    },
    "GatewayToolName": {
      "description": "Gateway-scoped tool name after server namespace projection.",
      "type": "string"
    },
    "InputAnswer": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "additionalProperties": true,
          "description": "A domain's elicitation form can have different primitive fields.",
          "type": [
            "object",
            "null"
          ]
        },
        "decision": {
          "$ref": "#/$defs/InputDecision"
        },
        "digest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "digest",
        "decision"
      ],
      "type": "object"
    },
    "InputDecision": {
      "enum": [
        "accept",
        "decline",
        "cancel"
      ],
      "type": "string"
    },
    "InputKind": {
      "enum": [
        "form",
        "link",
        "unsupported"
      ],
      "type": "string"
    },
    "Invitation": {
      "additionalProperties": false,
      "properties": {
        "chatId": {
          "format": "uuid",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "invitee": {
          "$ref": "#/$defs/PersonId"
        },
        "inviter": {
          "$ref": "#/$defs/PersonId"
        },
        "state": {
          "$ref": "#/$defs/InvitationState"
        }
      },
      "required": [
        "id",
        "chatId",
        "inviter",
        "invitee",
        "state",
        "expiresAt"
      ],
      "type": "object"
    },
    "InvitationState": {
      "enum": [
        "pending",
        "accepted",
        "declined",
        "revoked"
      ],
      "type": "string"
    },
    "InvitationSummary": {
      "additionalProperties": false,
      "properties": {
        "chatTitle": {
          "type": "string"
        },
        "invitation": {
          "$ref": "#/$defs/Invitation"
        },
        "inviterName": {
          "type": "string"
        }
      },
      "required": [
        "invitation",
        "chatTitle",
        "inviterName"
      ],
      "type": "object"
    },
    "InvitePerson": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "invitee": {
          "$ref": "#/$defs/PersonId"
        }
      },
      "required": [
        "id",
        "invitee"
      ],
      "type": "object"
    },
    "Member": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "person": {
          "$ref": "#/$defs/Person"
        }
      },
      "required": [
        "id",
        "person",
        "active"
      ],
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "addressedAgents": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/ChatAttachment"
          },
          "type": "array"
        },
        "author": {
          "format": "uuid",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "replyContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReplyContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "replyTo": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReplyTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "responseAgents": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "sequence": {
          "format": "int64",
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "author",
        "text",
        "attachments",
        "addressedAgents",
        "responseAgents",
        "sequence",
        "createdAt"
      ],
      "type": "object"
    },
    "ModelReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/AgentModelId"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "OperationAgent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "OperationImage": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "description": "Validated standard base64; the complete result admits at most eight\nimages and 1 MiB of encoded image data.",
          "type": "string"
        },
        "mimeType": {
          "$ref": "#/$defs/ResultImageMime"
        }
      },
      "required": [
        "mimeType",
        "data"
      ],
      "type": "object"
    },
    "OperationInput": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "id": {
          "description": "Native request key plus content digest fences a stale rendered form.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "message": {
          "type": "string"
        },
        "schema": true,
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "digest",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "OperationPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/OperationSummary"
          },
          "type": "array"
        },
        "next": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "OperationPhase": {
      "enum": [
        "dispatching",
        "input_required",
        "task",
        "completed",
        "failed",
        "unconfirmed"
      ],
      "type": "string"
    },
    "OperationProgress": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "format": "double",
          "type": "number"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "total": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "completed"
      ],
      "type": "object"
    },
    "OperationResource": {
      "additionalProperties": false,
      "properties": {
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "name"
      ],
      "type": "object"
    },
    "OperationResult": {
      "additionalProperties": false,
      "properties": {
        "images": {
          "items": {
            "$ref": "#/$defs/OperationImage"
          },
          "type": "array"
        },
        "isError": {
          "type": "boolean"
        },
        "omittedImages": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/OperationResource"
          },
          "type": "array"
        },
        "structured": true,
        "text": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "isError",
        "text",
        "resources",
        "images",
        "omittedImages"
      ],
      "type": "object"
    },
    "OperationSummary": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationAgent"
            },
            {
              "type": "null"
            }
          ]
        },
        "chatId": {
          "format": "uuid",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/OperationPhase"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "runId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "chatId",
        "tool",
        "phase",
        "revision",
        "createdAt"
      ],
      "type": "object"
    },
    "OperationView": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/OperationInput"
          },
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/OperationSummary"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationProgress"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "inputs"
      ],
      "type": "object"
    },
    "Participation": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/ParticipationMode"
        }
      },
      "required": [
        "mode",
        "agents"
      ],
      "type": "object"
    },
    "ParticipationMode": {
      "description": "Human-message response policy. Agent output never triggers participation.",
      "enum": [
        "on_request",
        "default",
        "automatic"
      ],
      "type": "string"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/PersonId"
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "type": "object"
    },
    "PersonId": {
      "description": "Installation-local human identity; never an email address or bearer credential.",
      "format": "uuid",
      "type": "string"
    },
    "PersonalEvent": {
      "description": "Actor-private observation. No Task payload or shared-chat content is included.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "invitations": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "inventory",
              "type": "string"
            },
            "limited": {
              "type": "boolean"
            },
            "operations": {
              "items": {
                "$ref": "#/$defs/PersonalOperation"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "operations",
            "invitations",
            "limited"
          ],
