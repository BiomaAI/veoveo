        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "provider",
        "model"
      ],
      "type": "object"
    },
    "AnswerOperation": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/InputAnswer"
          },
          "type": "array"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "answers"
      ],
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
