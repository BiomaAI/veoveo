        "inputSchema": {
          "description": "A domain-owned JSON Schema, not a Workspace-controlled record shape."
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "inputSchema"
      ],
      "type": "object"
    },
    "Chat": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "membersCanInvite": {
          "type": "boolean"
        },
        "owner": {
          "$ref": "#/$defs/PersonId"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "sequence": {
          "format": "int64",
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "owner",
        "archived",
        "membersCanInvite",
        "sequence",
        "revision",
        "updatedAt"
      ],
      "type": "object"
    },
    "ChatAgent": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "definition": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "definition",
        "name",
        "provider",
        "model",
        "active"
      ],
      "type": "object"
    },
    "ChatSettings": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "expectedRevision": {
          "format": "int64",
          "type": "integer"
        },
        "membersCanInvite": {
          "type": "boolean"
        },
        "owner": {
          "$ref": "#/$defs/PersonId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "expectedRevision",
        "title",
        "archived",
        "membersCanInvite",
        "owner"
      ],
      "type": "object"
    },
    "ChatSnapshot": {
      "additionalProperties": false,
      "properties": {
        "chat": {
          "$ref": "#/$defs/Chat"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/Member"
          },
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        }
      },
      "required": [
        "chat",
        "members",
        "messages"
      ],
      "type": "object"
    },
    "ChatWake": {
      "additionalProperties": false,
      "description": "A wake identifies only a committed chat head. Consumers fetch authorized\nstate; invitation metadata and private capability results are not broadcast.",
      "properties": {
        "sequence": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "sequence"
      ],
      "type": "object"
    },
    "CreateChat": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "DecideInvitation": {
      "additionalProperties": false,
      "properties": {
        "chatId": {
          "format": "uuid",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/InvitationState"
        }
      },
      "required": [
        "chatId",
        "state"
      ],
      "type": "object"
    },
    "InputAnswer": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "additionalProperties": true,
          "description": "A domain's elicitation form can have different primitive fields.",
          "type": [
            "object",
            "null"
          ]
        },
        "decision": {
          "$ref": "#/$defs/InputDecision"
        },
        "digest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "digest",
        "decision"
      ],
      "type": "object"
    },
    "InputDecision": {
      "enum": [
        "accept",
        "decline",
        "cancel"
      ],
      "type": "string"
    },
    "InputKind": {
      "enum": [
        "form",
        "link",
        "unsupported"
      ],
      "type": "string"
    },
    "Invitation": {
      "additionalProperties": false,
      "properties": {
        "chatId": {
          "format": "uuid",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "invitee": {
          "$ref": "#/$defs/PersonId"
        },
        "inviter": {
          "$ref": "#/$defs/PersonId"
        },
        "state": {
          "$ref": "#/$defs/InvitationState"
        }
      },
      "required": [
        "id",
        "chatId",
        "inviter",
        "invitee",
        "state",
        "expiresAt"
      ],
      "type": "object"
    },
    "InvitationState": {
      "enum": [
        "pending",
        "accepted",
        "declined",
        "revoked"
      ],
      "type": "string"
    },
    "InvitationSummary": {
      "additionalProperties": false,
      "properties": {
        "chatTitle": {
          "type": "string"
        },
        "invitation": {
          "$ref": "#/$defs/Invitation"
        },
        "inviterName": {
          "type": "string"
        }
      },
      "required": [
        "invitation",
        "chatTitle",
        "inviterName"
      ],
      "type": "object"
    },
    "InvitePerson": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "invitee": {
          "$ref": "#/$defs/PersonId"
        }
      },
      "required": [
        "id",
        "invitee"
      ],
      "type": "object"
    },
    "Member": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "person": {
          "$ref": "#/$defs/Person"
        }
      },
      "required": [
        "id",
        "person",
        "active"
      ],
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "format": "uuid",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "replyTo": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "format": "int64",
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "author",
        "text",
        "sequence",
        "createdAt"
      ],
      "type": "object"
    },
    "OperationInput": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "id": {
          "description": "Native request key plus content digest fences a stale rendered form.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "message": {
          "type": "string"
        },
        "schema": true,
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "digest",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "OperationPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/OperationSummary"
          },
          "type": "array"
        },
        "next": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "OperationPhase": {
      "enum": [
        "dispatching",
        "input_required",
        "task",
        "completed",
        "failed",
        "unconfirmed"
      ],
      "type": "string"
    },
    "OperationResource": {
      "additionalProperties": false,
      "properties": {
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "name"
      ],
      "type": "object"
    },
    "OperationResult": {
      "additionalProperties": false,
      "properties": {
        "isError": {
          "type": "boolean"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/OperationResource"
          },
          "type": "array"
        },
        "structured": true,
        "text": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "isError",
        "text",
        "resources"
      ],
      "type": "object"
    },
    "OperationSummary": {
      "additionalProperties": false,
      "properties": {
        "chatId": {
          "format": "uuid",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/OperationPhase"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "runId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "chatId",
        "tool",
        "phase",
        "revision",
        "createdAt"
      ],
      "type": "object"
    },
    "OperationView": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/OperationInput"
          },
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/OperationSummary"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "inputs"
      ],
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/PersonId"
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "type": "object"
    },
    "PersonId": {
      "description": "Installation-local human identity; never an email address or bearer credential.",
      "format": "uuid",
      "type": "string"
    },
    "PrincipalId": {
      "description": "Stable authenticated user or service-principal identity.",
      "type": "string"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "format": "uuid",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "initiator": {
          "$ref": "#/$defs/PersonId"
        },
        "sequence": {
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "text": {
          "type": "string"
        },
        "trigger": {
          "format": "uuid",
          "type": "string"
        },
        "updatedSequence": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "agent",
        "initiator",
        "trigger",
        "state",
        "text",
        "sequence",
        "updatedSequence",
        "createdAt"
      ],
      "type": "object"
    },
    "RunFailure": {
      "enum": [
        "model_unavailable",
        "permission_changed",
        "output_limit",
        "deadline",
        "worker_lost"
      ],
      "type": "string"
    },
    "RunState": {
      "enum": [
        "queued",
        "running",
        "completed",
        "cancelled",
        "interrupted",
        "failed"
      ],
      "type": "string"
    },
    "SendMessage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "replyTo": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    },
    "StartOperation": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "tool",
        "arguments"
      ],
      "type": "object"
    },
    "StartRun": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "format": "uuid",
          "type": "string"
        },
        "trigger": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "trigger"
      ],
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "working",
        "input_required",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "TaskView": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "pollIntervalMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/TaskState"
        },
        "ttlMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "TenantId": {
      "description": "Tenant, organization, or customer boundary identifier.",
      "type": "string"
    },
    "WorkContextId": {
      "description": "Tenant-local boundary that governs related work and every output it produces.",
      "type": "string"
    },
    "WorkspaceBootstrap": {
      "additionalProperties": false,
      "properties": {
        "canContribute": {
          "type": "boolean"
        },
        "person": {
          "$ref": "#/$defs/Person"
        },
        "principalId": {
          "$ref": "#/$defs/PrincipalId"
        },
        "tenantId": {
          "$ref": "#/$defs/TenantId"
        },
        "tenantName": {
          "type": "string"
        },
        "workContext": {
          "$ref": "#/$defs/WorkContextId"
        },
        "workContextTitle": {
          "type": "string"
        }
      },
      "required": [
        "person",
        "principalId",
        "tenantId",
        "tenantName",
        "workContext",
        "workContextTitle",
        "canContribute"
      ],
      "type": "object"
    }
  },
