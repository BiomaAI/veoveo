#usda 1.0
(
    defaultPrim = "Uav"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Uav"
{
    def Cube "Body"
    {
        double size = 1
        double3 xformOp:scale = (0.75, 0.38, 0.18)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        color3f[] primvars:displayColor = [(0.04, 0.62, 0.92)]
    }

    def Cube "Forward"
    {
        double size = 1
        double3 xformOp:scale = (0.85, 0.08, 0.05)
        double3 xformOp:translate = (0.75, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        color3f[] primvars:displayColor = [(0.95, 0.35, 0.08)]
    }

    def Cube "CrossArm"
    {
        double size = 1
        double3 xformOp:scale = (0.08, 0.85, 0.05)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        color3f[] primvars:displayColor = [(0.72, 0.78, 0.82)]
    }
}
