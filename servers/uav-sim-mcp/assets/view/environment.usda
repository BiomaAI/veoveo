#usda 1.0
(
    defaultPrim = "UavReferenceEnvironment"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "UavReferenceEnvironment"
{
    def Mesh "Ground"
    {
        point3f[] points = [(-120, -120, 0), (120, -120, 0), (120, 120, 0), (-120, 120, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.055, 0.075, 0.09)]
    }

    def Cylinder "LandingPad"
    {
        double radius = 8
        double height = 0.05
        color3f[] primvars:displayColor = [(0.18, 0.22, 0.25)]
    }

    def Cube "NorthMarker"
    {
        double size = 1
        double3 xformOp:scale = (1.5, 8, 0.1)
        double3 xformOp:translate = (0, 16, 0.1)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        color3f[] primvars:displayColor = [(0.1, 0.65, 0.95)]
    }
}
