DEFINE TABLE uav_task TYPE NORMAL SCHEMAFULL CHANGEFEED 4w2d PERMISSIONS NONE;
DEFINE FIELD id ON uav_task TYPE string;
DEFINE FIELD task ON uav_task TYPE record<task> REFERENCE ON DELETE CASCADE;
DEFINE FIELD task_type ON uav_task TYPE string ASSERT $value IN ['run_scenario', 'execute_vehicle_mission_plan', 'capture_dataset'];
DEFINE FIELD created_at ON uav_task TYPE datetime;
DEFINE FIELD identity ON uav_task TYPE object;
DEFINE FIELD identity.tenant ON uav_task TYPE record<tenant>;
DEFINE FIELD identity.work_context ON uav_task TYPE record<work_context>;
DEFINE FIELD identity.owner ON uav_task TYPE record<principal>;
DEFINE FIELD identity.profile ON uav_task TYPE record<profile>;
DEFINE FIELD identity.principal_key ON uav_task TYPE string;
DEFINE FIELD identity.plan_id ON uav_task TYPE option<string>;
DEFINE FIELD identity.expected_revision ON uav_task TYPE option<int>;
DEFINE FIELD settlement ON uav_task TYPE option<object> ASSERT IF type::is_object($value) THEN (['status', 'completed_at'] ALLINSIDE object::keys($value) AND $value.status IN ['succeeded', 'failed', 'cancelled'] AND $value.completed_at != NONE) ELSE $value = NONE END;
DEFINE FIELD settlement.status ON uav_task TYPE option<string> ASSERT ($this.settlement = NONE AND $value = NONE) OR ($this.settlement != NONE AND $value IN ['succeeded', 'failed', 'cancelled']);
DEFINE FIELD settlement.completed_at ON uav_task TYPE option<datetime> ASSERT ($this.settlement = NONE AND $value = NONE) OR ($this.settlement != NONE AND $value != NONE);
DEFINE INDEX uav_task_link ON uav_task FIELDS task UNIQUE;
DEFINE INDEX uav_task_plan ON uav_task FIELDS identity.tenant, identity.work_context, identity.plan_id;
DEFINE INDEX uav_task_page ON uav_task FIELDS identity.tenant, created_at, task;
