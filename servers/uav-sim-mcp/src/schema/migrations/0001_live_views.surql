-- Redacted authorizations and retained closed receipts; no plaintext tokens.
DEFINE TABLE uav_live_view TYPE NORMAL SCHEMAFULL CHANGEFEED 4w2d PERMISSIONS NONE;
DEFINE FIELD state ON uav_live_view TYPE object PERMISSIONS FULL;
DEFINE FIELD issuer ON uav_live_view TYPE uuid PERMISSIONS FULL;
DEFINE FIELD token_hash ON uav_live_view TYPE array<int> PERMISSIONS FULL;
DEFINE FIELD generation ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD expires_at ON uav_live_view TYPE datetime PERMISSIONS FULL;
DEFINE FIELD closed_at ON uav_live_view TYPE option<datetime> PERMISSIONS FULL;
DEFINE FIELD state.schemaVersion ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.liveViewId ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.streamProductId ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.resourceUri ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.viewerActor ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.viewerInstanceId ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.sessionId ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.cameraId ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.lifecycle ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.semanticSource ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.codec ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.hardwareEncoder ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.cameraHealth ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.createdAt ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.expiresAt ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.cameraRevision ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.widthPx ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.heightPx ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.codedWidthPx ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.codedHeightPx ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.frameRateMillihertz ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.connectedViewers ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.sourceToRenderSamples ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.maximumFrameAgeMs ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.selectedEntityId ON uav_live_view TYPE option<string> PERMISSIONS FULL;
DEFINE FIELD state.lastFrameAt ON uav_live_view TYPE option<string> PERMISSIONS FULL;
DEFINE FIELD state.sourceToRenderP95Microseconds ON uav_live_view TYPE option<int> PERMISSIONS FULL;
DEFINE FIELD state.owner ON uav_live_view TYPE object PERMISSIONS FULL;
DEFINE FIELD state.owner.subject ON uav_live_view TYPE object PERMISSIONS FULL;
DEFINE FIELD state.owner.subject.kind ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.owner.subject.id ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.owner.tenant ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.owner.workContext ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.owner.policyRevision ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.owner.dataLabels ON uav_live_view TYPE option<array<string>> PERMISSIONS FULL;
DEFINE FIELD state.color ON uav_live_view TYPE object PERMISSIONS FULL;
DEFINE FIELD state.sourceRegion ON uav_live_view TYPE object PERMISSIONS FULL;
DEFINE FIELD state.endpoint ON uav_live_view TYPE object PERMISSIONS FULL;
DEFINE FIELD state.color.primaries ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.color.transfer ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.color.matrix ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.color.range ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.sourceRegion.cameraId ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.sourceRegion.xPx ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.sourceRegion.yPx ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.sourceRegion.widthPx ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.sourceRegion.heightPx ON uav_live_view TYPE int PERMISSIONS FULL;
DEFINE FIELD state.endpoint.transport ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE FIELD state.endpoint.streamUrl ON uav_live_view TYPE string PERMISSIONS FULL;
DEFINE INDEX uav_live_view_issuer ON uav_live_view FIELDS issuer;
DEFINE INDEX uav_live_view_owner ON uav_live_view FIELDS state.viewerActor, state.sessionId, state.liveViewId;
