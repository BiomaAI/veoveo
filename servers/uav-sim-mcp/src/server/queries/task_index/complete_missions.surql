SELECT mission_id AS value FROM uav_vehicle_mission_plan WHERE tenant = $tenant AND work_context = $context AND principal_key = $principal_key AND id IN (SELECT VALUE plan FROM uav_mission_execution WHERE tenant = $tenant AND work_context = $context AND principal_key = $principal_key AND plan.tenant = tenant AND plan.work_context = work_context AND plan.principal_key = principal_key AND plan.state != 'prepared' AND task.request.input.plan_id = plan.plan_id AND record::id(id) = record::id(task) AND task IN (SELECT VALUE id FROM task WHERE server = $server AND tenant = $tenant AND owner = $owner AND profile = $profile AND (owner_context.tenant_key ?? NONE) = $tenant_key AND owner_context.data_labels ALLINSIDE $data_labels AND work_context = $context AND task_type = $mission_task_type)) AND string::contains(string::lowercase(mission_id), $needle) GROUP BY value ORDER BY value ASC LIMIT $limit;
