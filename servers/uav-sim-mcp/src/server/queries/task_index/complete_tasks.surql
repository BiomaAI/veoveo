SELECT type::string(record::id(task)) AS value FROM uav_task WHERE id = type::record('uav_task', type::string(record::id(task))) AND identity.tenant = $tenant AND identity.work_context = $context AND identity.principal_key = $principal_key AND fn::kernel::tasks::selection_v1(task, $server, $tenant, $owner, $profile, $principal_key, $profile_key, $tenant_key, $data_labels, $types, $context, $context_key, $authority_tenant) != NONE AND string::contains(string::lowercase(type::string(record::id(task))), $needle) ORDER BY value ASC LIMIT $limit;
