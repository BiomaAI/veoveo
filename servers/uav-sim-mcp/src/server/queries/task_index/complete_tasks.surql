SELECT type::string(record::id(id)) AS value FROM task WHERE server = $server AND tenant = $tenant AND owner = $owner AND profile = $profile AND (request.owner.tenant_key ?? NONE) = $tenant_key AND request.owner.data_labels ALLINSIDE $data_labels AND task_type IN $types AND string::contains(string::lowercase(type::string(record::id(id))), $needle) ORDER BY value ASC LIMIT $limit;
