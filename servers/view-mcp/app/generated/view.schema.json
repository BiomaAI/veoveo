          },
          "type": "array",
          "uniqueItems": true
        },
        "overlays": {
          "items": {
            "$ref": "#/$defs/SceneOverlay"
          },
          "type": "array"
        },
        "request_digest_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "style_id": {
          "$ref": "#/$defs/SceneStyleId"
        }
      },
      "required": [
        "schema_version",
        "composition_id",
        "composition_uri",
        "revision",
        "base_layer",
        "map_releases",
        "style_id",
        "governed_inputs",
        "overlays",
        "algorithm_revision",
        "request_digest_sha256",
        "composition_digest_sha256",
        "authority",
        "created_at"
      ],
      "type": "object"
    },
