{
  "$defs": {
    "AccessLevel": {
      "description": "A capability level. Ordered `Read < Write < Admin`, so `min` yields the\nlesser privilege — exactly what capping a group role by a grant level needs.",
      "enum": [
        "read",
        "write",
        "admin"
      ],
      "type": "string"
    },
    "AccessSubject": {
      "description": "A principal or group that can own governed data or receive access.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "kind": {
              "const": "principal",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/GroupId"
            },
            "kind": {
              "const": "group",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "AttributionSet": {
      "additionalProperties": false,
      "properties": {
        "lines": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "lines"
      ],
      "type": "object"
    },
    "CameraDefinition": {
      "oneOf": [
        {
          "additionalProperties": false,
