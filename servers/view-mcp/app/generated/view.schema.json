              "profile": {
                "declaration": {
                  "applicability": "the declared scalar resource schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_view_mcp::contract::resources"
                  },
                  "profile": "FrameUri",
                  "version": "unversioned"
                },
                "kind": "owner_resource"
