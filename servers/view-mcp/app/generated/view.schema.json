            "position": {
              "$ref": "#/$defs/Wgs84Position3d"
            },
            "verticalFovDegrees": {
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "position",
            "orientation",
            "verticalFovDegrees"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "eye": {
              "$ref": "#/$defs/Wgs84Position3d"
            },
            "kind": {
              "const": "look_at",
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/Wgs84Position3d"
            },
            "verticalFovDegrees": {
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "eye",
            "target",
            "verticalFovDegrees"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "azimuthDegrees": {
              "format": "double",
              "type": "number"
            },
            "distanceMeters": {
              "format": "double",
              "type": "number"
            },
            "elevationDegrees": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "orbit_target",
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/Wgs84Position3d"
            },
            "verticalFovDegrees": {
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "target",
            "distanceMeters",
            "azimuthDegrees",
            "elevationDegrees",
            "verticalFovDegrees"
