          },
          "required": [
            "kind",
            "position",
            "orientation",
            "scale",
            "mesh_input_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "label",
              "type": "string"
            },
            "position": {
              "$ref": "#/$defs/ScenePosition"
            },
            "text": {
