        "algorithm_revision": {
          "type": "string"
        },
        "authority": {
          "$ref": "#/$defs/SceneCompositionAuthority"
        },
        "base_layer": {
          "$ref": "#/$defs/LayerId"
        },
        "composition_digest_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "composition_id": {
          "$ref": "#/$defs/SceneCompositionId"
        },
        "composition_uri": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "governed_inputs": {
          "items": {
            "$ref": "#/$defs/GovernedSceneInput"
          },
          "type": "array"
        },
