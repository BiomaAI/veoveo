              },
              "policy_revision": {
                "$ref": "#/$defs/PolicyVersion"
              },
              "producer": {
                "$ref": "#/$defs/PrincipalId"
              }
            },
            "required": [
              "invocation_mode",
              "producer",
              "initiator",
              "delegation_id",
              "policy_revision"
