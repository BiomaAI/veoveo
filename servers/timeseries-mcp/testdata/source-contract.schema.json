{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimeseriesForecastRequest",
  "description": "Forecast requests use only the implemented inline/HTTPS source profile.\n\n```compile_fail\nuse veoveo_timeseries_mcp::contract::TimeseriesTableMapping;\nTimeseriesTableMapping::new(\"value\".to_owned());\n```\n```compile_fail\nuse veoveo_timeseries_mcp::contract::{TimeseriesForecastRequest, TimeseriesForecastHorizon, TimeseriesTableMapping};\nuse veoveo_duckdb_mcp::contract::DuckDbSource;\nfn forecast(source: DuckDbSource, mapping: TimeseriesTableMapping, horizon: TimeseriesForecastHorizon) {\n    TimeseriesForecastRequest::new(source, mapping, horizon);\n}\n```\n```compile_fail\nuse veoveo_timeseries_mcp::contract::{TimeseriesForecastRequest, TimeseriesTableMapping};\nuse veoveo_duckdb_mcp::contract::DuckDbTabularSource;\nlet source = DuckDbTabularSource::InlineCsv {\n    csv: \"value\\n1\\n\".into(), filename: None, options: Default::default(),\n};\nTimeseriesForecastRequest::new(source, TimeseriesTableMapping::new(\"value\".parse().unwrap()), 0);\n```",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "#/$defs/DuckDbTabularSource"
    },
    "mapping": {
      "$ref": "#/$defs/TimeseriesTableMapping"
    },
    "trainingFilter": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeseriesRowFilter"
        },
        {
          "type": "null"
        }
      ]
    },
    "horizon": {
      "$ref": "#/$defs/TimeseriesForecastHorizon"
    },
    "method": {
      "$ref": "#/$defs/TimeseriesForecastMethod",
      "default": "naive_trend"
    }
  },
  "additionalProperties": false,
  "required": [
    "source",
    "mapping",
    "horizon"
  ],
  "$defs": {
    "DuckDbTabularSource": {
      "description": "Inline and HTTPS tabular inputs; consumers own network admission and execution.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "csv": {
              "type": "string"
            },
            "filename": {
              "type": [
                "string",
                "null"
              ]
            },
            "options": {
              "$ref": "#/$defs/DuckDbReadOptions",
              "default": {}
            },
            "kind": {
              "type": "string",
              "const": "inline_csv"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "csv"
          ]
        },
        {
          "type": "object",
          "properties": {
            "uri": {
              "$ref": "#/$defs/HttpsUrl"
            },
            "format": {
              "$ref": "#/$defs/DuckDbFormat"
            },
            "options": {
              "$ref": "#/$defs/DuckDbReadOptions",
              "default": {}
            },
            "kind": {
              "type": "string",
              "const": "uri"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "uri",
            "format"
          ]
        },
        {
          "type": "object",
          "properties": {
            "uris": {
              "$ref": "#/$defs/DuckDbSourceUris"
            },
            "format": {
              "$ref": "#/$defs/DuckDbFormat"
            },
            "options": {
              "$ref": "#/$defs/DuckDbReadOptions",
              "default": {}
            },
            "kind": {
              "type": "string",
              "const": "uris"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "uris",
            "format"
          ]
        }
      ]
    },
    "DuckDbReadOptions": {
      "description": "Every constructed options value can be rendered without a late shape check.\n```compile_fail\nuse veoveo_duckdb_mcp::contract::{DuckDbReadOptions, DuckDbReadOptionValue};\nDuckDbReadOptions::default().with_extra(\"nullstr\", DuckDbReadOptionValue::Bool(true));\n```",
      "type": "object",
      "properties": {
        "header": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delimiter": {
          "anyOf": [
            {
              "$ref": "#/$defs/DuckDbReadOptionText"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestampFormat": {
          "anyOf": [
            {
              "$ref": "#/$defs/DuckDbReadOptionText"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z_]": {
              "$ref": "#/$defs/DuckDbReadOptionValue"
            }
          },
          "propertyNames": {
            "description": "Lowercase reader option name; use explicit fields for header, delimiter and timestamp format.",
            "type": "string",
            "pattern": "^[a-z_]",
            "not": {
              "anyOf": [
                {
                  "enum": [
                    "header",
                    "delim",
                    "delimiter",
                    "sep",
                    "timestampformat",
                    "timestamp_format"
                  ]
                },
                {
                  "pattern": "[^a-z0-9_]"
                }
              ]
            },
            "ai.veoveo/naming-profile": {
              "revision": 1,
              "role": {
                "kind": "scalar",
                "profile": {
                  "kind": "standard",
                  "declaration": {
                    "authority": {
                      "kind": "standard",
                      "document": "https://duckdb.org/docs/stable/data/csv/overview.html"
                    },
                    "profile": "DuckDB reader option names",
                    "version": "1.5.6",
                    "applicability": "only extra reader-option dictionary names"
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "DuckDbReadOptionText": {
      "type": "string",
      "pattern": "^[^\\u0000]*$"
    },
    "DuckDbReadOptionValue": {
      "description": "Reader arguments have a closed value shape; the engine owns option-specific meaning.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/DuckDbReadOptionText"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DuckDbReadOptionValue"
          }
        }
      ]
    },
    "HttpsUrl": {
      "description": "Canonical ASCII HTTPS URL without credentials or a fragment. The URL parser also checks host syntax, escaping and normalization; runtime policy checks access.",
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@\\s]+/[^#\\s]*$"
    },
    "DuckDbFormat": {
      "type": "string",
      "enum": [
        "auto",
        "csv",
        "parquet",
        "json",
        "ndjson"
      ]
    },
    "DuckDbSourceUris": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HttpsUrl"
      },
      "minItems": 1
    },
    "TimeseriesTableMapping": {
      "type": "object",
      "properties": {
        "timeColumn": {
          "anyOf": [
            {
              "$ref": "#/$defs/DuckDbColumnName"
            },
            {
              "type": "null"
            }
          ]
        },
        "valueColumn": {
          "$ref": "#/$defs/DuckDbColumnName"
        },
        "seriesColumn": {
          "anyOf": [
            {
              "$ref": "#/$defs/DuckDbColumnName"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "valueColumn"
      ]
    },
    "DuckDbColumnName": {
      "description": "Nonblank column name without NUL, preserved verbatim and quoted as one SQL identifier.",
      "type": "string",
      "allOf": [
        {
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        {
          "pattern": "^[^\\u0000]*$"
        }
      ]
    },
    "TimeseriesRowFilter": {
      "type": "object",
      "properties": {
        "combination": {
          "$ref": "#/$defs/TimeseriesFilterCombination",
          "default": "all"
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeseriesFilterPredicate"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "predicates"
      ]
    },
    "TimeseriesFilterCombination": {
      "type": "string",
      "enum": [
        "all",
        "any"
      ]
    },
    "TimeseriesFilterPredicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "column": {
              "$ref": "#/$defs/DuckDbColumnName"
            },
            "value": {
              "$ref": "#/$defs/TimeseriesFilterValue"
            },
            "op": {
              "type": "string",
              "const": "eq"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "column",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "$ref": "#/$defs/DuckDbColumnName"
            },
            "value": {
              "$ref": "#/$defs/TimeseriesFilterValue"
            },
            "op": {
              "type": "string",
              "const": "ne"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "column",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "$ref": "#/$defs/DuckDbColumnName"
            },
            "values": {
              "$ref": "#/$defs/TimeseriesFilterValues"
            },
            "op": {
              "type": "string",
              "const": "in"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "column",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "$ref": "#/$defs/DuckDbColumnName"
            },
            "op": {
              "type": "string",
              "const": "is_not_null"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "column"
          ]
        }
      ]
    },
    "TimeseriesFilterValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/TimeseriesFilterNumber"
        }
      ]
    },
    "TimeseriesFilterNumber": {
      "type": "number",
      "format": "double"
    },
    "TimeseriesFilterValues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimeseriesFilterValue"
      },
      "minItems": 1
    },
    "TimeseriesForecastHorizon": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "TimeseriesForecastMethod": {
      "type": "string",
      "enum": [
        "naive_trend"
      ]
    }
  }
}
