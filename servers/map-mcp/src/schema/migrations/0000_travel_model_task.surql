DEFINE TABLE map_travel_model_task SCHEMAFULL CHANGEFEED 4w2d INCLUDE ORIGINAL;
DEFINE FIELD id ON map_travel_model_task TYPE string;
DEFINE FIELD task ON map_travel_model_task TYPE record<task> REFERENCE ON DELETE CASCADE;
DEFINE FIELD task_type ON map_travel_model_task TYPE 'build_travel_model';
DEFINE FIELD created_at ON map_travel_model_task TYPE datetime;
DEFINE FIELD identity ON map_travel_model_task TYPE object ASSERT object::keys($value) ALLINSIDE ['travel_model_id', 'created_by', 'work_context', 'expected_input', 'tenant', 'profile', 'tenant_key', 'data_labels', 'authority_tenant'] AND $value.travel_model_id != NONE AND $value.created_by != NONE AND $value.work_context != NONE AND $value.expected_input != NONE AND $value.tenant != NONE AND $value.profile != NONE AND $value.data_labels != NONE AND $value.authority_tenant != NONE;
DEFINE FIELD identity.travel_model_id ON map_travel_model_task TYPE string;
DEFINE FIELD identity.created_by ON map_travel_model_task TYPE string;
DEFINE FIELD identity.work_context ON map_travel_model_task TYPE string;
DEFINE FIELD identity.tenant ON map_travel_model_task TYPE record<tenant>;
DEFINE FIELD identity.profile ON map_travel_model_task TYPE string;
DEFINE FIELD identity.tenant_key ON map_travel_model_task TYPE option<string>;
DEFINE FIELD identity.data_labels ON map_travel_model_task TYPE array<string>;
DEFINE FIELD identity.authority_tenant ON map_travel_model_task TYPE string;
DEFINE FIELD identity.expected_input ON map_travel_model_task TYPE object FLEXIBLE;
DEFINE FIELD settlement ON map_travel_model_task TYPE option<object> ASSERT IF type::is_object($value) THEN object::keys($value) ALLINSIDE ['status', 'outcome', 'completed_at', 'expected_result'] AND $value.status != NONE AND $value.completed_at != NONE AND (($value.status = 'succeeded' AND $value.outcome = 'product' AND $value.expected_result != NONE) OR ($value.status = 'succeeded' AND $value.outcome = 'tool_error' AND $value.expected_result = NONE) OR ($value.status = 'failed' AND $value.outcome = 'failed' AND $value.expected_result = NONE) OR ($value.status = 'cancelled' AND $value.outcome = 'cancelled' AND $value.expected_result = NONE)) ELSE $value = NONE END;
DEFINE FIELD settlement.outcome ON map_travel_model_task TYPE option<'product' | 'tool_error' | 'failed' | 'cancelled'>;
DEFINE FIELD settlement.status ON map_travel_model_task TYPE option<'succeeded' | 'failed' | 'cancelled'>;
DEFINE FIELD settlement.completed_at ON map_travel_model_task TYPE option<datetime>;
DEFINE FIELD settlement.expected_result ON map_travel_model_task TYPE option<object> FLEXIBLE;
DEFINE INDEX map_travel_model_task_task ON map_travel_model_task FIELDS task UNIQUE;
DEFINE INDEX map_travel_model_task_identity ON map_travel_model_task FIELDS identity.travel_model_id, task;
DEFINE INDEX map_travel_model_task_tenant ON map_travel_model_task FIELDS identity.tenant, task;
