SELECT VALUE candidate FROM (SELECT product_key AS candidate FROM map_layer_product WHERE tenant = $tenant AND work_context = $context AND layer_key IN (SELECT VALUE layer_key FROM map_feature_layer WHERE tenant = $tenant AND work_context = $context AND $labels CONTAINSALL data_labels) AND ($parent = NONE OR layer_key = $parent) AND ($publication = NONE OR publication_key = $publication) AND string::lowercase(product_key) CONTAINS $needle GROUP BY candidate ORDER BY candidate ASC LIMIT 101);
