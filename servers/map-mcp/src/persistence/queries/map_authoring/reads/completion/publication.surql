SELECT VALUE candidate FROM (SELECT publication_key AS candidate FROM map_layer_publication WHERE tenant = $tenant AND work_context = $context AND layer_key IN (SELECT VALUE layer_key FROM map_feature_layer WHERE tenant = $tenant AND work_context = $context AND $labels CONTAINSALL data_labels) AND ($parent = NONE OR layer_key = $parent) AND string::lowercase(publication_key) CONTAINS $needle GROUP BY candidate ORDER BY candidate ASC LIMIT 101);
