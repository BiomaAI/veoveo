SELECT VALUE candidate FROM (SELECT type::string(style_version) AS candidate FROM map_style_revision WHERE tenant = $tenant AND work_context = $context AND layer_key IN (SELECT VALUE layer_key FROM map_feature_layer WHERE tenant = $tenant AND work_context = $context AND $labels CONTAINSALL data_labels) AND ($parent = NONE OR layer_key = $parent) AND string::lowercase(type::string(style_version)) CONTAINS $needle GROUP BY candidate ORDER BY candidate ASC LIMIT 101);
