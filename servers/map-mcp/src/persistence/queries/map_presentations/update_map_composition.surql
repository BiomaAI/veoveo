BEGIN TRANSACTION; CREATE ONLY $revision_record CONTENT $revision RETURN NONE; LET $updated = (UPDATE ONLY $root_record SET title = $title, current_revision = $current_revision, canonical_json = $canonical_json, archived_at = $archived_at, updated_at = $now WHERE tenant = $tenant AND work_context = $context AND current_revision = $expected RETURN AFTER); IF $updated = NONE { THROW 'map_composition_conflict'; }; COMMIT TRANSACTION;
