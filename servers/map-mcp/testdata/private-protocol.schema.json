{
  "request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "NormalizeCommand",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "integer",
        "format": "uint32",
        "minimum": 2,
        "maximum": 2
      },
      "acquisitionId": {
        "type": "string"
      },
      "adapterKind": {
        "$ref": "#/$defs/SourceAdapterKind"
      },
      "sourcePath": {
        "type": "string"
      },
      "outputDir": {
        "type": "string"
      },
      "maximumElapsedSeconds": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "maximumOutputBytes": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "acquisitionId",
      "adapterKind",
      "sourcePath",
      "outputDir",
      "maximumElapsedSeconds",
      "maximumOutputBytes"
    ],
    "$defs": {
      "SourceAdapterKind": {
        "type": "string",
        "enum": [
          "open_street_map",
          "authority_vector",
          "gtfs_schedule",
          "gtfs_realtime",
          "s57_enc",
          "s100",
          "aixm",
          "faa_nasr",
          "environmental"
        ]
      }
    }
  },
  "response": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "NormalizeResult",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "acquisitionId": {
        "$ref": "#/$defs/AcquisitionId"
      },
      "sourceDigestSha256": {
        "type": "string"
      },
      "versionLabel": {
        "type": "string"
      },
      "normalizedPaths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "qualityReportPath": {
        "type": "string"
      },
      "routingBuildPath": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "acquisitionId",
      "sourceDigestSha256",
      "versionLabel",
      "normalizedPaths",
      "qualityReportPath"
    ],
    "$defs": {
      "AcquisitionId": {
        "type": "string",
        "ai.veoveo/naming-profile": {
          "revision": 1,
          "role": {
            "kind": "scalar",
            "profile": {
              "kind": "owner_identity",
              "declaration": {
                "authority": {
                  "kind": "owner",
                  "module": "veoveo_map_mcp::contract::ids"
                },
                "profile": "AcquisitionId",
                "version": "unversioned",
                "applicability": "the declared scalar identity schema"
              }
            }
          }
        }
      }
    }
  }
}
