DEFINE TABLE optimization_task SCHEMAFULL;
DEFINE FIELD id ON optimization_task TYPE string;
DEFINE FIELD task ON optimization_task TYPE record<task> REFERENCE ON DELETE CASCADE;
DEFINE FIELD task_type ON optimization_task TYPE string;
DEFINE FIELD created_at ON optimization_task TYPE datetime;
DEFINE FIELD identity ON optimization_task TYPE object;
DEFINE FIELD identity.problem_id ON optimization_task TYPE string;
DEFINE FIELD identity.run_id ON optimization_task TYPE string;
DEFINE FIELD identity.family ON optimization_task TYPE string ASSERT $value IN ['routing', 'route_scenarios', 'convex', 'milp'];
DEFINE FIELD identity.profile_uri ON optimization_task TYPE string;
DEFINE FIELD identity.submitted_at ON optimization_task TYPE datetime;
DEFINE FIELD settlement ON optimization_task TYPE option<object>;
DEFINE FIELD settlement.status ON optimization_task TYPE option<string> ASSERT $value = NONE OR $value IN ['succeeded', 'failed', 'cancelled'];
DEFINE FIELD settlement.completed_at ON optimization_task TYPE option<datetime>;
DEFINE FIELD settlement.result_uri ON optimization_task TYPE option<string>;
DEFINE INDEX optimization_task_link ON optimization_task FIELDS task UNIQUE;
DEFINE INDEX optimization_task_page ON optimization_task FIELDS created_at, task;
DEFINE INDEX optimization_task_problem ON optimization_task FIELDS identity.problem_id;
DEFINE INDEX optimization_task_run ON optimization_task FIELDS identity.run_id;
DEFINE INDEX optimization_task_solution ON optimization_task FIELDS settlement.result_uri;
