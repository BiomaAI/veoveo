SELECT VALUE candidate FROM (SELECT result.payload.structuredContent.annotations_artifact.artifact_id AS candidate FROM task WHERE server = $server AND tenant = $tenant AND owner = $owner AND profile = $profile AND (request.owner.tenant_key ?? NONE) = $tenant_key AND request.owner.data_labels ALLINSIDE $data_labels AND task_type = $task_type AND result.payload.structuredContent.annotations_artifact.artifact_id CONTAINS $needle GROUP BY candidate ORDER BY candidate ASC LIMIT $limit);
