      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "float",
          "type": "number"
        },
        "width": {
          "format": "float",
          "type": "number"
        },
        "x": {
          "format": "float",
          "type": "number"
        },
        "y": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "$ref": "#/$defs/BoundingBox2D"
        },
        "classId": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "confidence": {
          "description": "Detector confidence. DeepStream does not provide this value for every\nclustering mode or tracker-propagated object.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "trackId": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "trackerConfidence": {
          "description": "Tracker confidence when the selected tracker exposes one.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "classId",
        "label",
        "bounds"
      ],
      "type": "object"
    },
    "EncodedVideoChunk": {
      "additionalProperties": false,
      "properties": {
        "dataBase64": {
          "type": "string"
        },
        "keyframe": {
          "type": "boolean"
        },
        "sequence": {
          "description": "Decode-order identity. This is the ordering contract for retained chunks.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "timestampUs": {
          "description": "H.264 presentation timestamp in microseconds. AVC frame reordering can make\npresentation timestamps non-monotonic in decode sequence.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "timestampUs",
        "keyframe",
        "dataBase64"
      ],
      "type": "object"
    },
    "LiveIngressView": {
      "additionalProperties": false,
      "properties": {
        "caps": {
          "type": "string"
