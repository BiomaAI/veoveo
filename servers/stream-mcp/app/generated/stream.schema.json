                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_stream_mcp::contract::ids"
                  },
                  "profile": "SessionId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
