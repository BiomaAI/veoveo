        "clockRate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "type": "string"
        },
        "payloadType": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
