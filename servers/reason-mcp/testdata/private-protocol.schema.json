{
  "request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RunnerRequest",
    "type": "object",
    "properties": {
      "schema": {
        "type": "string",
        "const": "veoveo.ai/reason-runner-request/v4",
        "ai.veoveo/naming-profile": {
          "revision": 1,
          "role": {
            "kind": "scalar",
            "profile": {
              "kind": "builtin",
              "grammar": "format_tag"
            }
          }
        }
      },
      "taskId": {
        "type": "string",
        "ai.veoveo/naming-profile": {
          "revision": 1,
          "role": {
            "kind": "scalar",
            "profile": {
              "kind": "owner_identity",
              "declaration": {
                "authority": {
                  "kind": "owner",
                  "module": "veoveo_reason_mcp::contract::ids"
                },
                "profile": "AnalysisId",
                "version": "unversioned",
                "applicability": "the declared scalar identity schema"
              }
            }
          }
        }
      },
      "inputMp4": {
        "type": "string"
      },
      "inputWidth": {
        "type": "integer",
        "format": "uint16",
        "minimum": 0,
        "maximum": 65535
      },
      "inputHeight": {
        "type": "integer",
        "format": "uint16",
        "minimum": 0,
        "maximum": 65535
      },
      "responseJson": {
        "type": "string"
      },
      "pipeline": {
        "$ref": "#/$defs/RunnerPipeline"
      },
      "model": {
        "$ref": "#/$defs/RunnerModel"
      },
      "task": {
        "$ref": "#/$defs/ReasoningTask"
      },
      "grounding": {
        "anyOf": [
          {
            "$ref": "#/$defs/GroundingDetections"
          },
          {
            "type": "null"
          }
        ]
      },
      "requestedRange": {
        "$ref": "#/$defs/IndexRange"
      },
      "decodeStartIndex": {
        "type": "integer",
        "format": "int64"
      },
      "sampling": {
        "$ref": "#/$defs/ObservationSampling"
      },
      "decode": {
        "$ref": "#/$defs/DecodePolicy"
      },
      "maxEvents": {
        "type": "integer",
        "format": "uint64",
        "minimum": 1
      },
      "maxAnswerBytes": {
        "type": "integer",
        "format": "uint64",
        "minimum": 1
      },
      "maxResponseBytes": {
        "type": "integer",
        "format": "uint64",
        "minimum": 1
      }
    },
    "additionalProperties": false,
    "required": [
      "schema",
      "taskId",
      "inputMp4",
      "inputWidth",
      "inputHeight",
      "responseJson",
      "pipeline",
      "model",
      "task",
      "requestedRange",
      "decodeStartIndex",
      "sampling",
      "decode",
      "maxEvents",
      "maxAnswerBytes",
      "maxResponseBytes"
    ],
    "$defs": {
      "RunnerPipeline": {
        "type": "object",
        "properties": {
          "pipelineId": {
            "type": "string",
            "ai.veoveo/naming-profile": {
              "revision": 1,
              "role": {
                "kind": "scalar",
                "profile": {
                  "kind": "owner_identity",
                  "declaration": {
                    "authority": {
                      "kind": "owner",
                      "module": "veoveo_reason_mcp::contract::ids"
                    },
                    "profile": "PipelineId",
                    "version": "unversioned",
                    "applicability": "the declared scalar identity schema"
                  }
                }
              }
            }
          },
          "promptTemplatePath": {
            "type": "string"
          },
          "promptRevision": {
            "type": "string"
          },
          "observation": {
            "$ref": "#/$defs/ObservationConfig"
          }
        },
        "additionalProperties": false,
        "required": [
          "pipelineId",
          "promptTemplatePath",
          "promptRevision",
          "observation"
        ]
      },
      "ObservationConfig": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "height": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maximumFrames": {
            "type": "integer",
            "format": "uint32",
            "minimum": 1,
            "maximum": 1024
          }
        },
        "additionalProperties": false,
        "required": [
          "width",
          "height",
          "maximumFrames"
        ]
      },
      "RunnerModel": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "ai.veoveo/naming-profile": {
              "revision": 1,
              "role": {
                "kind": "scalar",
                "profile": {
                  "kind": "owner_identity",
                  "declaration": {
                    "authority": {
                      "kind": "owner",
                      "module": "veoveo_reason_mcp::contract::ids"
                    },
                    "profile": "ModelId",
                    "version": "unversioned",
                    "applicability": "the declared scalar identity schema"
                  }
                }
              }
            }
          },
          "modelPath": {
            "type": "string"
          },
          "format": {
            "$ref": "#/$defs/ModelFormat"
          },
          "modelDigest": {
            "type": [
              "string",
              "null"
            ]
          },
          "engine": {
            "$ref": "#/$defs/EngineConfig"
          }
        },
        "additionalProperties": false,
        "required": [
          "modelId",
          "modelPath",
          "format",
          "engine"
        ]
      },
      "ModelFormat": {
        "type": "string",
        "enum": [
          "local_checkpoint"
        ]
      },
      "EngineConfig": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "gpuMemoryUtilization": {
                "type": "number",
                "format": "float",
                "minimum": 0.1,
                "maximum": 1.0
              },
              "maxModelLen": {
                "type": "integer",
                "format": "uint32",
                "minimum": 1024,
                "maximum": 1048576
              },
              "kind": {
                "type": "string",
                "const": "vllm"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "gpuMemoryUtilization",
              "maxModelLen"
            ]
          }
        ]
      },
      "ReasoningTask": {
        "description": "One typed reasoning task over the selected video range.",
        "oneOf": [
          {
            "description": "Describe what happens in the selected range.",
            "type": "object",
            "properties": {
              "prompt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "type": "string",
                "const": "describe_segment"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind"
            ]
          },
          {
            "description": "Detect events matching the prompt inside the selected range.",
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "detect_events"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "prompt"
            ]
          },
          {
            "description": "Answer one question about the selected range.",
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "answer_question"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "question"
            ]
          }
        ]
      },
      "GroundingDetections": {
        "description": "Bounded typed subset of perception detections embedded in the durable\nrequest at submission time.",
        "type": "object",
        "properties": {
          "schema": {
            "$ref": "#/$defs/GroundingSchema"
          },
          "sourceArtifactUri": {
            "type": "string"
          },
          "frames": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/GroundingFrame"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "schema",
          "sourceArtifactUri",
          "frames"
        ]
      },
      "GroundingSchema": {
        "type": "string",
        "enum": [
          "veoveo.ai/reason-grounding/v2"
        ],
        "ai.veoveo/naming-profile": {
          "revision": 1,
          "role": {
            "kind": "scalar",
            "profile": {
              "kind": "builtin",
              "grammar": "format_tag"
            }
          }
        }
      },
      "GroundingFrame": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int64"
          },
          "detections": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/GroundingDetection"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "index",
          "detections"
        ]
      },
      "GroundingDetection": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "trackId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "label"
        ]
      },
      "IndexRange": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "format": "int64"
          },
          "end": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ]
      },
      "ObservationSampling": {
        "description": "How many decoded frames the model observes across the requested range.",
        "type": "object",
        "properties": {
          "maxFrames": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "maxFrames"
        ]
      },
      "DecodePolicy": {
        "description": "Decode parameters. Greedy decoding is the deterministic default; sampled\ndecoding is opt-in and its parameters are recorded in the result.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "const": "greedy"
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "temperature": {
                "type": "number",
                "format": "float"
              },
              "topP": {
                "type": "number",
                "format": "float"
              },
              "seed": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "mode": {
                "type": "string",
                "const": "sampled"
              }
            },
            "additionalProperties": false,
            "required": [
              "mode",
              "temperature",
              "topP",
              "seed"
            ]
          }
        ]
      }
    }
  },
  "response": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RunnerResponse",
    "type": "object",
    "properties": {
      "schema": {
        "type": "string",
        "const": "veoveo.ai/reason-runner-response/v2",
        "ai.veoveo/naming-profile": {
          "revision": 1,
          "role": {
            "kind": "scalar",
            "profile": {
              "kind": "builtin",
              "grammar": "format_tag"
            }
          }
        }
      },
      "answer": {
        "$ref": "#/$defs/ReasoningAnswer"
      },
      "observedFrames": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "elapsedMs": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "additionalProperties": false,
    "required": [
      "schema",
      "answer",
      "observedFrames",
      "elapsedMs"
    ],
    "$defs": {
      "ReasoningAnswer": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "description"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ReasonedEvent"
                }
              },
              "kind": {
                "type": "string",
                "const": "events"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "events"
            ]
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "answer"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ]
          }
        ]
      },
      "ReasonedEvent": {
        "type": "object",
        "properties": {
          "range": {
            "description": "Inclusive source-timeline index range of the event.",
            "$ref": "#/$defs/IndexRange"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "trackIds": {
            "description": "Perception track identities cited from the request's grounding.",
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "range",
          "label",
          "description"
        ]
      },
      "IndexRange": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "format": "int64"
          },
          "end": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ]
      }
    }
  }
}
