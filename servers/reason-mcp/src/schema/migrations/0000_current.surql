DEFINE TABLE reason_analysis SCHEMAFULL CHANGEFEED 1d INCLUDE ORIGINAL;
DEFINE FIELD id ON reason_analysis TYPE string;
DEFINE FIELD task ON reason_analysis TYPE record<task> REFERENCE ON DELETE CASCADE;
DEFINE FIELD task_type ON reason_analysis TYPE string;
DEFINE FIELD created_at ON reason_analysis TYPE datetime;
DEFINE FIELD settlement ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN object::keys($value) ALLINSIDE ['status', 'outcome', 'completed_at', 'results', 'annotations', 'source_clip', 'expected_result', 'expected_metadata', 'finding'] AND $value.status != NONE AND $value.completed_at != NONE AND (($value.status = 'succeeded' AND $value.outcome = 'product' AND $value.results != NONE AND $value.annotations != NONE AND $value.expected_result != NONE AND $value.expected_metadata != NONE AND $value.finding != NONE) OR ((($value.status = 'succeeded' AND $value.outcome = 'tool_error') OR ($value.status = 'failed' AND $value.outcome = 'failed') OR ($value.status = 'cancelled' AND $value.outcome = 'cancelled')) AND $value.results = NONE AND $value.annotations = NONE AND $value.source_clip = NONE AND $value.expected_result = NONE AND $value.expected_metadata = NONE AND $value.finding = NONE)) ELSE $value = NONE END;
DEFINE FIELD settlement.status ON reason_analysis TYPE option<string> ASSERT $value = NONE OR $value IN ['succeeded', 'failed', 'cancelled'];
DEFINE FIELD settlement.completed_at ON reason_analysis TYPE option<datetime>;
DEFINE FIELD settlement.results ON reason_analysis TYPE option<record<artifact_occurrence>>;
DEFINE FIELD settlement.annotations ON reason_analysis TYPE option<record<artifact_occurrence>>;
DEFINE FIELD settlement.source_clip ON reason_analysis TYPE option<record<artifact_occurrence>>;
DEFINE FIELD settlement.expected_result ON reason_analysis TYPE option<object> FLEXIBLE;
DEFINE FIELD OVERWRITE settlement.expected_metadata ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['provenance'] AND (['provenance'] ALLINSIDE object::keys($value) AND $value.provenance != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['kind', 'analysis_id', 'recording_id', 'pipeline_id', 'model_id', 'prompt_revision', 'task_kind', 'source_snapshot_sha256'] AND (['kind', 'analysis_id', 'recording_id', 'pipeline_id', 'model_id', 'prompt_revision', 'task_kind', 'source_snapshot_sha256'] ALLINSIDE object::keys($value) AND $value.kind != NONE AND $value.analysis_id != NONE AND $value.recording_id != NONE AND $value.pipeline_id != NONE AND $value.model_id != NONE AND $value.prompt_revision != NONE AND $value.task_kind != NONE AND $value.source_snapshot_sha256 != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.kind ON reason_analysis TYPE option<string> ASSERT $value = NONE OR $value = 'reason_results';
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.analysis_id ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.recording_id ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.pipeline_id ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.model_id ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.prompt_revision ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.task_kind ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.source_snapshot_sha256 ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['pipeline_id', 'model_id', 'model_digest', 'prompt_revision', 'decode', 'confidence_basis', 'recording_uri', 'entity_path', 'timeline', 'timeline_kind', 'requested_range', 'source_snapshot_sha256', 'task', 'answer'] AND (['pipeline_id', 'model_id', 'prompt_revision', 'decode', 'confidence_basis', 'recording_uri', 'entity_path', 'timeline', 'timeline_kind', 'requested_range', 'source_snapshot_sha256', 'task', 'answer'] ALLINSIDE object::keys($value) AND $value.pipeline_id != NONE AND $value.model_id != NONE AND $value.prompt_revision != NONE AND $value.decode != NONE AND $value.confidence_basis != NONE AND $value.recording_uri != NONE AND $value.entity_path != NONE AND $value.timeline != NONE AND $value.timeline_kind != NONE AND $value.requested_range != NONE AND $value.source_snapshot_sha256 != NONE AND $value.task != NONE AND $value.answer != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.pipeline_id ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.model_id ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.model_digest ON reason_analysis TYPE option<string | null>;
DEFINE FIELD OVERWRITE settlement.finding.prompt_revision ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.confidence_basis ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.recording_uri ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.entity_path ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.timeline ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.timeline_kind ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.source_snapshot_sha256 ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.decode ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN ((object::keys($value) ALLINSIDE ['mode', 'temperature', 'top_p', 'seed'] AND (['mode'] ALLINSIDE object::keys($value) AND $value.mode != NONE)) AND (($value.mode = 'greedy' AND $value.temperature = NONE AND $value.top_p = NONE AND $value.seed = NONE) OR ($value.mode = 'sampled' AND $value.temperature != NONE AND $value.top_p != NONE AND $value.seed != NONE))) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.decode.mode ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.decode.temperature ON reason_analysis TYPE option<number>;
DEFINE FIELD OVERWRITE settlement.finding.decode.top_p ON reason_analysis TYPE option<number>;
DEFINE FIELD OVERWRITE settlement.finding.decode.seed ON reason_analysis TYPE option<int | decimal>;
DEFINE FIELD OVERWRITE settlement.finding.requested_range ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['start', 'end'] AND (['start', 'end'] ALLINSIDE object::keys($value) AND $value.start != NONE AND $value.end != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.requested_range.start ON reason_analysis TYPE option<int>;
DEFINE FIELD OVERWRITE settlement.finding.requested_range.end ON reason_analysis TYPE option<int>;
DEFINE FIELD OVERWRITE settlement.finding.task ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN ((object::keys($value) ALLINSIDE ['kind', 'prompt', 'question'] AND (['kind'] ALLINSIDE object::keys($value) AND $value.kind != NONE)) AND (($value.kind = 'describe_segment' AND $value.question = NONE) OR ($value.kind = 'detect_events' AND $value.prompt != NONE AND $value.question = NONE) OR ($value.kind = 'answer_question' AND $value.question != NONE AND $value.prompt = NONE))) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.task.kind ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.task.prompt ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.task.question ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN ((object::keys($value) ALLINSIDE ['kind', 'excerpt', 'events', 'total', 'truncated'] AND (['kind'] ALLINSIDE object::keys($value) AND $value.kind != NONE)) AND (($value.kind IN ['description', 'answer'] AND $value.excerpt != NONE AND $value.events = NONE AND $value.total = NONE AND $value.truncated = NONE) OR ($value.kind = 'events' AND $value.excerpt = NONE AND $value.events != NONE AND $value.total != NONE AND $value.truncated != NONE))) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.kind ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer.excerpt ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['text', 'truncated'] AND (['text', 'truncated'] ALLINSIDE object::keys($value) AND $value.text != NONE AND $value.truncated != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.excerpt.text ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer.excerpt.truncated ON reason_analysis TYPE option<bool>;
DEFINE FIELD OVERWRITE settlement.finding.answer.total ON reason_analysis TYPE option<int | decimal>;
DEFINE FIELD OVERWRITE settlement.finding.answer.truncated ON reason_analysis TYPE option<bool>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events ON reason_analysis TYPE option<array<object>>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.* ON reason_analysis TYPE object ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['range', 'label', 'description', 'track_ids'] AND (['range', 'label', 'description', 'track_ids'] ALLINSIDE object::keys($value) AND $value.range != NONE AND $value.label != NONE AND $value.description != NONE AND $value.track_ids != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.range ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['start', 'end'] AND (['start', 'end'] ALLINSIDE object::keys($value) AND $value.start != NONE AND $value.end != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.range.start ON reason_analysis TYPE option<int>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.range.end ON reason_analysis TYPE option<int>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.track_ids ON reason_analysis TYPE option<array<int | decimal>>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.label ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['text', 'truncated'] AND (['text', 'truncated'] ALLINSIDE object::keys($value) AND $value.text != NONE AND $value.truncated != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.description ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['text', 'truncated'] AND (['text', 'truncated'] ALLINSIDE object::keys($value) AND $value.text != NONE AND $value.truncated != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.label.text ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.label.truncated ON reason_analysis TYPE option<bool>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.description.text ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.description.truncated ON reason_analysis TYPE option<bool>;

DEFINE FIELD identity ON reason_analysis TYPE object ASSERT object::keys($value) ALLINSIDE ['pipeline_id', 'tenant'] AND (['pipeline_id', 'tenant'] ALLINSIDE object::keys($value) AND $value.pipeline_id != NONE AND $value.tenant != NONE);
DEFINE FIELD identity.pipeline_id ON reason_analysis TYPE string;
DEFINE FIELD identity.tenant ON reason_analysis TYPE record<tenant>;
DEFINE INDEX reason_analysis_task ON reason_analysis FIELDS task UNIQUE;
DEFINE INDEX reason_analysis_page ON reason_analysis FIELDS identity.tenant, created_at, task;
DEFINE FIELD settlement.outcome ON reason_analysis TYPE option<string> ASSERT $value = NONE OR $value IN ['product', 'tool_error', 'failed', 'cancelled'];
