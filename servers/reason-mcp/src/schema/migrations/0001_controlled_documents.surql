-- Nested checked documents use their current JSON field profile.
-- Physical owner row fields and migration 0 keep their declared names.
REMOVE FIELD settlement.expected_metadata.provenance.analysis_id ON reason_analysis;
REMOVE FIELD settlement.expected_metadata.provenance.recording_id ON reason_analysis;
REMOVE FIELD settlement.expected_metadata.provenance.pipeline_id ON reason_analysis;
REMOVE FIELD settlement.expected_metadata.provenance.model_id ON reason_analysis;
REMOVE FIELD settlement.expected_metadata.provenance.prompt_revision ON reason_analysis;
REMOVE FIELD settlement.expected_metadata.provenance.task_kind ON reason_analysis;
REMOVE FIELD settlement.expected_metadata.provenance.source_snapshot_sha256 ON reason_analysis;
REMOVE FIELD settlement.finding.answer.events.*.track_ids ON reason_analysis;
REMOVE FIELD settlement.finding.decode.top_p ON reason_analysis;
REMOVE FIELD settlement.finding.requested_range.start ON reason_analysis;
REMOVE FIELD settlement.finding.requested_range.end ON reason_analysis;
REMOVE FIELD settlement.finding.pipeline_id ON reason_analysis;
REMOVE FIELD settlement.finding.model_id ON reason_analysis;
REMOVE FIELD settlement.finding.model_digest ON reason_analysis;
REMOVE FIELD settlement.finding.prompt_revision ON reason_analysis;
REMOVE FIELD settlement.finding.confidence_basis ON reason_analysis;
REMOVE FIELD settlement.finding.recording_uri ON reason_analysis;
REMOVE FIELD settlement.finding.entity_path ON reason_analysis;
REMOVE FIELD settlement.finding.timeline_kind ON reason_analysis;
REMOVE FIELD settlement.finding.source_snapshot_sha256 ON reason_analysis;
REMOVE FIELD settlement.finding.requested_range ON reason_analysis;

DEFINE FIELD OVERWRITE settlement.expected_metadata ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['provenance'] AND (['provenance'] ALLINSIDE object::keys($value) AND $value.provenance != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['kind', 'analysisId', 'recordingId', 'pipelineId', 'modelId', 'promptRevision', 'taskKind', 'sourceSnapshotSha256'] AND (['kind', 'analysisId', 'recordingId', 'pipelineId', 'modelId', 'promptRevision', 'taskKind', 'sourceSnapshotSha256'] ALLINSIDE object::keys($value) AND $value.kind != NONE AND $value.analysisId != NONE AND $value.recordingId != NONE AND $value.pipelineId != NONE AND $value.modelId != NONE AND $value.promptRevision != NONE AND $value.taskKind != NONE AND $value.sourceSnapshotSha256 != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.kind ON reason_analysis TYPE option<string> ASSERT $value = NONE OR $value = 'reason_results';
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.analysisId ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.recordingId ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.pipelineId ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.modelId ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.promptRevision ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.taskKind ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.expected_metadata.provenance.sourceSnapshotSha256 ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['pipelineId', 'modelId', 'modelDigest', 'promptRevision', 'decode', 'confidenceBasis', 'recordingUri', 'entityPath', 'timeline', 'timelineKind', 'requestedRange', 'sourceSnapshotSha256', 'task', 'answer'] AND (['pipelineId', 'modelId', 'promptRevision', 'decode', 'confidenceBasis', 'recordingUri', 'entityPath', 'timeline', 'timelineKind', 'requestedRange', 'sourceSnapshotSha256', 'task', 'answer'] ALLINSIDE object::keys($value) AND $value.pipelineId != NONE AND $value.modelId != NONE AND $value.promptRevision != NONE AND $value.decode != NONE AND $value.confidenceBasis != NONE AND $value.recordingUri != NONE AND $value.entityPath != NONE AND $value.timeline != NONE AND $value.timelineKind != NONE AND $value.requestedRange != NONE AND $value.sourceSnapshotSha256 != NONE AND $value.task != NONE AND $value.answer != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.pipelineId ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.modelId ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.modelDigest ON reason_analysis TYPE option<string | null>;
DEFINE FIELD OVERWRITE settlement.finding.promptRevision ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.confidenceBasis ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.recordingUri ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.entityPath ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.timeline ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.timelineKind ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.sourceSnapshotSha256 ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.decode ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN ((object::keys($value) ALLINSIDE ['mode', 'temperature', 'topP', 'seed'] AND (['mode'] ALLINSIDE object::keys($value) AND $value.mode != NONE)) AND (($value.mode = 'greedy' AND $value.temperature = NONE AND $value.topP = NONE AND $value.seed = NONE) OR ($value.mode = 'sampled' AND $value.temperature != NONE AND $value.topP != NONE AND $value.seed != NONE))) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.decode.mode ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.decode.temperature ON reason_analysis TYPE option<number>;
DEFINE FIELD OVERWRITE settlement.finding.decode.topP ON reason_analysis TYPE option<number>;
DEFINE FIELD OVERWRITE settlement.finding.decode.seed ON reason_analysis TYPE option<int | decimal>;
DEFINE FIELD OVERWRITE settlement.finding.requestedRange ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['start', 'end'] AND (['start', 'end'] ALLINSIDE object::keys($value) AND $value.start != NONE AND $value.end != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.requestedRange.start ON reason_analysis TYPE option<int>;
DEFINE FIELD OVERWRITE settlement.finding.requestedRange.end ON reason_analysis TYPE option<int>;
DEFINE FIELD OVERWRITE settlement.finding.task ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN ((object::keys($value) ALLINSIDE ['kind', 'prompt', 'question'] AND (['kind'] ALLINSIDE object::keys($value) AND $value.kind != NONE)) AND (($value.kind = 'describe_segment' AND $value.question = NONE) OR ($value.kind = 'detect_events' AND $value.prompt != NONE AND $value.question = NONE) OR ($value.kind = 'answer_question' AND $value.question != NONE AND $value.prompt = NONE))) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.task.kind ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.task.prompt ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.task.question ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN ((object::keys($value) ALLINSIDE ['kind', 'excerpt', 'events', 'total', 'truncated'] AND (['kind'] ALLINSIDE object::keys($value) AND $value.kind != NONE)) AND (($value.kind IN ['description', 'answer'] AND $value.excerpt != NONE AND $value.events = NONE AND $value.total = NONE AND $value.truncated = NONE) OR ($value.kind = 'events' AND $value.excerpt = NONE AND $value.events != NONE AND $value.total != NONE AND $value.truncated != NONE))) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.kind ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer.excerpt ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['text', 'truncated'] AND (['text', 'truncated'] ALLINSIDE object::keys($value) AND $value.text != NONE AND $value.truncated != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.excerpt.text ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer.excerpt.truncated ON reason_analysis TYPE option<bool>;
DEFINE FIELD OVERWRITE settlement.finding.answer.total ON reason_analysis TYPE option<int | decimal>;
DEFINE FIELD OVERWRITE settlement.finding.answer.truncated ON reason_analysis TYPE option<bool>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events ON reason_analysis TYPE option<array<object>>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.* ON reason_analysis TYPE object ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['range', 'label', 'description', 'trackIds'] AND (['range', 'label', 'description', 'trackIds'] ALLINSIDE object::keys($value) AND $value.range != NONE AND $value.label != NONE AND $value.description != NONE AND $value.trackIds != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.range ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['start', 'end'] AND (['start', 'end'] ALLINSIDE object::keys($value) AND $value.start != NONE AND $value.end != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.range.start ON reason_analysis TYPE option<int>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.range.end ON reason_analysis TYPE option<int>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.trackIds ON reason_analysis TYPE option<array<int | decimal>>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.label ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['text', 'truncated'] AND (['text', 'truncated'] ALLINSIDE object::keys($value) AND $value.text != NONE AND $value.truncated != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.description ON reason_analysis TYPE option<object> ASSERT IF type::is_object($value) THEN (object::keys($value) ALLINSIDE ['text', 'truncated'] AND (['text', 'truncated'] ALLINSIDE object::keys($value) AND $value.text != NONE AND $value.truncated != NONE)) ELSE $value = NONE END;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.label.text ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.label.truncated ON reason_analysis TYPE option<bool>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.description.text ON reason_analysis TYPE option<string>;
DEFINE FIELD OVERWRITE settlement.finding.answer.events.*.description.truncated ON reason_analysis TYPE option<bool>;
