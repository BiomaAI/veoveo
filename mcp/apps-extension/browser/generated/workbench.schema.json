{
  "$defs": {
    "CreateRecordingProjectionRequest": {
      "additionalProperties": false,
      "description": "Request construction and decoding share the same bounds.\n```compile_fail\nuse veoveo_recording_contract::CreateRecordingProjectionRequest;\nfn remove_deadline(request: &mut CreateRecordingProjectionRequest) {\n    request.deadline_ms = 0;\n}\n```",
      "properties": {
        "componentIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "coordinateFrameRefs": {
          "items": {
            "$ref": "#/$defs/WorldFrameUri"
          },
          "maxItems": 64,
          "type": "array"
        },
        "datasetId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingDatasetId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        },
        "deadlineMs": {
          "format": "uint64",
          "maximum": 15000,
          "minimum": 1,
          "type": "integer"
        },
        "entityPaths": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "maximumBytes": {
          "format": "uint64",
          "maximum": 33554432,
          "minimum": 1,
          "type": "integer"
        },
        "maximumColumns": {
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "maximumEntities": {
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "maximumRows": {
          "format": "uint64",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "maximumSamples": {
          "format": "uint",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "recordingId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        },
        "sampling": {
          "$ref": "#/$defs/RecordingProjectionSampling"
        },
        "sparseFill": {
          "$ref": "#/$defs/RecordingProjectionSparseFill"
        },
        "timeline": {
          "type": "string"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "keySchema": {
                "type": "string"
              },
              "kind": "dictionary"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "datasetId",
        "recordingId",
        "entityPaths",
        "componentIds",
        "timeline",
        "sampling",
        "sparseFill",
        "maximumEntities",
        "maximumColumns",
        "maximumSamples",
        "maximumRows",
        "maximumBytes",
        "deadlineMs",
        "idempotencyKey",
        "units",
        "coordinateFrameRefs"
      ],
      "type": "object"
    },
    "RecordingProjectionHandle": {
      "additionalProperties": false,
      "description": "An immutable result with admitted shape. Consumers with the request also check agreement.\n```compile_fail\nuse veoveo_recording_contract::RecordingProjectionHandle;\nfn change_length(handle: &mut RecordingProjectionHandle) {\n    handle.result.byte_len = 1.try_into().unwrap();\n}\n```",
      "properties": {
        "datasetId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingDatasetId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "projectionId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingProjectionId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        },
        "recordingId": {
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "kind": "scalar",
              "profile": {
                "declaration": {
                  "applicability": "the declared scalar identity schema",
                  "authority": {
                    "kind": "owner",
                    "module": "veoveo_recording_contract::ids"
                  },
                  "profile": "RecordingId",
                  "version": "unversioned"
                },
                "kind": "owner_identity"
              }
            }
          },
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/RecordingProjectionResultMetadata"
        },
        "schema": {
          "$ref": "#/$defs/RecordingProjectionHandleSchema"
        }
      },
      "required": [
        "schema",
        "projectionId",
        "datasetId",
        "recordingId",
        "result",
        "expiresAt"
      ],
      "type": "object"
    },
    "RecordingProjectionHandleSchema": {
      "ai.veoveo/naming-profile": {
        "revision": 1,
        "role": {
          "kind": "scalar",
          "profile": {
            "grammar": "format_tag",
            "kind": "builtin"
          }
        }
      },
      "enum": [
        "veoveo.ai/recording-projection-handle/v2"
      ],
      "type": "string"
    },
    "RecordingProjectionResultMetadata": {
      "additionalProperties": false,
      "description": "Result facts supplied to the handle builder. File integrity is checked by the service.",
      "properties": {
        "arrowSchemaSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "byteLen": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "catalogRevision": {
          "type": "string"
        },
        "coordinateFrameRefs": {
          "items": {
            "$ref": "#/$defs/WorldFrameUri"
          },
          "maxItems": 64,
          "type": "array"
        },
        "omittedSampleCount": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payloadSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "queryDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "rowCount": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sampleGrid": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "timeline": {
          "type": "string"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "ai.veoveo/naming-profile": {
            "revision": 1,
            "role": {
              "keySchema": {
                "type": "string"
              },
              "kind": "dictionary"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "catalogRevision",
        "queryDigest",
        "timeline",
        "sampleGrid",
        "units",
        "coordinateFrameRefs",
        "omittedSampleCount",
        "rowCount",
        "arrowSchemaSha256",
        "byteLen",
        "payloadSha256"
      ],
      "type": "object"
    },
    "RecordingProjectionSampling": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "end": {
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "range",
              "type": "string"
            },
            "start": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "latest_at",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sample_grid",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "RecordingProjectionSparseFill": {
      "enum": [
        "none",
        "latest_at_global"
      ],
      "type": "string"
    },
    "WorkbenchApp": {
      "description": "Typed input for the shared host-neutral operational App shell.\n\nServers own these values and therefore retain their domain vocabulary,\nresources, tools, and authorization boundary. The shared shell owns only\nMCP Apps transport and generic presentation behavior.",
      "properties": {
        "appId": {
          "type": "string"
        },
        "emptyMessage": {
          "type": "string"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/WorkbenchResource"
          },
          "type": "array"
        },
        "streamResult": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkbenchStreamResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/WorkbenchTool"
          },
          "type": "array"
        }
      },
      "required": [
        "appId",
        "title",
        "subtitle",
        "emptyMessage",
        "resources",
        "tools"
      ],
      "type": "object"
    },
    "WorkbenchResource": {
      "description": "One canonical resource surfaced by a server-owned operational App.",
      "properties": {
        "label": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "uri"
      ],
      "type": "object"
    },
    "WorkbenchStreamResult": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "recordingProjection",
              "type": "string"
            },
            "tool_name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tool_name"
          ],
          "type": "object"
        }
      ]
    },
    "WorkbenchTool": {
      "description": "One server-owned tool surfaced by an operational App.",
      "properties": {
        "argumentsJson": {
          "description": "A JSON object shown as the editable direct-launch starting point.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "name",
        "argumentsJson"
      ],
      "type": "object"
    },
    "WorldFrameUri": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "config": {
      "$ref": "#/$defs/WorkbenchApp"
    },
    "projection": {
      "$ref": "#/$defs/RecordingProjectionHandle"
    },
    "projection_request": {
      "$ref": "#/$defs/CreateRecordingProjectionRequest"
    }
  },
  "required": [
    "config",
    "projection",
    "projection_request"
  ],
  "title": "WorkbenchContracts",
  "type": "object"
}
