{
  "$defs": {
    "CreateRecordingProjectionRequest": {
      "additionalProperties": false,
      "description": "Request construction and decoding share the same bounds.\n```compile_fail\nuse veoveo_recording_contract::CreateRecordingProjectionRequest;\nfn remove_deadline(request: &mut CreateRecordingProjectionRequest) {\n    request.deadline_ms = 0;\n}\n```",
      "properties": {
        "component_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "coordinate_frame_refs": {
          "items": {
            "$ref": "#/$defs/WorldFrameUri"
          },
          "maxItems": 64,
          "type": "array"
        },
        "dataset_id": {
          "type": "string"
        },
        "deadline_ms": {
          "format": "uint64",
          "maximum": 15000,
          "minimum": 1,
          "type": "integer"
        },
        "entity_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "idempotency_key": {
          "type": "string"
        },
        "maximum_bytes": {
          "format": "uint64",
          "maximum": 33554432,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_columns": {
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_entities": {
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_rows": {
          "format": "uint64",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_samples": {
          "format": "uint",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "recording_id": {
          "type": "string"
        },
        "sampling": {
          "$ref": "#/$defs/RecordingProjectionSampling"
        },
        "sparse_fill": {
          "$ref": "#/$defs/RecordingProjectionSparseFill"
        },
        "timeline": {
          "type": "string"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "dataset_id",
        "recording_id",
        "entity_paths",
        "component_ids",
        "timeline",
        "sampling",
        "sparse_fill",
        "maximum_entities",
        "maximum_columns",
        "maximum_samples",
        "maximum_rows",
        "maximum_bytes",
        "deadline_ms",
        "idempotency_key",
        "units",
        "coordinate_frame_refs"
      ],
      "type": "object"
    },
    "RecordingProjectionHandle": {
      "additionalProperties": false,
      "description": "An immutable result with admitted shape. Consumers with the request also check agreement.\n```compile_fail\nuse veoveo_recording_contract::RecordingProjectionHandle;\nfn change_length(handle: &mut RecordingProjectionHandle) {\n    handle.result.byte_len = 1.try_into().unwrap();\n}\n```",
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "projection_id": {
          "type": "string"
        },
        "recording_id": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/RecordingProjectionResultMetadata"
        },
        "schema": {
          "$ref": "#/$defs/RecordingProjectionHandleSchema"
        }
      },
      "required": [
        "schema",
        "projection_id",
        "dataset_id",
        "recording_id",
        "result",
        "expires_at"
      ],
      "type": "object"
    },
    "RecordingProjectionHandleSchema": {
      "enum": [
        "veoveo.ai/recording-projection-handle/v1"
      ],
      "type": "string"
    },
    "RecordingProjectionResultMetadata": {
      "additionalProperties": false,
      "description": "Result facts supplied to the handle builder. File integrity is checked by the service.",
      "properties": {
        "arrow_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "byte_len": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "catalog_revision": {
          "type": "string"
        },
        "coordinate_frame_refs": {
          "items": {
            "$ref": "#/$defs/WorldFrameUri"
          },
          "maxItems": 64,
          "type": "array"
        },
        "omitted_sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "query_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "row_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sample_grid": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "timeline": {
          "type": "string"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "catalog_revision",
        "query_digest",
        "timeline",
        "sample_grid",
        "units",
        "coordinate_frame_refs",
        "omitted_sample_count",
        "row_count",
        "arrow_schema_sha256",
        "byte_len",
        "payload_sha256"
      ],
      "type": "object"
    },
    "RecordingProjectionSampling": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "end": {
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "range",
              "type": "string"
            },
            "start": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "latest_at",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sample_grid",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "RecordingProjectionSparseFill": {
      "enum": [
        "none",
        "latest_at_global"
      ],
      "type": "string"
    },
    "WorkbenchApp": {
      "description": "Typed input for the shared host-neutral operational App shell.\n\nServers own these values and therefore retain their domain vocabulary,\nresources, tools, and authorization boundary. The shared shell owns only\nMCP Apps transport and generic presentation behavior.",
      "properties": {
        "appId": {
          "type": "string"
        },
        "emptyMessage": {
          "type": "string"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/WorkbenchResource"
          },
          "type": "array"
        },
        "streamResult": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkbenchStreamResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/WorkbenchTool"
          },
          "type": "array"
        }
      },
      "required": [
        "appId",
        "title",
        "subtitle",
        "emptyMessage",
        "resources",
        "tools"
      ],
      "type": "object"
    },
    "WorkbenchResource": {
      "description": "One canonical resource surfaced by a server-owned operational App.",
      "properties": {
        "label": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "uri"
      ],
      "type": "object"
    },
    "WorkbenchStreamResult": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "recordingProjection",
              "type": "string"
            },
            "tool_name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tool_name"
          ],
          "type": "object"
        }
      ]
    },
    "WorkbenchTool": {
      "description": "One server-owned tool surfaced by an operational App.",
      "properties": {
        "argumentsJson": {
          "description": "A JSON object shown as the editable direct-launch starting point.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "name",
        "argumentsJson"
      ],
      "type": "object"
    },
    "WorldFrameUri": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "config": {
      "$ref": "#/$defs/WorkbenchApp"
    },
    "projection": {
      "$ref": "#/$defs/RecordingProjectionHandle"
    },
    "projection_request": {
      "$ref": "#/$defs/CreateRecordingProjectionRequest"
    }
  },
  "required": [
    "config",
    "projection",
    "projection_request"
  ],
  "title": "WorkbenchContracts",
  "type": "object"
}
