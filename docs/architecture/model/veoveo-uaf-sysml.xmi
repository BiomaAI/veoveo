<?xml version='1.0' encoding='utf-8'?>
<xmi:XMI xmlns:SysML="http://www.omg.org/spec/SysML/20181001/SysML" xmlns:UAF="http://www.omg.org/spec/UAF/20241101/UAF" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:version="2.5.1">
  <uml:Model xmi:id="VV-MODEL-001" name="Veoveo UAF SysML Reference Architecture">
    <profileApplication xmi:type="uml:ProfileApplication" xmi:id="VV-PROFILE-UAF">
      <appliedProfile href="https://www.omg.org/spec/UAF/20241101/UAF.xml#UAF" />
    </profileApplication>
    <profileApplication xmi:type="uml:ProfileApplication" xmi:id="VV-PROFILE-SYSML">
      <appliedProfile href="https://www.omg.org/spec/SysML/20181001/SysML.xmi#SysML" />
    </profileApplication>
    <packagedElement xmi:type="uml:Package" xmi:id="VV-PKG-STRATEGIC" name="Strategic">
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-001" name="Governed MCP access">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-001-COMMENT" body="Policy-scoped discovery and use of complete MCP domain surfaces." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-002" name="Durable asynchronous work">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-002-COMMENT" body="Long operations survive restart with explicit recovery semantics." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-003" name="Governed artifacts">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-003-COMMENT" body="Outputs retain identity, integrity, access, release, retention, and sharing policy." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-004" name="Governed world recording">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-004-COMMENT" body="Sensor and simulation evidence is pushed into durable RRD recordings." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-005" name="Bounded analytics">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-005-COMMENT" body="Arbitrary SQL, forecasting, and charts execute inside owned limits." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-006" name="Local stream processing">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-006-COMMENT" body="Admitted live media graphs and reproducible recording replays execute inside the installation." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-007" name="Autonomous agent operation">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-007-COMMENT" body="Bounded episodes persist scheduling, wakes, work, memory, and evidence." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-008" name="Secure enterprise integration">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-008-COMMENT" body="Installation-owned identity, policy, audit, tenancy, and internal trust compose." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-009" name="Operations oversight">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-009-COMMENT" body="Operators inspect and administer live work without exposing bearer credentials." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-010" name="Connected and offline deployment">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-010-COMMENT" body="One Helm service graph runs in local k3d or fielded Kubernetes with verified offline transfer." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-011" name="Geospatial logistics">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-011-COMMENT" body="Governed data releases support geodesy, restrictions, routing, and logistics matrices." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-012" name="Extensible hosted domains">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-012-COMMENT" body="Shared Rust contracts and validated Python models add servers without weakening canonical protocol behavior." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CAP-013" name="Operational optimization">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CAP-013-COMMENT" body="Typed fleet-routing and mathematical decisions execute on a required GPU and retain independently verified evidence." />
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="VV-PKG-OPERATIONAL" name="Operational">
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-001" name="Authenticate and authorize request">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-001-COMMENT" body="Resolve identity, tenant, profile, scopes, policy, and audit context." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-002" name="Discover and invoke domain capability">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-002-COMMENT" body="Use tools, resources, prompts, completions, tasks, or subscriptions." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-003" name="Execute and recover durable work">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-003-COMMENT" body="Persist task ownership, transitions, recovery class, result, and event order." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-004" name="Publish and share governed output">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-004-COMMENT" body="Create artifact occurrence, store bytes, apply access, and release deliberately." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-005" name="Ingest and query world evidence">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-005-COMMENT" body="Push Rerun observations, freeze segments, authorize, and query logical recordings." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-006" name="Analyze and route governed data">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-006-COMMENT" body="Transform governed inputs into analytical and geospatial products." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-007" name="Process live and recorded media">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-007-COMMENT" body="Run admitted live graphs immediately or replay authorized video and publish governed results." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-008" name="Run bounded agent episode">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-008-COMMENT" body="Wake, assemble context, reason, invoke work, detach, persist, and record evidence." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-009" name="Administer installation">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-009-COMMENT" body="Inspect health, work, topology, policy, audit, and authorized domain configuration." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-010" name="Deploy and verify installation">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-010-COMMENT" body="Bootstrap, configure, validate, observe, and transfer connected or offline forms." />
      </packagedElement>
      <packagedElement xmi:type="uml:Activity" xmi:id="VV-OPA-011" name="Formulate solve and verify decisions">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-OPA-011-COMMENT" body="Compile typed routing or mathematical models, execute cuOpt, independently verify results, and publish evidence." />
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="VV-PKG-SERVICES" name="Services">
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-001" name="MCP aggregation service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-001-COMMENT" body="Discovers hosted surfaces and projects policy-scoped profiles." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-002" name="Identity and authorization service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-002-COMMENT" body="Federates OIDC and issues resource-bound external and internal tokens." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-003" name="Durable work coordination service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-003-COMMENT" body="Coordinates task state, recovery, input, cancellation, result, and notifications." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-004" name="Artifact governance service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-004-COMMENT" body="Controls artifact identity, bytes, grants, release, capabilities, and sharing." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-005" name="Recording durability service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-005-COMMENT" body="Authenticates world streams and maintains crash-decodable governed recordings." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-006" name="Domain compute service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-006-COMMENT" body="Runs analytical, forecasting, frame, and chart workloads." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-007" name="Agent execution service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-007-COMMENT" body="Runs restart-safe bounded episodes over governed context and tools." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-008" name="Operations console service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-008-COMMENT" body="Projects safe operational state and explicit administrative actions." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-009" name="Deployment and assurance service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-009-COMMENT" body="Builds, deploys, transfers, validates, and verifies installation forms." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-010" name="Telemetry and audit service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-010-COMMENT" body="Captures decision evidence and approved operational signals." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-011" name="Geospatial logistics service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-011-COMMENT" body="Governs map releases and serves routing and spatial operations." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-012" name="Stream processing service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-012-COMMENT" body="Runs local bounded GStreamer graphs over arriving media or governed recordings." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SVC-013" name="GPU optimization service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SVC-013-COMMENT" body="Compiles typed decisions, executes pinned cuOpt on NVIDIA hardware, and publishes independently verified solutions." />
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="VV-PKG-RESOURCES" name="Resources">
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-001" name="MCP gateway">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-001-COMMENT" body="Aggregates policy-scoped MCP profiles; terminates OAuth; evaluates policy; records audit; issues short-lived internal identity; proxies declared hosted-server administration projections and governed artifact downloads." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-002" name="Console BFF">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-002-COMMENT" body="Owns the browser security boundary, PKCE login, encrypted HttpOnly sessions, CSRF enforcement, installation projections, and explicit administrative workflows." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-003" name="Operations console web application">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-003-COMMENT" body="Presents health, tasks, artifacts, agents, recordings, MCP topology, policy, audit, and installation state without receiving gateway bearer tokens." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-004" name="Artifact service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-004-COMMENT" body="Enforces tenant, label, grant, release, retention, share-link, and write-capability policy for governed artifact occurrences and bytes." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-005" name="Recording Hub">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-005-COMMENT" body="Accepts gateway-authorized recording batches, journals small durable RRD parts, and publishes keyframe-aligned immutable archive shards through one footer-writing object-store compaction pass." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-006" name="Agent kernel">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-006-COMMENT" body="Runs bounded autonomous episodes with MCP tools, durable input requests, memory, replay, budgets, recording, and detach/resume behavior." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-007" name="Agent runtime">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-007-COMMENT" body="Persists agents, wakes, episodes, watcher leases, retry schedules, task descriptors, results, and retention pins across process restart." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-008" name="Platform store">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-008-COMMENT" body="Owns persistence record types, ordered migrations, stable identities, transactional outbox, changefeed replay, and platform-store access." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-009" name="Durable task runtime">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-009-COMMENT" body="Owns UUIDv7 task creation, idempotency, leases, claims, progress, durable input, cancellation, terminal results, retention, recovery, and outbox transitions." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-010" name="DuckDB runtime">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-010-COMMENT" body="Provides owner-scoped DuckDB workspace construction and locked analytical execution primitives." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-011" name="Shared MCP contract">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-011-COMMENT" body="Defines cross-service Rust models and domain identifiers for gateway configuration, policy vocabulary, artifacts, coordinates, storage, tasks, subscriptions, usage, and URI conventions." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-013" name="MCP stdio bridge">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-013-COMMENT" body="Projects a child stdio MCP server onto bounded Streamable HTTP while preserving the registered gateway identity." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-014" name="Artifact client">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-014-COMMENT" body="Provides the native Rust client for artifact metadata, capabilities, upload, download, grants, release, and sharing operations." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-015" name="RRD library">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-015-COMMENT" body="Provides Rerun/RRD read, merge, query, and recording utility behavior shared by the platform." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-016" name="Artifact MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-016-COMMENT" body="Exposes governed artifact discovery, metadata, grants, release states, share links, subscriptions, prompts, and completions through canonical artifact URIs." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-017" name="Frames MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-017-COMMENT" body="Converts WGS84, ECEF, ENU, and NED frames; derives local frames; persists coordinate operations; and executes durable batches." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-018" name="DuckDB MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-018-COMMENT" body="Executes arbitrary query, execute, ingest, and export SQL inside bounded owner-scoped workspaces with governed inputs and outputs." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-019" name="Media MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-019-COMMENT" body="Provides provider-neutral media model discovery, schemas, generation tasks, webhook-only provider completion, usage reconciliation, and governed output artifacts." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-020" name="Map MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-020-COMMENT" body="Governs map sources and releases; performs geodesy, CRS transformation, location inspection, restrictions, reachable areas, routing, logistics matrices, and immutable cuOpt travel-model publication." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-021" name="Optimization MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-021-COMMENT" body="Owns the typed routing, route-scenario, convex, and MILP contract; compiles controlled models; coordinates durable GPU work; independently verifies solver output; and publishes immutable problem, run, solution, and verification evidence." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-022" name="Stream MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-022-COMMENT" body="Runs operator-admitted GStreamer graphs directly over live encoded media or authorized recording ranges; exposes an MCP App for encoded preview and typed overlays; publishes governed replay results; and may route existing encoded live output to Recording Hub without delaying processing." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-023" name="Recording MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-023-COMMENT" body="Applies tenant and label authorization to recording discovery, query, sealing, subscriptions, artifact publication, recording-scoped lazy Redap playback, and bounded-history live following." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-024" name="Timeseries MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-024-COMMENT" body="Runs forecasting as durable work and publishes forecast artifacts and RRD output." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-025" name="Datasheet MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-025-COMMENT" body="Demonstrates the Python platform contract through dataset preview, column statistics, task-based profiling, prompts, completions, resources, and notifications." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-026" name="Chart MCP packaged service">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-026-COMMENT" body="Packages the pinned chart MCP implementation and exposes chart compilation, validation, rendering, view creation, resources, and prompts through the gateway." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-027" name="Rerun viewer MCP child">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-027-COMMENT" body="Provides the Rerun viewer's MCP tool surface under the registered rerun server identity." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-028" name="SUMO MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-028-COMMENT" body="Owns serialized TraCI access, exposes traffic reads and actuation, runs durable generation and optimization tasks, and pushes world state to a pod-local Recording forwarder." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-029" name="SUMO simulator and LuST world">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-029-COMMENT" body="Runs the pinned LuST traffic scenario and exposes private TraCI control to the SUMO MCP owner." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-030" name="Python hosted-server SDK">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-030-COMMENT" body="Provides Python models and helpers for identity, pagination, internal authentication, telemetry, artifacts, deployment, task runtime, and official Tasks SDK hooks." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-031" name="Map data acquisition helper">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-031-COMMENT" body="Normalizes authoritative OSM, GTFS, maritime, aviation, and authority datasets into bounded acquisition products." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-032" name="Stream GStreamer runner">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-032-COMMENT" body="Executes one admitted GStreamer graph; emits existing encoded access units for the Stream App and optional recording route; and converts native DeepStream metadata into typed detections for perception profiles." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-033" name="MCP conformance client">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-033-COMMENT" body="Certifies a running hosted server through a typed domain-neutral profile and machine-readable report." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-034" name="Rust smoke harness">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-034-COMMENT" body="Owns multi-process and container lifecycle, readiness, timeouts, cleanup, MCP and HTTP calls, assertions, and deployment contract verification." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-035" name="k3d local development environment">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-035-COMMENT" body="Creates a current K3s cluster with mandatory NVIDIA GPU access, imports local images, and applies profile-owned Helm values without selecting a simulator in generic configuration." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-036" name="Helm deployment chart">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-036-COMMENT" body="Instantiates the service graph with existing secrets, network policy, persistent storage, optional service-mesh mTLS, and ingress controls." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-037" name="Offline bundle builder and loader">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-037-COMMENT" body="Builds and verifies digest-pinned images, configuration schemas, checksums, SPDX SBOMs, and Helm material without requiring target-network access." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-038" name="SurrealDB platform database">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-038-COMMENT" body="Provides the sole durable coordination store for identity, control, policy, tasks, artifacts, recordings, agents, audit, and outbox state." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-039" name="S3-compatible object store">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-039-COMMENT" body="Stores governed artifact bytes while the Artifact service owns identity and authorization." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-040" name="Installation edge and ingress">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-040-COMMENT" body="Terminates installation ingress and exposes only console, gateway, public share redemption, and required provider plumbing routes." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-041" name="Enterprise identity provider">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-041-COMMENT" body="Authenticates users and clients and supplies issuer, JWKS, claims, authorization, and token endpoints to the gateway trust configuration." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-042" name="OpenTelemetry collector and SIEM export">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-042-COMMENT" body="Receives logs, traces, metrics, and audit-compatible telemetry and forwards installation-approved signals." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-043" name="Media generation provider">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-043-COMMENT" body="Accepts media jobs, delivers signed terminal webhooks, and provides output bytes only to the bounded server-side completion path." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-044" name="NVIDIA DeepStream and TensorRT runtime">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-044-COMMENT" body="Decodes H.264, executes site-approved TensorRT engines, and emits native detection and tracking metadata without starting a Triton service." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-045" name="DuckDB and Spatial runtime">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-045-COMMENT" body="Provides arbitrary analytical SQL, spatial functions, bounded owner workspaces, spill, ingest, and export execution." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-046" name="Map processing and routing toolchain">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-046-COMMENT" body="Builds and serves routing tiles, constructs vehicle-specific route and travel matrices, transforms geospatial data, and validates transit datasets under the Map MCP owner." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-047" name="Rerun data model and transport">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-047-COMMENT" body="Carries world logs into producer-local forwarders, encodes footer-indexed RRD shards, supports lazy Redap chunk reads and bounded live following, and renders recording evidence." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-048" name="Container execution environment">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-048-COMMENT" body="Runs isolated service images, networks, volumes, secrets, resource limits, GPUs, and deployment health controls." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-049" name="Time MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-049-COMMENT" body="Resolves civil, military, GNSS, and mission time against versioned authority releases; evaluates calendars and windows; observes clock quality; publishes temporal events; and runs durable timeline work." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-050" name="View MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-050-COMMENT" body="Maintains owner-scoped camera views over configured 3D Tiles, bounds network and CPU/GPU residency, renders offscreen with NVIDIA Vulkan, and returns frames with attribution and capture metadata." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-051" name="Recording forwarder">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-051-COMMENT" body="Receives native Rerun traffic on producer loopback, persists a bounded queue, authenticates with OAuth private_key_jwt, resumes from durable checkpoints, and uploads versioned batches through the gateway." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-052" name="MCP Apps extension">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-052-COMMENT" body="Owns the pinned MCP Apps extension constants, typed UI metadata, application resources, capability declarations, tool links, and sandbox-host message helpers." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-053" name="Recording ingest protocol">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-053-COMMENT" body="Owns the canonical versioned protobuf schema, media type, routes, limits, digest validation, stream checkpoints, discovery records, and typed recording ingest errors." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-054" name="UAV Simulation MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-054-COMMENT" body="Governs simulation sessions, missions, vehicles, tiles, recording references, durable tasks, authoritative logical cameras, shared camera products, ephemeral actor/browser stream authorizations, authenticated WebSocket delivery, resources, subscriptions, prompts, and typed adapter commands without exposing simulator-native control ports." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-055" name="UAV simulation runtime and adapter">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-055-COMMENT" body="Owns the typed pod-private simulator adapter, repository UAV asset, batched CUDA Warp plant and HIL sensors, Newton Experimental fleet state, PX4 lifecycle, simulator-tick logical cameras, one continuous RTX/NVENC H.264 product per streamable camera, keyframe-aware fan-out, camera and telemetry capture, frame conversion, and Rerun publication." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-056" name="UAV simulation execution stack">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-056-COMMENT" body="Renders Google Photorealistic 3D Tiles, advances Newton rigid bodies, executes Warp kernels on CUDA, and runs PX4 autopilot instances against the repository HIL boundary." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-057" name="Reason MCP server">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-057-COMMENT" body="Authorizes recorded video, runs bounded local world-model inference, grounds semantic events in recording time, and publishes governed annotations and reports." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-058" name="Recorded video materialization">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-058-COMMENT" body="Applies recording authority, resolves frozen or sealed RRD segments, extracts decoder-reentrant keyframe ranges, and remuxes bounded H.264 selections without re-encoding." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-060" name="Deployment profile contract">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-060-COMMENT" body="Owns the typed repository deployment-profile schema and validates the image targets and managed GPU allocator selected by an installation profile." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-061" name="Repository build and release orchestrator">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-061-COMMENT" body="Resolves source-local Bake selections into typed Cargo builder families, verifies cache and toolchain policy, maintains publication worktrees, and records image build evidence." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-062" name="Bioma composition acceptance">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-062-COMMENT" body="Owns static contract and cross-surface acceptance for the Bioma enterprise composition without making core gateway conformance depend on example configuration." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-063" name="External extension contract">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-063-COMMENT" body="Defines and validates versioned compatibility manifests extension releases private artifact coordinates simulation build locks and immutable conformance evidence for independently owned repositories." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-064" name="Gateway composer">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-064-COMMENT" body="Deterministically joins extension-owned server fragments with installation-owned bindings and emits a canonically validated gateway control plane requirements closure and provenance." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-070" name="cuOpt executor">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-070-COMMENT" body="Loads the pinned cuOpt runtime, owns the CUDA context and bounded RMM pool, executes one prepared routing batch or mathematical model at a time, and returns solver-native results to the Rust control plane." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-071" name="NVIDIA cuOpt and CUDA runtime">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-071-COMMENT" body="Executes heterogeneous vehicle routing and BatchSolve plus continuous LP QP QCQP SOCP and linear MILP formulations on an NVIDIA GPU." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-072" name="Headed browser smoke harness">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-072-COMMENT" body="Attaches to a headed browser, proves a hardware-backed WebGPU or WebGL context, drives authenticated Console live-view acceptance, and records bounded visual evidence." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-073" name="Deployment smoke harness">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-073-COMMENT" body="Validates typed deployment profiles and drives focused installation readiness without compiling unrelated protocol or visual scenarios." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-074" name="Image build control">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-074-COMMENT" body="Owns the shared pinned Buildx and BuildKit configuration, cross-worktree builder lease, cache namespaces, and deterministic builder preparation used by image publication and certification." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-075" name="Legacy MCP bridge">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-CMP-075-COMMENT" body="Terminates one MCP 2025-11-25 local stdio child or remote HTTP connection and projects only exactly translatable tools resources prompts and completions through an MCP 2026-07-28 stateless endpoint." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-SYS-001" name="Veoveo Installation System">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-SYS-001-COMMENT" body="Aggregate resource performer composed from the canonical Veoveo software and infrastructure service graph." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-001" name="External MCP profile access" informationSource="VV-EXT-MCP-CLIENT" informationTarget="VV-CMP-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-001-COMMENT" body="HTTPS; sessionful MCP Streamable HTTP with event-stream responses; JSON-RPC. Direction: bidirectional. Identity and policy: Gateway OAuth access token bound to profile and protected resource; per-method and target-aware policy. Data: Tools, resources, templates, prompts, completions, tasks, subscriptions, notifications, structured content. Availability and recovery: One active gateway process owns every client session." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-002" name="Browser console access" informationSource="VV-EXT-BROWSER" informationTarget="VV-CMP-002">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-002-COMMENT" body="HTTPS; HTML; same-origin JSON. Direction: bidirectional. Identity and policy: Encrypted HttpOnly SameSite session plus CSRF on unsafe requests. Data: Installation projections, task controls, artifact workflows, and hosted MCP Apps. Availability and recovery: Browser never receives gateway bearer; BFF replicas use encrypted cookie state." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-003" name="Console static application" informationSource="VV-CMP-002" informationTarget="VV-CMP-003">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-003-COMMENT" body="HTTPS static assets. Direction: outbound. Identity and policy: CSP, frame denial, MIME sniff prevention, and same-origin referrer policy. Data: React application assets. Availability and recovery: Immutable build assets." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-004" name="Console to gateway administration" informationSource="VV-CMP-002" informationTarget="VV-CMP-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-004-COMMENT" body="HTTPS; gateway administration and artifact routes. Direction: bidirectional. Identity and policy: BFF-held OAuth token; gateway policy and audit. Data: Safe installation projection and explicit mutations. Availability and recovery: BFF refresh rotation uses durable gateway token family state." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-005" name="Enterprise identity federation" informationSource="VV-CMP-001" informationTarget="VV-CMP-041">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-005-COMMENT" body="OIDC discovery; OAuth 2.0; JWKS HTTPS. Direction: bidirectional. Identity and policy: Issuer, key, claim, tenant, client, scope, and protected-resource validation. Data: Authorization requests, tokens, claims, public keys. Availability and recovery: Unknown issuers or keys fail closed." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-006" name="Gateway OAuth service" informationSource="VV-EXT-OAUTH-CLIENT" informationTarget="VV-CMP-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-006-COMMENT" body="OAuth authorization code with PKCE; client credentials; client assertions; ID-JAG. Direction: bidirectional. Identity and policy: Authorization server policy; rotating refresh families; replay detection. Data: Authorization codes, access tokens, refresh tokens, metadata. Availability and recovery: Durable compare-and-swap rotation and bounded duplicate delivery." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-007" name="Gateway hosted-server MCP" informationSource="VV-CMP-001" informationTarget="VV-CMP-HOSTED">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-007-COMMENT" body="Private HTTP; MCP Streamable HTTP. Direction: bidirectional. Identity and policy: Short-lived Ed25519 internal assertion with audience, principal, tenant, labels, and scopes. Data: Canonical server MCP requests and responses. Availability and recovery: Gateway reconnects per request/session; server state is durable where required." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-008" name="Gateway hosted-server administration projection" informationSource="VV-CMP-001" informationTarget="VV-CMP-HOSTED">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-008-COMMENT" body="Optional private HTTP under a declared server admin mount. Direction: bidirectional. Identity and policy: AdminRead or AdminWrite policy, audit, and short-lived internal assertion. Data: Bounded projection of canonical domain request and response models. Availability and recovery: Owning server reuses MCP models identities and state; the projection is never a second authority." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-009" name="Platform persistence" informationSource="VV-CMP-PLATFORM" informationTarget="VV-CMP-038">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-009-COMMENT" body="SurrealDB WebSocket at database scope. Direction: bidirectional. Identity and policy: Dedicated runtime credentials; tenant-scoped persistence APIs. Data: Identity, policy, control, tasks, artifacts, recordings, agents, audit, outbox. Availability and recovery: Transactional outbox is authoritative; LIVE is a latency path only." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-010" name="Installation bootstrap" informationSource="VV-CMP-001" informationTarget="VV-CMP-038">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-010-COMMENT" body="SurrealDB WebSocket at root scope. Direction: outbound. Identity and policy: Separate bootstrap credentials. Data: Ordered migrations, runtime user rotation, initial control revision. Availability and recovery: Runs to completion before long-lived services." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-011" name="Official Tasks projection" informationSource="VV-CMP-HOSTED" informationTarget="VV-CMP-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-011-COMMENT" body="MCP 2026-07-28 Tasks and request-scoped subscriptions over stateless Streamable HTTP. Direction: bidirectional. Identity and policy: Same principal and policy context as tool invocation. Data: Task create, get, update, cancel, status notifications, progress, terminal result. Availability and recovery: Projects the shared task runtime without a second task store." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-012" name="Task persistence" informationSource="VV-CMP-009" informationTarget="VV-CMP-008">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-012-COMMENT" body="Rust API and transactional outbox. Direction: bidirectional. Identity and policy: Task owner includes tenant, principal, profile, server, and operation. Data: Tasks, leases, inputs, results, provider jobs, retention pins. Availability and recovery: Resume." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-013" name="Domain artifact operations" informationSource="VV-CMP-HOSTED" informationTarget="VV-CMP-004">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-013-COMMENT" body="Private HTTP through artifact client or Python SDK. Direction: bidirectional. Identity and policy: Forwarded internal identity or task-bound write capability. Data: Metadata, capabilities, uploads, downloads, grants, releases, share links. Availability and recovery: Idempotent capability redemption and durable artifact records." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-014" name="Artifact byte storage" informationSource="VV-CMP-004" informationTarget="VV-CMP-039">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-014-COMMENT" body="Private S3-compatible API. Direction: bidirectional. Identity and policy: Installation object-store credentials; Artifact service and bucket initialization only. Data: Artifact blob bytes. Availability and recovery: Tenant-derived storage keys and content integrity hashes." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-015" name="Authorized artifact download" informationSource="VV-EXT-AUTHORIZED-USER" informationTarget="VV-CMP-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-015-COMMENT" body="HTTPS GET or HEAD /artifacts/{profile}/{artifact_id}/download with one optional byte range. Direction: inbound. Identity and policy: Gateway policy and audit; service-side authorization. Data: Backpressured artifact byte stream on the installation origin. Availability and recovery: No domain-specific byte route or storage redirect." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-016" name="Public artifact redemption" informationSource="VV-EXT-LINK-HOLDER" informationTarget="VV-CMP-004">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-016-COMMENT" body="HTTPS GET or HEAD /s/{token} with one optional byte range. Direction: inbound. Identity and policy: Random read-only bearer; hash-only storage; expiry, limit, release state, revocation. Data: Backpressured artifact byte stream on the installation origin. Availability and recovery: Edge logging suppresses bearer path." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-017" name="Producer recording publication" informationSource="VV-EXT-PRODUCER" informationTarget="VV-CMP-051">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-017-COMMENT" body="Producer-loopback Rerun gRPC. Direction: outbound. Identity and policy: Loopback receiver; application and recording identities are validated before upload. Data: Native Rerun log messages. Availability and recovery: Forwarder applies persistent bounded backpressure and restart replay." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-018" name="Governed recording playback" informationSource="VV-EXT-BROWSER" informationTarget="VV-CMP-023">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-018-COMMENT" body="HTTPS manifest through Console BFF and gateway; recording-scoped Rerun Data Protocol over HTTP/2 or gRPC-Web; authenticated framed complete RRD stream into a Rerun WebViewer LogChannel. Direction: inbound. Identity and policy: Gateway policy and audit establish a five-minute actor-and-recording session; standard Redap read token is host-limited; the live stream carries the HttpOnly Console session; enumeration and mutation are denied. Data: One stable dataset-segment URI with immutable shard layers and revision; footer-indexed chunks fetched on demand; recent native Rerun messages under the same recording identity. Availability and recovery: Derived Redap catalogs rebuild from the durable catalog and shards; live rollover advances the existing stream and WebViewer channel." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-019" name="Stream recording replay" informationSource="VV-CMP-022" informationTarget="VV-CMP-005">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-019-COMMENT" body="Read-only RRD files plus SurrealDB catalog. Direction: inbound. Identity and policy: Canonical recording URI authorization; classification and labels propagate. Data: H.264 VideoStream samples, timestamps, keyframes. Availability and recovery: Replay captures one task-start snapshot of complete acknowledged parts." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-020" name="Stream native runner" informationSource="VV-CMP-022" informationTarget="VV-CMP-032">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-020-COMMENT" body="Closed JSON request and response or newline-delimited event socket. Direction: bidirectional. Identity and policy: Operator-admitted graph and mounted configuration; owner-scoped live session or task filesystem boundary. Data: Runner request, H.264 access units, detections, tracks, source indices. Availability and recovery: One bounded subprocess per live session or replay task." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-021" name="DeepStream execution" informationSource="VV-CMP-032" informationTarget="VV-CMP-044">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-021-COMMENT" body="GStreamer, CUDA, NVDEC, TensorRT, NVIDIA metadata. Direction: bidirectional. Identity and policy: Mounted approved engine and coherent host-driver libraries. Data: H.264 frames, tensors, detections, tracks. Availability and recovery: No CPU inference fallback and no Triton server process." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-022" name="Media provider submission" informationSource="VV-CMP-019" informationTarget="VV-CMP-043">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-022-COMMENT" body="Provider HTTPS API. Direction: outbound. Identity and policy: Provider credential held only by media server. Data: Bounded provider request and deletion request. Availability and recovery: Submission binding commits before task detaches." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-023" name="Media terminal webhook" informationSource="VV-CMP-043" informationTarget="VV-CMP-019">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-023-COMMENT" body="Signed HTTPS webhook. Direction: inbound. Identity and policy: Provider signature and unique event validation. Data: Terminal event, output references, usage facts. Availability and recovery: Webhook-only completion; missing delivery is operational failure." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-024" name="Analytical execution" informationSource="VV-CMP-018" informationTarget="VV-CMP-045">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-024-COMMENT" body="Embedded DuckDB API and arbitrary SQL. Direction: bidirectional. Identity and policy: Owner-derived workspace and locked engine settings. Data: Queries, mutations, ingests, exports, spatial operations. Availability and recovery: Read work may resume; uncertain mutation is never replayed." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-025" name="Map acquisition helper" informationSource="VV-CMP-020" informationTarget="VV-CMP-031">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-025-COMMENT" body="JSON subprocess contract and filesystem exchange. Direction: bidirectional. Identity and policy: Registered source policy, bounded paths, network controls. Data: OSM, GTFS, maritime, aviation, and authority acquisition products. Availability and recovery: Acquisition tasks persist durable state and immutable release identities." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-026" name="Map routing toolchain" informationSource="VV-CMP-020" informationTarget="VV-CMP-046">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-026-COMMENT" body="Local process and HTTP APIs. Direction: bidirectional. Identity and policy: Container-local endpoints and governed active release. Data: Routing tiles, route requests, matrices, reachable areas. Availability and recovery: Active release dependencies are recorded with route products." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-027" name="Rerun viewer bridge" informationSource="VV-CMP-013" informationTarget="VV-CMP-027">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-027-COMMENT" body="MCP stdio child to Streamable HTTP parent. Direction: bidirectional. Identity and policy: Gateway profile controls the external HTTP projection. Data: Viewer MCP tools. Availability and recovery: Bridge process owns child lifecycle." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-028" name="World recording publication" informationSource="VV-CMP-028" informationTarget="VV-CMP-051">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-028-COMMENT" body="Pod-loopback Rerun gRPC. Direction: outbound. Identity and policy: Producer-local transport; gateway policy later binds the registered application and tenant. Data: SUMO world frames. Availability and recovery: Recording Hub never polls SUMO." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-029" name="SUMO control" informationSource="VV-CMP-028" informationTarget="VV-CMP-029">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-029-COMMENT" body="Private TraCI TCP. Direction: bidirectional. Identity and policy: Single serialized owner; not published to host. Data: Simulation state, signals, vehicles, network actuation. Availability and recovery: Uncertain mutating batch execution is interrupted-indeterminate." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-030" name="Telemetry export" informationSource="VV-CMP-PLATFORM" informationTarget="VV-CMP-042">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-030-COMMENT" body="OTLP gRPC or HTTP. Direction: outbound. Identity and policy: Installation-selected exporter and SIEM credentials. Data: Logs, traces, metrics, audit-compatible events. Availability and recovery: Telemetry excludes tokens." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-031" name="Local cluster control" informationSource="VV-CMP-035" informationTarget="VV-CMP-048">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-031-COMMENT" body="k3d, Docker image, and Kubernetes APIs. Direction: outbound. Identity and policy: Local operator access and development Secrets. Data: K3s node, GPU runtime, images, ports, and kubeconfig. Availability and recovery: k3d is the canonical local Kubernetes substrate." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-032" name="Kubernetes deployment control" informationSource="VV-CMP-036" informationTarget="VV-CMP-048">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-032-COMMENT" body="Helm and Kubernetes APIs. Direction: outbound. Identity and policy: Installation operator RBAC and existing Secrets. Data: Workloads, Services, Ingress, NetworkPolicy, volumes, mTLS annotations. Availability and recovery: Helm preserves the same service graph and explicit singleton resources." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-033" name="Offline transfer" informationSource="VV-CMP-037" informationTarget="VV-CMP-048">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-033-COMMENT" body="Verified tar and OCI image archives. Direction: outbound. Identity and policy: SHA-256 checksums, resolved identities, SPDX SBOMs. Data: Images, Helm values, schemas, manifests, evidence. Availability and recovery: Loader performs no network operation." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-034" name="Authenticated recording upload" informationSource="VV-CMP-051" informationTarget="VV-CMP-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-034-COMMENT" body="HTTPS; OAuth discovery; client_credentials with private_key_jwt; versioned protobuf. Direction: outbound. Identity and policy: Resource-bound recording:ingest token; producer registration; tenant dataset application label retention and quota policy. Data: Idempotent stream open status append finish operations and RRD batches. Availability and recovery: At-least-once retry resumes from Hub durable and materialized checkpoints." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-035" name="Gateway recording delivery" informationSource="VV-CMP-001" informationTarget="VV-CMP-005">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-035-COMMENT" body="Private HTTP; versioned protobuf. Direction: outbound. Identity and policy: Gateway policy and audit; short-lived internal assertion addressed to Recording Hub. Data: Authorized producer binding and validated recording operations. Availability and recovery: Hub fsyncs journal state and materializes the batch before acknowledgement." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-036" name="UAV simulation and live-view control" informationSource="VV-CMP-054" informationTarget="VV-CMP-055">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-036-COMMENT" body="Pod-private typed HTTP and WebSocket. Direction: bidirectional. Identity and policy: Gateway-forwarded caller owns the MCP operation; the simulator adapter is not externally routed. Data: Session state vehicle commands missions logical camera definitions shared camera products H.264 access units capture requests tiles and health. Availability and recovery: Reads remain available during durable work; viewer authorization is idempotent by actor browser instance and logical camera; uncertain live mutations are interrupted-indeterminate." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-037" name="UAV recording publication" informationSource="VV-CMP-055" informationTarget="VV-CMP-051">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-037-COMMENT" body="Pod-loopback Rerun gRPC. Direction: outbound. Identity and policy: Producer-local transport; registered application and tenant authority are enforced at gateway upload. Data: Camera H.264 poses transforms IMU vehicles missions collisions and tile diagnostics. Availability and recovery: Dedicated persistent forwarder queue survives producer or network restart." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-038" name="UAV simulator execution" informationSource="VV-CMP-055" informationTarget="VV-CMP-056">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-038-COMMENT" body="Isaac Experimental and Python APIs; USD; Newton; Warp CUDA; Vulkan; NVENC; RTSP; H.264; MAVLink 2. Direction: bidirectional. Identity and policy: Pinned dependency identities; provider credential from Kubernetes Secret; canonical Frames identity; hardware GPU required. Data: Rendered tiles authoritative logical cameras shared camera products H.264 bitstreams multirotor state PX4 commands and telemetry. Availability and recovery: Explicit startup readiness bounded mission execution one native GPU product per streamable camera and no simulator-native public control port." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-039" name="Live Stream publication" informationSource="VV-EXT-PRODUCER" informationTarget="VV-CMP-022">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-039-COMMENT" body="RTP 2.0 with RFC 6184 H.264 over admitted UDP. Direction: outbound. Identity and policy: Installation NetworkPolicy and one operator-admitted pipeline endpoint. Data: Annex B H.264 access units with 90 kHz timestamps. Availability and recovery: Live processing begins on arriving frames without resolving or waiting for Recording Hub." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-040" name="Recording catalog and shard access" informationSource="VV-CMP-023" informationTarget="VV-CMP-005">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-040-COMMENT" body="SurrealDB catalog; read-only footer-indexed RRD shards; complete acknowledged ingest parts. Direction: inbound. Identity and policy: Tenant and data-label authorization precedes every physical playback or analysis plan. Data: Logical recording metadata, immutable shard identities, and bounded writing-segment snapshots. Availability and recovery: Immutable sources remain zero-copy; derived read state is reconstructible; task snapshots never read incomplete writes." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-041" name="Map travel-model handoff" informationSource="VV-CMP-020" informationTarget="VV-CMP-021">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-041-COMMENT" body="veoveo.io/travel-model-artifact/v1; map://travel-model identity; artifact occurrence and bytes. Direction: outbound. Identity and policy: Caller access and labels apply at both domains; map release mobility profile restriction snapshot units and digest remain immutable. Data: Controlled location and vehicle-type order; cost and transit-time matrices; unavailable arcs; provenance. Availability and recovery: Optimization resolves the exact governed occurrence through the artifact plane and never recomputes GIS costs." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-042" name="Optimization executor control" informationSource="VV-CMP-021" informationTarget="VV-CMP-070">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-042-COMMENT" body="veoveo.io/cuopt-executor/v1; private Unix-domain socket; unsigned 64-bit big-endian length prefix; bounded JSON messages. Direction: bidirectional. Identity and policy: Pod-local transport is not a public authority; task owner policy and artifact access remain in the Rust control plane; staged inputs are digest-checked. Data: Health solve cancel and shutdown operations; prepared-problem path digest and bounds; solver result or typed error. Availability and recovery: The control plane owns durable state and serial GPU admission; missing socket health version or digest fails readiness or the task." />
      </packagedElement>
      <packagedElement xmi:type="uml:InformationFlow" xmi:id="VV-IF-043" name="cuOpt GPU execution" informationSource="VV-CMP-070" informationTarget="VV-CMP-071">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-IF-043-COMMENT" body="Python cuOpt 26.06 API; CUDA 13.2; RMM. Direction: bidirectional. Identity and policy: Digest-pinned runtime and one visible NVIDIA GPU are mandatory; the executor accepts only compiled bounded formulations. Data: Routing Solve and BatchSolve arrays; sparse mathematical models; solver controls; routes variables objectives duals and statuses. Availability and recovery: No CPU solver or GPU-optional mode exists; incompatible cuOpt CUDA driver or GPU identity fails closed." />
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="VV-PKG-ACTUAL" name="Actual Resources">
      <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="VV-AR-001" name="k3d local development installation" classifier="VV-SYS-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-AR-001-COMMENT" body="Reference fielded configuration of the Veoveo Installation System, configured by VV-CMP-035." />
      </packagedElement>
      <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="VV-AR-002" name="Kubernetes connected installation" classifier="VV-SYS-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-AR-002-COMMENT" body="Reference fielded configuration of the Veoveo Installation System, configured by VV-CMP-036." />
      </packagedElement>
      <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="VV-AR-003" name="Kubernetes offline installation" classifier="VV-SYS-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-AR-003-COMMENT" body="Reference fielded configuration of the Veoveo Installation System, configured by VV-CMP-036." />
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="VV-PKG-REQUIREMENTS" name="Requirements">
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-001" name="VV-REQ-001">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-001-COMMENT" body="Each installation shall remain organization-owned and shall not depend on a Veoveo vendor control plane, hosted service, or canonical domain name." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-002" name="VV-REQ-002">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-002-COMMENT" body="Hosted domains shall use the complete MCP protocol surface where it fits, including resources, templates, prompts, completions, tasks, subscriptions, notifications, structured content, and URI identities." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-003" name="VV-REQ-003">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-003-COMMENT" body="Every externally reachable MCP or administrative operation shall pass through profile selection, policy evaluation, and audit at the gateway." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-004" name="VV-REQ-004">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-004-COMMENT" body="Provider job completion shall be accepted only from a signed provider webhook and shall never poll provider status." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-005" name="VV-REQ-005">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-005-COMMENT" body="Long-running operations shall use one durable task authority with explicit idempotency, leases, recovery class, cancellation, results, retention, and ordered event delivery." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-006" name="VV-REQ-006">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-006-COMMENT" body="Artifact occurrences and bytes shall remain tenant-isolated and shall enforce labels, grants, release state, retention, and bounded sharing." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-007" name="VV-REQ-007">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-007-COMMENT" body="World and sensor producers shall push Rerun log streams through an authenticated gateway boundary that preserves durable checkpoints and crash-decodable evidence." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-008" name="VV-REQ-008">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-008-COMMENT" body="Stream shall process arriving encoded media directly through operator-admitted live graphs and shall run reproducible replay profiles over authorized recordings with bounded GPU execution." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-009" name="VV-REQ-009">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-009-COMMENT" body="Autonomous agents shall persist wakes, episodes, task descriptors, retries, results, and retention pins across process restart." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-010" name="VV-REQ-010">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-010-COMMENT" body="Browser JavaScript shall never receive the gateway bearer and every unsafe console request shall enforce CSRF." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-011" name="VV-REQ-011">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-011-COMMENT" body="An offline installation shall verify all transferred files and images and shall not require network access during loading or operation of provider-independent capabilities." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-012" name="VV-REQ-012">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-012-COMMENT" body="The canonical Helm chart shall instantiate the same service graph in local k3d and fielded Kubernetes while retaining profile-specific controls for storage, ingress, network policy, and mTLS." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-013" name="VV-REQ-013">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-013-COMMENT" body="Analytical users shall retain arbitrary DuckDB SQL within owner-scoped workspaces bounded by engine, filesystem, process, resource, and network controls." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-014" name="VV-REQ-014">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-014-COMMENT" body="The platform shall support governed map acquisition, release activation, restrictions, geodesy, routing, reachable areas, and logistics matrices through stable map identities." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-015" name="VV-REQ-015">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-015-COMMENT" body="Known platform and domain contracts shall use typed structs, enums, identifiers, and schemas; raw JSON shall remain confined to genuinely opaque provider boundaries." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-016" name="VV-REQ-016">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-016-COMMENT" body="Only the gateway shall sign short-lived internal identity assertions and hosted services shall validate the key identifier, audience, tenant, principal, labels, scopes, and expiry." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-017" name="VV-REQ-017">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-017-COMMENT" body="SurrealDB shall remain the sole platform coordination authority; transactional outbox replay shall remain authoritative over best-effort live delivery." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-018" name="VV-REQ-018">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-018-COMMENT" body="New hosted servers shall compose through shared contracts and the gateway catalog without leaking server-specific behavior into generic gateway modules." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-019" name="VV-REQ-019">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-019-COMMENT" body="Visual workflows shall use headed hardware-backed WebGPU or WebGL and visual GPU services shall fail closed without their declared accelerator; browser H.264 software decode is allowed only when the exact Media Capabilities configuration is supported and smooth and the UI labels it as software." />
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="VV-REQ-020" name="VV-REQ-020">
        <ownedComment xmi:type="uml:Comment" xmi:id="VV-REQ-020-COMMENT" body="Optimization shall accept typed routing route-scenario continuous LP QP QCQP SOCP and linear MILP problems; execute only through a pinned hardware-GPU cuOpt runtime; independently verify feasibility and objective values; and publish immutable problem run solution and verification evidence." />
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="VV-PKG-ROLES" name="Operational Performers and Roles">
      <packagedElement xmi:type="uml:Class" xmi:id="VV-EXT-MCP-CLIENT" name="MCP client" />
      <packagedElement xmi:type="uml:Class" xmi:id="VV-EXT-BROWSER" name="Operator browser" />
      <packagedElement xmi:type="uml:Class" xmi:id="VV-EXT-OAUTH-CLIENT" name="OAuth client" />
      <packagedElement xmi:type="uml:Class" xmi:id="VV-EXT-AUTHORIZED-USER" name="Authorized artifact user" />
      <packagedElement xmi:type="uml:Class" xmi:id="VV-EXT-LINK-HOLDER" name="Public link holder" />
      <packagedElement xmi:type="uml:Class" xmi:id="VV-EXT-PRODUCER" name="Sensor or simulation producer" />
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-HOSTED" name="Hosted MCP server role" />
      <packagedElement xmi:type="uml:Class" xmi:id="VV-CMP-PLATFORM" name="Platform service role" />
    </packagedElement>
