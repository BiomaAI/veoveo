BEGIN TRANSACTION; LET $lease = (SELECT * FROM ONLY $agent WHERE lease_owner = $instance AND fence = $fence AND lease_expires_at > $now); IF $lease = NONE { THROW 'agent lease lost'; }; LET $settled = (UPDATE ONLY $agent_task SET state = $state, result = $result, result_is_error = $is_error, result_wake = $wake, lease_owner = NONE, lease_expires_at = NONE, resolved_at = $now, updated_at = $now, revision += 1 WHERE agent = $agent AND state = 'watching' AND lease_owner = $task_owner RETURN AFTER); IF $settled = NONE { THROW 'agent task lease lost'; }; CREATE ONLY $wake CONTENT $wake_content RETURN NONE; COMMIT TRANSACTION;
