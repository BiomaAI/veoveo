BEGIN TRANSACTION; LET $lease = (SELECT * FROM ONLY $agent WHERE lease_owner = $owner AND fence = $fence AND lease_expires_at > $now); IF $lease = NONE { THROW 'agent lease lost'; }; LET $claimed = (UPDATE ONLY $wake SET state = 'claimed', claimed_by = $owner, claimed_at = $now, claim_expires_at = $expiry, claim_fence = $fence, attempts += 1, updated_at = $now, revision += 1 WHERE agent = $agent AND state = 'pending' AND available_at <= $now AND revision = $revision RETURN AFTER); IF $claimed = NONE { THROW 'wake claim conflict'; }; COMMIT TRANSACTION;
