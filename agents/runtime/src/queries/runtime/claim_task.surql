BEGIN TRANSACTION; LET $lease = (SELECT * FROM ONLY $agent WHERE lease_owner = $instance AND fence = $fence AND lease_expires_at > $now); IF $lease = NONE { THROW 'agent lease lost'; }; LET $claimed = (UPDATE ONLY $task SET state = 'watching', lease_owner = $task_owner, lease_expires_at = $expiry, updated_at = $now, revision += 1 WHERE agent = $agent AND state = 'pending' AND next_retry_at <= $now AND revision = $revision RETURN AFTER); IF $claimed = NONE { THROW 'agent task claim conflict'; }; COMMIT TRANSACTION;
