BEGIN TRANSACTION; LET $leased = (UPDATE ONLY $agent SET lease_owner = $owner, lease_expires_at = $expires, heartbeat_at = $now, managed_ready = NONE, fence = $fence, revision += 1, updated_at = $now WHERE revision = $revision AND state != 'disabled' AND (lease_owner = NONE OR lease_expires_at = NONE OR lease_expires_at <= $now OR lease_owner = $owner) RETURN AFTER); IF $leased = NONE { THROW 'agent lease conflict'; }; COMMIT TRANSACTION;
