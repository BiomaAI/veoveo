BEGIN TRANSACTION; LET $updated = (UPDATE ONLY $wake SET state = 'coalesced', coalesced_into = $winner, claimed_by = NONE, claimed_at = NONE, claim_expires_at = NONE, claim_fence = NONE, acked_at = $now, updated_at = $now, revision += 1 WHERE agent = $agent AND state = 'claimed' AND claimed_by = $owner AND claim_fence = $fence RETURN AFTER); IF $updated = NONE { THROW 'wake claim lost'; }; COMMIT TRANSACTION;
