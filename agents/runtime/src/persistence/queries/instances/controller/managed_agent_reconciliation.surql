IF !fn::managed_agent_claim($command) { THROW 'agent_conflict'; }; LET $instance = SELECT * FROM ONLY $command.instance; LET $revision = SELECT * FROM ONLY $instance.requested_revision; LET $runtime = array::first(SELECT * FROM agent WHERE tenant = $instance.tenant AND agent_key = $instance.key LIMIT 1); LET $keys = fn::kernel::identity::tenant_context_keys_v1($instance.tenant, $instance.work_context); RETURN { instance: $instance, revision: $revision, runtime: $runtime, episode_running: (($runtime != NONE AND $runtime.last_episode.state = 'running') ?? false), tenant_key: $keys.tenant_key, context_key: $keys.context_key, enabled: fn::managed_agent_enabled($instance.id) };
