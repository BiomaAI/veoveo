IF $authority.membership = 'viewer' { THROW 'agent_forbidden'; }; LET $instance = SELECT * FROM ONLY $command.instance; IF $instance != NONE AND !fn::managed_agent_editor($authority, $instance) { THROW 'agent_not_found'; }; LET $receipt = SELECT * FROM ONLY $command.operation; IF $receipt = NONE { RETURN NONE; }; IF $receipt.fingerprint != $command.fingerprint OR $receipt.work_context != $authority.work_context { THROW 'agent_conflict'; }; RETURN $receipt;
