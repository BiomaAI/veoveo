LET $instance = array::first(SELECT * FROM managed_agent WHERE identity.client_id = $command LIMIT 1); IF $instance = NONE { RETURN NONE; }; LET $revision = SELECT * FROM ONLY ($instance.active_revision ?? $instance.requested_revision); LET $keys = fn::kernel::identity::tenant_context_keys_v1($instance.tenant, $instance.work_context); RETURN { instance: $instance, revision: $revision, tenant_key: $keys.tenant_key, context_key: $keys.context_key, enabled: fn::managed_agent_enabled($instance.id) AND $instance.active_generation > 0 AND $instance.public_key != NONE };
