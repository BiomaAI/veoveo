LET $definition = SELECT * FROM ONLY $command.definition; IF $definition = NONE OR $definition.tenant != $authority.tenant OR $definition.disabled OR $authority.work_context NOT IN $definition.audience OR ($command.digest = NONE AND $definition.status = 'archived') { THROW 'agent_not_found'; }; LET $revision = IF $command.digest = NONE { SELECT * FROM ONLY $definition.published } ELSE { array::first(SELECT * FROM agent_definition_revision WHERE definition = $definition.id AND digest = $command.digest LIMIT 1) }; IF $revision = NONE { THROW 'agent_not_found'; }; RETURN { key: $definition.key, name: $definition.name, description: $definition.description, revision: $revision, published_by_name: array::first(fn::kernel::identity::principal_summaries_v1($authority.tenant, [$revision.created_by])).display_name ?? 'Agent author' };
